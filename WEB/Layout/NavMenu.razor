@using WEB.Services.Versioning
@inject AppVersionInfo VersionInfo

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href=""><Icon Name="IconName.UpcScan"  
            Style="margin-right:10px;" /> ScanStock Pro.</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Icon Name="IconName.Speedometer2" Size="IconSize.x4" Style="margin-right:10px;" /> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3 has-submenu">
            <div class="nav-link submenu-parent d-flex align-items-center justify-content-between" role="button" tabindex="0" title="Mostrar opciones" @onclick="ToggleInventario" @onclick:stopPropagation="true" @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleInventario(); })">
                <span class="d-flex align-items-center">
                    <Icon Name="IconName.CloudRain" Size="IconSize.x4" Style="margin-right:10px;" /> Inventario
                </span>
                <span class="submenu-caret @(GetCaretClass())">
                    <Icon Name="IconName.CaretRight" Size="IconSize.x4" />
                </span>
            </div>
            <div class="submenu @(_inventarioAbierto ? "submenu-open" : null)">
                <NavLink class="submenu-link" href="/products">
                    <Icon Name="IconName.Box" Size="IconSize.x4" Style="margin-right:8px;" /> Productos
                </NavLink>
                <NavLink class="submenu-link" href="/almacenes">
                    <Icon Name="IconName.Boxes" Size="IconSize.x4" Style="margin-right:8px;" /> Almacenes
                </NavLink>
                <NavLink class="submenu-link" href="/CargaInicial">
                    <Icon Name="IconName.BoxArrowInDown" Size="IconSize.x4" Style="margin-right:8px;" /> Iniciales
                </NavLink>
            </div>
        </div>
        <div class="nav-item px-3 has-submenu">
            <div class="nav-link submenu-parent d-flex align-items-center justify-content-between" role="button" tabindex="0" title="Mostrar opciones" @onclick="ToggleCompras" @onclick:stopPropagation="true" @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleCompras(); })">
                <span class="d-flex align-items-center">
                    <Icon Name="IconName.Bag" Size="IconSize.x4" Style="margin-right:10px;" /> Compras
                </span>
                <span class="submenu-caret @(GetComprasCaretClass())">
                    <Icon Name="IconName.CaretRight" Size="IconSize.x4" />
                </span>
            </div>
            <div class="submenu @(_comprasAbierto ? "submenu-open" : null)">
                <NavLink class="submenu-link" href="/ordencompra">
                    <Icon Name="IconName.Cart" Size="IconSize.x4" Style="margin-right:8px;" /> Orden de Compra
                </NavLink>
                <NavLink class="submenu-link" href="/suppliers">
                    <Icon Name="IconName.Truck" Size="IconSize.x4" Style="margin-right:8px;" /> Proveedores
                </NavLink>
            </div>
        </div>
        <div class="nav-item px-3 has-submenu">
            <div class="nav-link submenu-parent d-flex align-items-center justify-content-between" role="button" tabindex="0" title="Mostrar opciones" @onclick="ToggleVentas" @onclick:stopPropagation="true" @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleVentas(); })">
                <span class="d-flex align-items-center">
                    <Icon Name="IconName.Cart4" Size="IconSize.x4" Style="margin-right:10px;" /> Ventas
                </span>
                <span class="submenu-caret @(GetVentasCaretClass())">
                    <Icon Name="IconName.CaretRight" Size="IconSize.x4" />
                </span>
            </div>
            <div class="submenu @(_ventasAbierto ? "submenu-open" : null)">
                <NavLink class="submenu-link" href="/pedidoventa">
                    <Icon Name="IconName.Cart" Size="IconSize.x4" Style="margin-right:8px;" /> Pedidos de Venta
                </NavLink>
                <NavLink class="submenu-link" href="/customers">
                    <Icon Name="IconName.People" Size="IconSize.x4" Style="margin-right:8px;" /> Clientes
                </NavLink>
            </div>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/mobile">
                <Icon Name="IconName.Phone" Size="IconSize.x4" Style="margin-right:10px;" /> Integración Móvil
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/vendedores">
                <Icon Name="IconName.PersonBadge" Size="IconSize.x4" Style="margin-right:10px;" /> Vendedores
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/enterprise">
                <Icon Name="IconName.Building" Size="IconSize.x4" Style="margin-right:10px;" /> Empresa
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/users">
                <Icon Name="IconName.Person" Size="IconSize.x4" Style="margin-right:10px;" /> Usuarios
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/config">
                <Icon Name="IconName.Gear" Size="IconSize.x4" Style="margin-right:10px;" /> Configuración
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/Reports">
                <Icon Name="IconName.FileEarmarkBarGraph" Size="IconSize.x4" Style="margin-right:10px;" /> Reportes
            </NavLink>
        </div>

        <hr class="version-divider" />

        <div class="version-section px-3">
            <div class="version-title">
                <Icon Name="IconName.InfoCircle" Size="IconSize.x4" Style="margin-right:8px;" /> Datos de la versión
            </div>
            <div class="version-row"><span>Versión</span><span class="fw-semibold">@VersionInfo.Version</span></div>
            <div class="version-row"><span>Build</span><span>@VersionInfo.BuildNumber</span></div>
            <div class="version-row"><span>Fecha</span><span>@VersionInfo.BuildDate</span></div>
            <div class="version-row"><span>.NET</span><span>@VersionInfo.Framework</span></div>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _inventarioAbierto;
    private bool _comprasAbierto;
    private bool _ventasAbierto;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleInventario()
    {
        _inventarioAbierto = !_inventarioAbierto;
    }

    private void ToggleCompras()
    {
        _comprasAbierto = !_comprasAbierto;
    }

    private void ToggleVentas()
    {
        _ventasAbierto = !_ventasAbierto;
    }

    private string GetCaretClass()
    {
        return _inventarioAbierto ? "submenu-caret submenu-caret-open" : "submenu-caret";
    }

    private string GetComprasCaretClass()
    {
        return _comprasAbierto ? "submenu-caret submenu-caret-open" : "submenu-caret";
    }

    private string GetVentasCaretClass()
    {
        return _ventasAbierto ? "submenu-caret submenu-caret-open" : "submenu-caret";
    }
}
