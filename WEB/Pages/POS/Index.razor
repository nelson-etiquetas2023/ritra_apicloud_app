    private int GetConteo(decimal d) => conteoCierre.TryGetValue(d, out var v) ? v : 0;

    private void CambiarConteo(decimal d, int delta)
    {
        conteoCierre[d] = Math.Max(0, GetConteo(d) + delta);
    }

    private void SetConteo(decimal d, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v)) conteoCierre[d] = Math.Max(0, v);
    }

    private decimal ContadoCierre => conteoCierre.Sum(kv => kv.Key * kv.Value);

    private decimal DiferenciaCierre => ContadoCierre - (resumenCierre?.Esperado ?? 0);

    private async Task CerrarTurno()
    {
        if (turnoAbierto == null || resumenCierre == null) return;
        if (DiferenciaCierre != 0 && string.IsNullOrWhiteSpace(observacionCierre))
        {
            ToastService.Notify(new(ToastType.Danger, "Indica el motivo de la diferencia para cerrar."));
            return;
        }
        cerrandoTurno = true;
        try
        {
            var lista = conteoCierre.Where(kv => kv.Value > 0)
                .Select(kv => new ConteoDenominacion { Denominacion = kv.Key, Cantidad = kv.Value }).ToList();
            var r = await TurnosService.CerrarAsync(turnoAbierto.Id, lista, observacionCierre.Trim(), turnoAbierto.Cajero);
            if (r == null || !r.Success)
            {
                ToastService.Notify(new(ToastType.Danger, r?.Message ?? "No se pudo cerrar el turno."));
                return;
            }
            turnoCerrado = r.Turno;
            conteosCierre = r.Conteos;
            turnoAbierto = null;
            conteoCierre.Clear();
            observacionCierre = "";
            await CargarVentasTurno();
            ToastService.Notify(new(ToastType.Success, $"Turno cerrado. Diferencia: {turnoCerrado?.Diferencia:N2}"));
        }
        finally
        {
            cerrandoTurno = false;
            StateHasChanged();
        }
    }

