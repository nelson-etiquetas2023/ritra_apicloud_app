    private void AgregarToque(Product p) => AgregarProducto(p, 1);

    private void AgregarProducto(Product p, int cantidad)
    {
        if (turnoAbierto == null)
        {
            ToastService.Notify(new(ToastType.Danger, "Abre un turno antes de agregar productos."));
            return;
        }
        if (p.Price <= 0)
        {
            ToastService.Notify(new(ToastType.Warning, $"'{p.Product_Name}' no tiene precio y no se puede facturar."));
            return;
        }
        var codigo = !string.IsNullOrWhiteSpace(p.Codebar) ? p.Codebar.Trim() : (p.Product_Code ?? "").Trim();
        var existente = carrito.FirstOrDefault(i => i.Product_id == codigo);
        if (existente is null)
        {
            carrito.Add(new DetalleVenta
            {
                Product_id = codigo,
                Product_name = p.Product_Name ?? codigo,
                Cantidad = Math.Max(1, cantidad),
                Precio = (decimal)p.Price,
                Stock = (decimal)p.Stock,
                Comentario = "POS"
            });
        }
        else
        {
            existente.Cantidad += Math.Max(1, cantidad);
        }
        Recalcular();
    }

    private void CambiarCantidad(DetalleVenta item, int delta)
    {
        item.Cantidad = Math.Max(1, item.Cantidad + delta);
        Recalcular();
    }

    private void Quitar(DetalleVenta item)
    {
        carrito.Remove(item);
        Recalcular();
    }

    private void Limpiar()
    {
        carrito.Clear();
        LimpiarPagos();
        ultimoTicket = "";
        Recalcular();
    }

    private void LimpiarPagos()
    {
        montoEfectivo = 0;
        montoTarjeta = 0;
        refTarjeta = "";
        montoTransf = 0;
        refTransf = "";
    }

    private void PonerExacto()
    {
        montoEfectivo = total;
        montoTarjeta = 0;
        montoTransf = 0;
    }

    private void Recalcular()
    {
        subtotal = carrito.Sum(i => i.Cantidad * i.Precio);
        descuentoGlobal = Math.Clamp(descuentoGlobal, 0, 100);
        descuentoMonto = Math.Round(subtotal * (descuentoGlobal / 100m), 2);
        var neto = subtotal - descuentoMonto;
        impuesto = Math.Round(neto * 0.18m, 2);
        total = neto + impuesto;
        StateHasChanged();
    }

    private List<VentaPago> ArmarPagos(decimal ef, decimal tj, decimal tr)
    {
        var lista = new List<VentaPago>();
        if (ef > 0) lista.Add(new VentaPago { Metodo = MetodoPago.Efectivo, Monto = ef });
        if (tj > 0) lista.Add(new VentaPago { Metodo = MetodoPago.Tarjeta, Monto = tj, Referencia = refTarjeta.Trim() });
        if (tr > 0) lista.Add(new VentaPago { Metodo = MetodoPago.Transferencia, Monto = tr, Referencia = refTransf.Trim() });
        return lista;
    }

    private async Task Cobrar()
    {
        if (carrito.Count == 0) return;
        if (turnoAbierto == null)
        {
            ToastService.Notify(new(ToastType.Danger, "No hay turno abierto. Abre el turno antes de cobrar."));
            return;
        }
        if (clienteGenerico && string.IsNullOrWhiteSpace(nombreGenerico))
        {
            ToastService.Notify(new(ToastType.Danger, "Escriba el nombre del cliente ocasional."));
            return;
        }
        if (!clienteGenerico && clienteId <= 0)
        {
            ToastService.Notify(new(ToastType.Danger, "Seleccione un cliente o active cliente ocasional."));
            return;
        }
        if (pendiente > 0.005m)
        {
            ToastService.Notify(new(ToastType.Danger, $"Faltan {pendiente:N2} para completar el total ({total:N2})."));
            return;
        }
        if (cambio < 0)
        {
            ToastService.Notify(new(ToastType.Danger, "El efectivo no cubre su parte del total."));
            return;
        }
        var tj = Math.Round(Math.Max(0, montoTarjeta), 2);
        var tr = Math.Round(Math.Max(0, montoTransf), 2);
        if (tj > 0 && string.IsNullOrWhiteSpace(refTarjeta))
        {
            ToastService.Notify(new(ToastType.Danger, "Indica el # de autorización de la tarjeta."));
            return;
        }
        if (tr > 0 && string.IsNullOrWhiteSpace(refTransf))
        {
            ToastService.Notify(new(ToastType.Danger, "Indica el # de comprobante de la transferencia."));
            return;
        }
        var ef = Math.Round(efectivoCubre, 2);
        if (Math.Abs(ef + tj + tr - total) > 0.01m)
        {
            ToastService.Notify(new(ToastType.Danger, "Los pagos no cuadran con el total. Revise los montos."));
            return;
        }

        procesando = true;
        try
        {
            var numero = await VentaService.GetNextNumAsync();
            if (string.IsNullOrWhiteSpace(numero))
            {
                ToastService.Notify(new(ToastType.Danger, "No se pudo obtener el número de documento."));
                return;
            }
            var cli = clienteGenerico ? null : clientes.FirstOrDefault(c => c.customer_id == clienteId);
            var nombreCli = clienteGenerico ? nombreGenerico.Trim() : (cli?.CustomerName ?? "");
            var pedido = new PedidoVenta
            {
                Numero = numero,
                Fecha = DateTime.Now,
                FechaCreacion = DateTime.Now,
                Cliente_Id = clienteGenerico ? 0 : clienteId,
                TurnoId = turnoAbierto.Id,
                Cliente_Nombre = nombreCli,
                Cliente_RNC = cli?.RNC ?? "",
                DireccionEntrega = cli?.Direccion ?? "POS mostrador",
                Vendedor = "POS",
                WarehouseName = "POS",
                Prioridad = "Normal",
                Reference = $"POS ef:{ef:N2} tj:{tj:N2} tr:{tr:N2}",
                Description = "Venta POS (prueba)",
                Items = carrito.Select(i => new DetalleVenta
                {
                    Product_id = i.Product_id,
                    Product_name = i.Product_name,
                    Cantidad = i.Cantidad,
                    Precio = i.Precio,
                    Descuento = descuentoGlobal,
                    Stock = i.Stock,
                    Comentario = "POS"
                }).ToList(),
                Pagos = ArmarPagos(ef, tj, tr)
            };

            var creado = await VentaService.CreateAsync(pedido);
            if (!creado.Success)
            {
                ultimaVentaOk = false;
                ultimoTicket = $"NO SE GUARDÓ {numero}\n{creado.Message}";
                ToastService.Notify(new(ToastType.Danger, creado.Message));
                return;
            }

            var proc = await VentaService.ProcesarPedidoAsync(numero);
            if (proc is null)
            {
                ultimaVentaOk = false;
                ultimoTicket = $"Se guardó {numero} pero no respondió procesar. Revísalo en Pedidos.";
                ToastService.Notify(new(ToastType.Warning, ultimoTicket));
                return;
            }

            ultimaVentaOk = proc.Success;
            var lineas = string.Join("\n", carrito.Select(i => $"• {i.Product_name} x{i.Cantidad} = {(i.Cantidad * i.Precio):N2}"));
            var erroresLineas = string.Join("\n", (proc.Items ?? []).Where(x => !x.Ok).Select(x => $"• {x.ProductName}: {x.Error}"));
            ultimoTicket = proc.Success
                ? $"VENTA {numero} OK\n{lineas}\nSubtotal: {subtotal:N2} | Desc: {descuentoMonto:N2} | Total: {total:N2} | Ef: {ef:N2} Tj: {tj:N2} Tr: {tr:N2} | Cambio: {cambio:N2}\n{proc.Message}"
                : $"VENTA {numero} CON FALLOS\n{proc.Message}\n{erroresLineas}";

            ToastService.Notify(new(ultimaVentaOk ? ToastType.Success : ToastType.Warning, proc.Message));

            if (proc.Success)
            {
                ticketNumero = numero;
                ticketFecha = DateTime.Now;
                ticketCliente = nombreCli;
                ticketItems = pedido.Items.ToList();
                ticketSubtotal = subtotal;
                ticketDescuento = descuentoMonto;
                ticketImpuesto = impuesto;
                ticketTotal = total;
                ticketRecibido = montoEfectivo;
                ticketCambio = cambio;
                ticketPagos = pedido.Pagos.ToList();
                Sesion.Agregar(new WEB.Services.Pos.VentaSesion
                {
                    PedidoId = creado.Data?.Id ?? 0,
                    Numero = numero,
                    Fecha = ticketFecha,
                    ClienteNombre = ticketCliente,
                    Estado = "Procesado",
                    Items = ticketItems,
                    Subtotal = ticketSubtotal,
                    Descuento = ticketDescuento,
                    Impuesto = ticketImpuesto,
                    Total = ticketTotal,
                    Recibido = ticketRecibido,
                    Cambio = ticketCambio,
                    Pagos = ticketPagos
                });
                carrito.Clear();
                LimpiarPagos();
                descuentoGlobal = 0;
                descuentoMonto = 0;
                clienteId = 0;
                clienteGenerico = false;
                nombreGenerico = "";
                Recalcular();
                proximoNumero = await VentaService.GetNextNumAsync();
                await CargarVentasTurno();
                ToastService.Notify(new(ToastType.Success, $"Venta {numero} en la lista de Ventas ({ventasTurno.Count} en el turno). Form en blanco para la siguiente."));
                await MostrarTicket();
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error cobrando: {ex.Message}"));
        }
        finally
        {
            procesando = false;
            StateHasChanged();
        }
    }

