    private decimal electronico => Math.Max(0, montoTarjeta) + Math.Max(0, montoTransf);
    private decimal efectivoCubre => total - electronico;
    private decimal cambio => montoEfectivo - efectivoCubre;
    private decimal pendiente => total - (montoEfectivo + electronico);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tProd = ProductsService.GetProductAsync();
            var tCli = CustomersService.GetCustomersAsync();
            var tNum = VentaService.GetNextNumAsync();
            await Task.WhenAll(tProd, tCli, tNum);
            productos = (await tProd).Where(p => p.IsActive).ToList();
            clientes = await tCli;
            proximoNumero = await tNum;
            if (string.IsNullOrWhiteSpace(proximoNumero)) proximoNumero = "(lo asigna el servidor)";
            if (clientes.Count == 1) clienteId = clientes[0].customer_id;
            try { empresa = await EnterprisesService.GetEnterpriseAsync(); } catch { }
            try { turnoAbierto = await TurnosService.GetAbiertoAsync("Caja 1"); }
            catch { turnoAbierto = null; }
            finally { turnoCargando = false; }
            await CargarVentasTurno();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error cargando POS: {ex.Message}"));
        }
    }

