@page "/pos"
@using Shared.Dtos
@using Shared.Dtos.Ventas
@using Shared.Dtos.Turnos
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject WEB.Services.Ventas.IVentasService VentaService
@inject WEB.Services.Products.IProductsService ProductsService
@inject WEB.Services.Customers.ICustomersService CustomersService
@inject WEB.Services.Enterprises.IEnterprisesService EnterprisesService
@inject WEB.Services.Turnos.ITurnosService TurnosService
@inject WEB.Services.Pos.PosSesionService Sesion
@inject IJSRuntime JS

<PageTitle>POS de Venta (Prueba)</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h3 class="mb-0"><Icon Name="IconName.LightningChargeFill" Size="IconSize.x4" /> POS de Venta <Badge Color="BadgeColor.Warning">PRUEBA</Badge></h3>
    <span class="text-muted small">Venta inmediata: crea + procesa en un paso (descuenta stock)</span>
</div>

@if (!turnoCargando && turnoAbierto == null)
{
    <div class="card mt-2 mb-2 border-warning">
        <div class="card-header fw-semibold"><Icon Name="IconName.ClockHistory" /> Abrir turno — Caja 1</div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Cajero <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg" @bind="cajeroTurno" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">Fondo inicial</label>
                    <input type="number" class="form-control form-control-lg" step="0.01" min="0" @bind="fondoTurno" />
                </div>
                <div class="col-md-3 d-grid">
                    <Button Color="ButtonColor.Success" Size="ButtonSize.Large" Disabled="abriendoTurno" @onclick="AbrirTurno">
                        @if (abriendoTurno) { <Spinner Size="SpinnerSize.Small" /> } else { <span><Icon Name="IconName.Unlock" /> Abrir turno</span> }
                    </Button>
                </div>
                <div class="col-md-2 d-grid">
                    <Button Color="ButtonColor.Secondary" Size="ButtonSize.Large" @onclick='() => Navigation.NavigateTo("/pos/turnos")'>Turnos</Button>
                </div>
            </div>
        </div>
    </div>
}
else if (turnoAbierto != null)
{
    <div class="alert alert-success mt-2 py-1 small d-flex justify-content-between align-items-center">
        <span>Turno abierto: <strong>@turnoAbierto.Caja</strong> — @turnoAbierto.Cajero (@turnoAbierto.FechaApertura.ToString("dd/MM HH:mm"))</span>
        <span class="d-flex gap-2">
            <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick='() => Navigation.NavigateTo("/pos/turnos")'><Icon Name="IconName.ClockHistory" /> Turnos</Button>
            <Button Color="ButtonColor.Warning" Size="ButtonSize.Small" @onclick="AbrirModalMov"><Icon Name="IconName.ArrowLeftRight" /> Entrada/Salida</Button>
            <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="AbrirModalCierre"><Icon Name="IconName.Lock" /> Cerrar turno</Button>
        </span>
    </div>
}

<div class="row mt-2">
    @* IZQUIERDA: pistola + cliente + catálogo *@
    <div class="col-lg-7">
        <div class="pos-tabs mb-2" role="tablist">
            <button type="button" role="tab" aria-selected='@(tabPos == "productos")' class="pos-tab @(tabPos == "productos" ? "active" : "")" @onclick='() => tabPos = "productos"'><Icon Name="IconName.Grid" /> Catálogo</button>
            <button type="button" role="tab" aria-selected='@(tabPos == "ventas")' class="pos-tab @(tabPos == "ventas" ? "active" : "")" @onclick="VerVentasTab"><Icon Name="IconName.Receipt" /> Ventas (@ventasTurno.Count)</button>
        </div>
        @if (tabPos == "productos")
        {
        <div class="card mb-2">
            <div class="card-header fw-semibold"><Icon Name="IconName.Person" /> Cliente y documento</div>
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Cliente <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <select class="form-select" @bind="clienteId" disabled="@(clienteGenerico || turnoAbierto == null)">
                                <option value="0">@(clientes.Count == 0 ? "Cargando..." : "Seleccione cliente...")</option>
                                @foreach (var c in clientes)
                                {
                                    <option value="@c.customer_id">@c.CustomerName</option>
                                }
                            </select>
                            <Button Color="ButtonColor.Primary" Disabled="@(turnoAbierto == null)" @onclick="AbrirModalCliente" title="Registrar cliente nuevo"><Icon Name="IconName.PersonPlus" /></Button>
                        </div>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="cliGenerico" @bind="clienteGenerico" disabled="@(turnoAbierto == null)" />
                            <label class="form-check-label small" for="cliGenerico">Cliente ocasional (solo nombre, sin registrar)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Próximo número</label>
                        <input type="text" class="form-control" value="@proximoNumero" disabled />
                        @if (clienteGenerico)
                        {
                            <label class="form-label small fw-semibold mt-2">Nombre para la factura <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-lg" placeholder="Nombre del cliente..." @bind="nombreGenerico" @bind:event="oninput" />
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-2">
            <div class="card-header fw-semibold"><Icon Name="IconName.Grid" /> Catálogo táctil (toque para agregar)</div>
            <div class="card-body">
                <CatalogoTactil Productos="productos" Carrito="carrito" OnAgregar="AgregarToque" Deshabilitado="@(turnoAbierto == null)" />
            </div>
        </div>
        }
        else
        {
        <div class="card mb-2">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><Icon Name="IconName.Receipt" /> Ventas del turno (@ventasTurno.Count)</span>
                <span class="fw-bold">Total: @ventasTurno.Where(v => v.Estado != "Anulado").Sum(v => v.Total).ToString("N2")</span>
            </div>
            <div class="card-body p-2">
                <input type="text" class="form-control mb-2" placeholder="🔍 Buscar por cliente o número..." @bind="filtroVentas" @bind:event="oninput" />
                @if (cargandoVentas)
                {
                    <div class="text-center text-muted py-3"><Spinner Size="SpinnerSize.Small" /> Cargando ventas del turno...</div>
                }
                else if (turnoAbierto == null && ventasTurno.Count == 0)
                {
                    <div class="text-center text-muted py-3">Abre un turno para ver sus ventas.</div>
                }
                else if (ventasTurno.Count == 0)
                {
                    <div class="text-center text-muted py-3">Aún no hay ventas en este turno. Cobra y aparecerán aquí.</div>
                }
                else if (VentasFiltradas.Count == 0)
                {
                    <div class="text-center text-muted py-3">Sin resultados para "@filtroVentas".</div>
                }
                else
                {
                    <div class="pos-cart-list sin-scroll">
                        @foreach (var v in VentasFiltradas)
                        {
                            <div class="pos-cart-row @(v.Estado == "Anulado" ? "anulado" : "")">
                                <div class="pos-cart-info">
                                    <strong>@v.Numero</strong>
                                    <small class="text-muted">@v.Fecha.ToString("HH:mm") · @v.ClienteNombre · @v.Unidades uds. · @v.Estado</small>
                                    @if (!string.IsNullOrEmpty(v.ResumenPagos))
                                    {
                                        <small class="text-muted">@v.ResumenPagos</small>
                                    }
                                </div>
                                <div class="pos-cart-total">@v.Total.ToString("N2")</div>
                                @if (v.Estado != "Anulado")
                                {
                                    <Button Color="ButtonColor.Primary" Size="ButtonSize.Small" @onclick="() => ReimprimirSesion(v)"><Icon Name="IconName.Printer" /> Ticket</Button>
                                }
                                @if (v.PedidoId > 0 && v.Estado != "Anulado")
                                {
                                    <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => AnularVenta(v)"><Icon Name="IconName.XCircle" /> Anular</Button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        }
    </div>

    @* DERECHA: carrito + totales + pago *@
    <div class="col-lg-5">
        <div class="card mb-2">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span><Icon Name="IconName.Cart4" /> Carrito (@carrito.Count líneas, @carrito.Sum(i => i.Cantidad) uds.)</span>
                <Button Color="ButtonColor.Secondary" Size="ButtonSize.Small" @onclick="Limpiar"><Icon Name="IconName.Trash" /> Limpiar</Button>
            </div>
            <div class="card-body p-2">
                @if (carrito.Count == 0)
                {
                    <div class="text-center py-3 text-muted">
                        <Icon Name="IconName.Cart4" Size="IconSize.x2" />
                        <p class="mb-0 small">Toca un producto o escanea para empezar.</p>
                    </div>
                }
                else
                {
                    <div class="pos-cart-list">
                        @foreach (var item in carrito)
                        {
                            <div class="pos-cart-row">
                                <div class="pos-cart-info">
                                    <strong>@item.Product_name</strong>
                                    <small class="text-muted">@item.Precio.ToString("N2") c/u</small>
                                </div>
                                <div class="input-group input-group-sm pos-cart-qty">
                                    <button class="btn btn-outline-secondary" @onclick="() => CambiarCantidad(item, -1)">−</button>
                                    <input type="number" class="form-control text-center" min="1" @bind="item.Cantidad" @bind:event="onchange" @bind:after="Recalcular" />
                                    <button class="btn btn-outline-secondary" @onclick="() => CambiarCantidad(item, 1)">+</button>
                                </div>
                                <div class="pos-cart-total">@((item.Cantidad * item.Precio).ToString("N2"))</div>
                                <Button Color="ButtonColor.Danger" Size="ButtonSize.Small" @onclick="() => Quitar(item)"><Icon Name="IconName.X" /></Button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="card mb-2">
            <div class="card-header fw-semibold">Totales</div>
            <div class="card-body">
                <div class="d-flex justify-content-between"><span class="text-muted">Subtotal</span><span>@subtotal.ToString("N2")</span></div>
                <div class="row g-2 align-items-center my-1">
                    <div class="col-6"><label class="form-label small fw-semibold mb-0">Descuento %</label></div>
                    <div class="col-6"><input type="number" class="form-control text-end" step="0.5" min="0" max="100" disabled="@(turnoAbierto == null)" @bind="descuentoGlobal" @bind:event="oninput" @bind:after="Recalcular" /></div>
                </div>
                @if (descuentoMonto > 0)
                {
                    <div class="d-flex justify-content-between text-success"><span>Descuento (@descuentoGlobal.ToString("N2")%)</span><span>-@descuentoMonto.ToString("N2")</span></div>
                }
                <div class="d-flex justify-content-between"><span class="text-muted">ITBIS (18%)</span><span>@impuesto.ToString("N2")</span></div>
                <hr />
                <div class="d-flex justify-content-between fs-4 fw-bold"><span>Total</span><span>@total.ToString("N2")</span></div>
            </div>
        </div>

        <div class="card mb-2">
            <div class="card-header fw-semibold">Pago (mixto)</div>
            <div class="card-body">
                <label class="form-label small fw-semibold">Efectivo recibido</label>
                <div class="d-flex gap-2 mb-2">
                    <input type="number" class="form-control form-control-lg" step="0.01" min="0" disabled="@(turnoAbierto == null)" @bind="montoEfectivo" @bind:event="oninput" />
                    <Button Color="ButtonColor.Secondary" Disabled="@(turnoAbierto == null)" @onclick="PonerExacto">Exacto</Button>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Tarjeta</label>
                        <input type="number" class="form-control" step="0.01" min="0" placeholder="0.00" disabled="@(turnoAbierto == null)" @bind="montoTarjeta" @bind:event="oninput" />
                        <input type="text" class="form-control mt-1" placeholder="# autorización..." disabled="@(turnoAbierto == null)" @bind="refTarjeta" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-semibold">Transferencia</label>
                        <input type="number" class="form-control" step="0.01" min="0" placeholder="0.00" disabled="@(turnoAbierto == null)" @bind="montoTransf" @bind:event="oninput" />
                        <input type="text" class="form-control mt-1" placeholder="# comprobante..." disabled="@(turnoAbierto == null)" @bind="refTransf" />
                    </div>
                </div>
                <div class="d-flex justify-content-between fs-5">
                    <span>Cambio</span>
                    <strong class="@(cambio < 0 ? "text-danger" : "text-success")">@cambio.ToString("N2")</strong>
                </div>
                @if (pendiente > 0.005m)
                {
                    <small class="text-danger">Faltan @(pendiente.ToString("N2"))</small>
                }
            </div>
        </div>

        <div class="d-grid gap-2">
            <Button Color="ButtonColor.Success" Size="ButtonSize.Large" Disabled="@(procesando || carrito.Count == 0 || turnoAbierto == null || pendiente > 0.005m || cambio < 0)" @onclick="Cobrar">
                @if (procesando)
                {
                    <Spinner Size="SpinnerSize.Small" /> <span class="ms-1">Cobrando...</span>
                }
                else
                {
                    <span><Icon Name="IconName.Cash" /> Cobrar @total.ToString("N2")</span>
                }
            </Button>
            <Button Color="ButtonColor.Secondary" @onclick='() => Navigation.NavigateTo("/pedidoventa")'>Ver pedidos</Button>
            <Button Color="ButtonColor.Primary" @onclick='() => Navigation.NavigateTo("/pos/ventas")'><Icon Name="IconName.Receipt" /> Historial (@ventasTurno.Count)</Button>
        </div>

        @if (!string.IsNullOrEmpty(ultimoTicket))
        {
            <div class="alert @(ultimaVentaOk ? "alert-success" : "alert-danger") mt-2" style="white-space:pre-line;">
                @ultimoTicket
            </div>
            @if (ultimaVentaOk && ticketItems.Count > 0)
            {
                <div class="d-grid gap-2 mt-2">
                    <Button Color="ButtonColor.Primary" @onclick="MostrarTicket"><Icon Name="IconName.Receipt" /> Ver / imprimir ticket @ticketNumero</Button>
                </div>
            }
        }
    </div>
</div>

<ConfirmDialog @ref="dialogAnular" />
<Modal @ref="modalCliente" Title="Registrar cliente" Size="ModalSize.Small">
    <BodyTemplate>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Nombre <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-lg" placeholder="Nombre del cliente..." @bind="nuevoClienteNombre" />
        </div>
        <div class="row g-2">
            <div class="col-6">
                <label class="form-label small fw-semibold">RNC / Cédula</label>
                <input type="text" class="form-control" @bind="nuevoClienteRNC" />
            </div>
            <div class="col-6">
                <label class="form-label small fw-semibold">Teléfono</label>
                <input type="text" class="form-control" @bind="nuevoClienteTel" />
            </div>
        </div>
        <div class="mt-2">
            <label class="form-label small fw-semibold">Dirección</label>
            <input type="text" class="form-control" @bind="nuevoClienteDir" />
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CerrarModalCliente">Cancelar</Button>
        <Button Color="ButtonColor.Success" Disabled="guardandoCliente" @onclick="GuardarCliente">
            @if (guardandoCliente) { <Spinner Size="SpinnerSize.Small" /> } else { <span><Icon Name="IconName.CheckCircle" /> Guardar</span> }
        </Button>
    </FooterTemplate>
</Modal>
<Modal @ref="modalMov" Title="Entrada / salida de efectivo" Size="ModalSize.Small">
    <BodyTemplate>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Tipo</label>
            <select class="form-select form-select-lg" @bind="tipoMov">
                <option value="Entrada">Entrada</option>
                <option value="Salida">Salida</option>
            </select>
        </div>
        <div class="mb-2">
            <label class="form-label small fw-semibold">Monto <span class="text-danger">*</span></label>
            <input type="number" class="form-control form-control-lg" step="0.01" min="0.01" @bind="montoMov" />
        </div>
        <div>
            <label class="form-label small fw-semibold">Motivo <span class="text-danger">*</span></label>
            <input type="text" class="form-control" placeholder="Ej: pago a proveedor..." @bind="motivoMov" />
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CerrarModalMov">Cancelar</Button>
        <Button Color="ButtonColor.Warning" Disabled="guardandoMov" @onclick="GuardarMovimiento">
            @if (guardandoMov) { <Spinner Size="SpinnerSize.Small" /> } else { <span><Icon Name="IconName.CheckCircle" /> Registrar</span> }
        </Button>
    </FooterTemplate>
</Modal>
<Modal @ref="modalCierre" Title="Cerrar turno y cuadre" Size="ModalSize.Large">
    <BodyTemplate>
        @if (turnoCerrado != null)
        {
            <CuadreTicket Empresa="@(empresa?.Nombre_Empresa ?? "")" Turno="turnoCerrado" Resumen="resumenCierre"
                          Conteos="conteosCierre" Esperado="turnoCerrado.Esperado" Contado="turnoCerrado.Contado" Diferencia="turnoCerrado.Diferencia" />
        }
        else if (turnoAbierto != null)
        {
            <div class="d-flex justify-content-between"><span class="text-muted">Turno @turnoAbierto.Caja — @turnoAbierto.Cajero</span><span class="fw-bold">Esperado: @((resumenCierre?.Esperado ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small"><span class="text-muted">Fondo inicial</span><span>@((resumenCierre?.FondoInicial ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small"><span class="text-muted">Ventas (@(resumenCierre?.VentasProcesadas ?? 0))</span><span>@((resumenCierre?.VentasEfectivo ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small"><span class="text-muted">Ventas electrón.</span><span>@((resumenCierre?.VentasElectronico ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small"><span class="text-muted">Anuladas (@(resumenCierre?.FacturasAnuladas ?? 0))</span><span>-@((resumenCierre?.MontoAnulado ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small fw-bold"><span>Venta neta</span><span>@((resumenCierre?.VentaNeta ?? 0).ToString("N2"))</span></div>
            <div class="d-flex justify-content-between small"><span class="text-muted">Entradas / Salidas</span><span>@((resumenCierre?.Entradas ?? 0).ToString("N2")) / -@((resumenCierre?.Salidas ?? 0).ToString("N2"))</span></div>
            <hr />
            @foreach (var d in DenominacionesDOP.Todas)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="fw-semibold" style="min-width:90px;">@DenominacionesDOP.Etiqueta(d)</span>
                    <div class="input-group" style="max-width:220px;">
                        <button class="btn btn-outline-secondary btn-lg" @onclick="() => CambiarConteo(d, -1)">−</button>
                        <input type="number" class="form-control form-control-lg text-center" min="0" value="@GetConteo(d)" @onchange="(e => SetConteo(d, e))" />
                        <button class="btn btn-outline-secondary btn-lg" @onclick="() => CambiarConteo(d, 1)">+</button>
                    </div>
                    <span class="text-muted">@((d * GetConteo(d)).ToString("N2"))</span>
                </div>
            }
            <hr />
            <div class="d-flex justify-content-between"><span class="text-muted">Contado</span><span>@ContadoCierre.ToString("N2")</span></div>
            <div class="d-flex justify-content-between fs-5 fw-bold">
                <span>Diferencia</span>
                <span class="@(DiferenciaCierre == 0 ? "text-success" : "text-danger")">@DiferenciaCierre.ToString("N2") @(DiferenciaCierre == 0 ? "(cuadrado)" : DiferenciaCierre > 0 ? "(sobrante)" : "(faltante)")</span>
            </div>
            @if (DiferenciaCierre != 0)
            {
                <div class="mt-2">
                    <label class="form-label small fw-semibold">Motivo de la diferencia <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" placeholder="Obligatorio para cerrar con diferencia..." @bind="observacionCierre" />
                </div>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        @if (turnoCerrado != null)
        {
            <Button Color="ButtonColor.Secondary" @onclick="CerrarModalCierre">Cerrar</Button>
            <Button Color="ButtonColor.Primary" @onclick="ImprimirCuadre"><Icon Name="IconName.Printer" /> Imprimir (80mm)</Button>
        }
        else
        {
            <Button Color="ButtonColor.Secondary" @onclick="CerrarModalCierre">Cancelar</Button>
            <Button Color="ButtonColor.Danger" Disabled="cerrandoTurno" @onclick="CerrarTurno">
                @if (cerrandoTurno) { <Spinner Size="SpinnerSize.Small" /> } else { <span><Icon Name="IconName.CheckCircle" /> Confirmar cierre</span> }
            </Button>
        }
    </FooterTemplate>
</Modal>
<Modal @ref="modalTicket" Title="Ticket de venta" Size="ModalSize.Small">
    <BodyTemplate>
        <TicketVenta Empresa="empresa" Numero="@ticketNumero" Fecha="ticketFecha" ClienteNombre="@ticketCliente"
                     Items="ticketItems" Subtotal="ticketSubtotal" Descuento="ticketDescuento" Impuesto="ticketImpuesto" Total="ticketTotal"
                     Pagos="ticketPagos" Recibido="ticketRecibido" Cambio="ticketCambio" />
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="CerrarTicket">Cerrar</Button>
        <Button Color="ButtonColor.Primary" @onclick="ImprimirTicket"><Icon Name="IconName.Printer" /> Imprimir (80mm)</Button>
    </FooterTemplate>
</Modal>

@code {
    private List<Product> productos = [];
    private List<Customer> clientes = [];
    private List<DetalleVenta> carrito = [];
    private int clienteId;
    private bool clienteGenerico;
    private string nombreGenerico = "";
    private string tabPos = "productos";
    private List<WEB.Services.Pos.VentaSesion> ventasTurno = [];
    private bool cargandoVentas;
    private string filtroVentas = "";

    private List<WEB.Services.Pos.VentaSesion> VentasFiltradas =>
        string.IsNullOrWhiteSpace(filtroVentas)
            ? ventasTurno
            : ventasTurno.Where(v =>
                v.ClienteNombre.Contains(filtroVentas.Trim(), StringComparison.OrdinalIgnoreCase) ||
                v.Numero.Contains(filtroVentas.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private string proximoNumero = "generando...";
    private decimal montoEfectivo;
    private decimal montoTarjeta;
    private string refTarjeta = "";
    private decimal montoTransf;
    private string refTransf = "";
