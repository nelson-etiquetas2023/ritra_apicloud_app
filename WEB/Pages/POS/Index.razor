    private async Task GuardarMovimiento()
    {
        if (turnoAbierto == null) return;
        if (montoMov <= 0)
        {
            ToastService.Notify(new(ToastType.Danger, "Indica un monto mayor a cero."));
            return;
        }
        if (string.IsNullOrWhiteSpace(motivoMov))
        {
            ToastService.Notify(new(ToastType.Danger, "Indica el motivo del movimiento."));
            return;
        }
        guardandoMov = true;
        try
        {
            var tipo = tipoMov;
            var monto = montoMov;
            var r = await TurnosService.AgregarMovimientoAsync(turnoAbierto.Id, tipo, monto, motivoMov.Trim());
            if (!r.Success)
            {
                ToastService.Notify(new(ToastType.Danger, r.Message));
