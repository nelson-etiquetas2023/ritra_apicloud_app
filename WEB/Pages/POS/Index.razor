            await CargarVentasTurno();
            ToastService.Notify(new(ToastType.Success, $"Turno abierto ({turnoAbierto?.Caja}). Ya puedes cobrar."));
        }
        finally
        {
            abriendoTurno = false;
            StateHasChanged();
        }
    }

