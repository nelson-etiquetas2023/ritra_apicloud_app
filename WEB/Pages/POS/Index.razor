    private async Task GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(nuevoClienteNombre))
        {
            ToastService.Notify(new(ToastType.Danger, "Indica el nombre del cliente."));
            return;
        }
        guardandoCliente = true;
        try
        {
            var idsAntes = clientes.Select(c => c.customer_id).ToHashSet();
            var ok = await CustomersService.CreateCustomerAsync(new Customer
            {
                CustomerName = nuevoClienteNombre.Trim(),
                RNC = nuevoClienteRNC.Trim(),
                Telefono = nuevoClienteTel.Trim(),
                Direccion = nuevoClienteDir.Trim()
            });
            if (!ok)
            {
                ToastService.Notify(new(ToastType.Danger, "No se pudo registrar el cliente."));
                return;
            }
            clientes = await CustomersService.GetCustomersAsync();
            var nuevo = clientes.Where(c => !idsAntes.Contains(c.customer_id)).ToList();
            var sel = nuevo.FirstOrDefault(c => c.CustomerName.Equals(nuevoClienteNombre.Trim(), StringComparison.OrdinalIgnoreCase))
                ?? nuevo.LastOrDefault();
            if (sel != null)
            {
                clienteId = sel.customer_id;
                clienteGenerico = false;
            }
            try { await modalCliente.HideAsync(); } catch { }
            ToastService.Notify(new(ToastType.Success, $"Cliente '{nuevoClienteNombre.Trim()}' registrado y seleccionado."));
        }
        finally
        {
            guardandoCliente = false;
            StateHasChanged();
        }
    }

