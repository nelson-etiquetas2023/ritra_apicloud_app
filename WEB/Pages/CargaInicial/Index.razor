@page "/CargaInicial"
@inject ICargasInicialesService servicio
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using WEB.Services.CargasIniciales
@using Shared.Dtos.CargasIniciales
@using Microsoft.AspNetCore.Components.QuickGrid

<ModalDetailsCargaInicial @ref="modalDetails" />

<Modal @ref="modalProcesarResult" Title="Resultado del procesamiento" Size="ModalSize.Large">
    <BodyTemplate>
        @if (procesarResult != null)
        {
            <div class="alert @(procesarResult.Success ? "alert-success" : "alert-danger")">
                <Icon Name="@(procesarResult.Success ? IconName.CheckCircle : IconName.XCircle)" /> @procesarResult.Message
            </div>
            @if (procesarResult.Errors.Count > 0)
            {
                <h6>Errores:</h6>
                <pre style="white-space:pre-wrap;font-family:inherit;max-height:200px;overflow-y:auto;">@(string.Join(Environment.NewLine, procesarResult.Errors.Select(e => e.Message)))</pre>
            }
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="CloseProcesarModal">Cerrar</Button>
    </FooterTemplate>
</Modal>

<div class="d-flex justify-content-between align-items-center mt-0">
    <h2 class="mb-0"><Icon Name="IconName.FileExcel" Size="IconSize.x2" /> Carga de Iniciales</h2>
    <button class="btn btn-primary" type="button" @onclick="NuevaCarga">
        <Icon Name="IconName.Plus" Size="IconSize.x4" /> Nueva Carga
    </button>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-light px-2 py-1 mt-2">
    <div class="container-fluid d-flex justify-content-between align-items-center p-0">
        <form id="formbusqueda" class="d-flex align-items-center gap-2 w-100" @onsubmit="buscar" @onsubmit:preventDefault>
            <strong class="text-nowrap">buscar por filtro:</strong>
            <div class="d-flex flex-grow-1">
                <input id="txt_busqueda" type="text" class="form-control me-2" placeholder="Buscar por numero, comentario, producto o ubicacion..."
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <Button Type="ButtonType.Submit" class="btn btn-primary">
                    <Icon Name="IconName.Search" />
                </Button>
            </div>
            <strong class="text-nowrap" style="width: 100px;">@cargasFiltered?.Count().ToString() Items.</strong>
        </form>
    </div>
</nav>

@if (Cargas == null)
{
    <div class="d-flex justify-content-center align-items-center p-5">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else if (!cargasFiltered!.Any())
{
    <div class="text-center py-5">
        <h6 class="text-muted"><Icon Name="IconName.Inbox" /> No hay documentos</h6>
        <p class="text-muted">Presiona "Nueva Carga" para crear la primera carga inicial.</p>
    </div>
}
else
{
    <QuickGrid Items="cargasFiltered!.AsQueryable()" ItemsPerPage="@pageSize" class="table table-hover table-bordered table-striped" Pagination="@paginationIndex" Style="font-size:0.9rem;">
        <TemplateColumn Title="Numero" Sortable="true">
            <strong>@context.Numero</strong>
        </TemplateColumn>
        <TemplateColumn Title="Fecha Doc." Sortable="true">
            <Icon Name="IconName.CalendarDate" />
            @context.FechaCreacion.ToString("dd-MM-yyyy HH:mm:ss")
        </TemplateColumn>
        <PropertyColumn Property="@(c => c.Comentario)" Title="Comentario" Sortable="true" />
        <TemplateColumn Title="Items" Sortable="true">
            <Badge Color="BadgeColor.Info" VisuallyHiddenText="Cantidad de líneas">
                @context.Detalles.Count
            </Badge>
        </TemplateColumn>
        <TemplateColumn Title="Cant. Teórica">
            <span class="fw-semibold">@context.Detalles.Sum(d => d.Cantidad).ToString("N0")</span>
        </TemplateColumn>
        <TemplateColumn Title="Cant. Física">
            <span class="fw-semibold">@context.Detalles.Sum(d => d.CantidadFisica).ToString("N0")</span>
        </TemplateColumn>
        <TemplateColumn Title="Diferencia">
            @{
                var dif = context.Detalles.Sum(d => d.Diferencia);
            }
            <Badge Color="@(dif == 0 ? BadgeColor.Success : BadgeColor.Danger)" VisuallyHiddenText="Diferencia">
                @(dif > 0 ? "+" : "")@dif.ToString("N0")
            </Badge>
        </TemplateColumn>
        <TemplateColumn Title="Total">
            <span class="fw-semibold">@($"${context.Detalles.Sum(d => d.Cantidad * d.Costo):N2}")</span>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            @if (context.Status == 0)
            {
                <Badge Color="BadgeColor.Info">Creado</Badge>
            }
            else if (context.Status == 1)
            {
                <Badge Color="BadgeColor.Warning">Actualizado</Badge>
            }
            else if (context.Status == 2)
            {
                <Badge Color="BadgeColor.Success">Sincronizado</Badge>
            }
            else if (context.Status == 4)
            {
                <Badge Color="BadgeColor.Success">Procesado</Badge>
            }
            else if (context.Status == 5)
            {
                <Badge Color="BadgeColor.Danger">Transacción Fallida</Badge>
            }
            else
            {
                <Badge Color="BadgeColor.Secondary">@context.Status</Badge>
            }
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            @if (context.Status != 4 && context.Status != 5)
            {
                <Tooltip Title="Editar" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => Editar(context)" style="cursor: pointer">
                        <Icon Name="IconName.PencilFill" Size="IconSize.x5" Color="IconColor.Dark" />
                    </a>
                </Tooltip>
            }
            <Tooltip Title="Ver Detalles" Placement="TooltipPlacement.Top">
                <a href="javascript:void(0)" @onclick="() => ShowDetails(context)" style="cursor: pointer; margin-left:10px;">
                    <Icon Name="IconName.EyeFill" Size="IconSize.x5" Color="IconColor.Dark" />
                </a>
            </Tooltip>
            @if (context.Status != 4 && context.Status != 5)
            {
                <Tooltip Title="Procesar" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => Procesar(context)" style="cursor: pointer; margin-left:10px;">
                        <Icon Name="IconName.PlayCircleFill" Size="IconSize.x5" Color="IconColor.Success" />
                    </a>
                </Tooltip>
            }
            @if (context.Status != 4 && context.Status != 5)
            {
                <Tooltip Title="Eliminar" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => Eliminar(context)" style="cursor: pointer; margin-left:10px;">
                        <Icon Name="IconName.TrashFill" Size="IconSize.x5" Color="IconColor.Danger" />
                    </a>
                </Tooltip>
            }
        </TemplateColumn>
    </QuickGrid>
    <div class="mt-2">
        <Paginator State="@paginationIndex" />
    </div>
}

@code {

    private List<Inicial>? Cargas;
    private IEnumerable<Inicial>? cargasFiltered;
    private string searchText = "";
    private PaginationState paginationIndex = new PaginationState { ItemsPerPage = 15 };
    private int pageSize = 15;
    private ModalDetailsCargaInicial modalDetails = default!;
    private Modal? modalProcesarResult;
    private CargaInicialSaveResult? procesarResult;

    protected override async Task OnInitializedAsync()
    {
        await LoadCargas();
    }

    private async Task LoadCargas()
    {
        Cargas = await servicio.GetAllAsync();
        buscar();
    }

    private void buscar()
    {
        if (Cargas == null) return;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            cargasFiltered = Cargas
                .OrderByDescending(c => c.FechaCreacion)
                .ThenByDescending(c => c.Numero);
        }
        else
        {
            cargasFiltered = Cargas.Where(c =>
                (c.Numero != null && c.Numero.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (c.Comentario != null && c.Comentario.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                c.Detalles.Any(d =>
                    (d.ProductCode != null && d.ProductCode.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (d.ProductName != null && d.ProductName.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (d.Ubicacion != null && d.Ubicacion.Contains(searchText, StringComparison.OrdinalIgnoreCase))))
                .OrderByDescending(c => c.FechaCreacion)
                .ThenByDescending(c => c.Numero);
        }
        StateHasChanged();
    }

    private void NuevaCarga()
    {
        Navigation.NavigateTo("/CargaInicial/nueva");
    }

    private void Editar(Inicial carga)
    {
        Navigation.NavigateTo($"/CargaInicial/editar/{carga.Id}");
    }

    private async Task ShowDetails(Inicial carga)
    {
        await modalDetails.ShowAsync(carga);
    }

    private async Task Eliminar(Inicial carga)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas eliminar la carga inicial {carga.Numero}? Esta acción no se puede deshacer.");
        if (!confirm) return;

        var ok = await servicio.DeleteAsync(carga.Id);
        if (ok)
        {
            ToastService.Notify(new(ToastType.Success, $"Carga inicial {carga.Numero} eliminada."));
            await LoadCargas();
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, "No se pudo eliminar la carga inicial."));
        }
    }

    private async Task Procesar(Inicial carga)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas procesar la carga inicial {carga.Numero}? El stock de los productos se incrementará.");
        if (!confirm) return;

        procesarResult = null;
        if (modalProcesarResult != null)
            await modalProcesarResult.ShowAsync();

        procesarResult = await servicio.ProcesarAsync(carga.Id);
        await LoadCargas();
        StateHasChanged();
    }

    private async Task CloseProcesarModal()
    {
        if (modalProcesarResult != null)
            await modalProcesarResult.HideAsync();
    }
}