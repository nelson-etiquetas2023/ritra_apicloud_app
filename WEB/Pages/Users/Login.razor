@page "/user/login"
@inject NavigationManager navigator

<LoginForm OnAuthenticated="HandleAuthenticated" OnLocked="HandleLocked" OnShowRegister="ShowRegister" />

@code {
    private async Task HandleAuthenticated()
    {
        navigator.NavigateTo("/");
    }

    private void HandleLocked()
    {
        navigator.NavigateTo("/", forceLoad: true);
    }

    private void ShowRegister()
    {
        navigator.NavigateTo("/users/userregistration");
    }
}