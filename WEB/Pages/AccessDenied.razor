@inject NavigationManager Navigation

<div class="d-flex flex-column align-items-center justify-content-center text-center px-3 py-5">
    <Icon Name="IconName.ShieldLockFill" Size="IconSize.x5" Color="IconColor.Danger" />
    <h3 class="mt-3 mb-2">Acceso denegado</h3>
    <p class="mb-3 text-muted">No tienes permisos para ver esta sección.</p>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="GoHome">
            <Icon Name="IconName.HouseDoorFill" /> Volver al inicio
        </button>
        <button class="btn btn-outline-secondary" @onclick="GoLogin">
            <Icon Name="IconName.KeyFill" /> Iniciar sesión
        </button>
    </div>
</div>

@code {
    private void GoHome() => Navigation.NavigateTo("/");

    private void GoLogin() => Navigation.NavigateTo("/user/login");
}
