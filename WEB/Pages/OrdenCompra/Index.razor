@page "/ordencompra"
@inject IOrdenCompraService servicio
@inject IInventarioService inventarioService
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using WEB.Services.OrdenCompra
@using WEB.Services.Inventario
@using WEB.Pages.Mobile
@using Shared.Dtos.Compras
@using Microsoft.AspNetCore.Components.QuickGrid

<ModalDetailsOrdenCompra @ref="modalDetails" />

<div class="d-flex justify-content-between align-items-center mt-0">
    <h2 class="mb-0"><Icon Name="IconName.Cart" Size="IconSize.x2" /> Orden de Compra</h2>
    <button class="btn btn-primary" type="button" @onclick="NuevaOC">
        <Icon Name="IconName.Plus" Size="IconSize.x4" /> Nueva Orden
    </button>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-light px-2 py-1 mt-2">
    <div class="container-fluid d-flex justify-content-between align-items-center p-0">
        <form id="formbusqueda" class="d-flex align-items-center gap-2 w-100" @onsubmit="buscar" @onsubmit:preventDefault>
            <strong class="text-nowrap">buscar por filtro:</strong>
            <div class="d-flex flex-grow-1">
                <input id="txt_busqueda" type="text" class="form-control me-2" placeholder="Buscar por numero, proveedor, descripcion o fecha..."
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <Button Type="ButtonType.Submit" class="btn btn-primary">
                    <Icon Name="IconName.Search" />
                </Button>
            </div>
            <strong class="text-nowrap" style="width: 100px;">@ordenesFiltered?.Count().ToString() Items.</strong>
        </form>
    </div>
</nav>

@if (Ordenes == null)
{
    <div class="d-flex justify-content-center align-items-center p-5">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else if (!ordenesFiltered!.Any())
{
    <div class="text-center py-5">
        <h6 class="text-muted"><Icon Name="IconName.Inbox" /> No hay documentos</h6>
        <p class="text-muted">Presiona "Nueva Orden" para crear la primera orden de compra.</p>
    </div>
}
else
{
    @if (ordenesSeleccionadas.Count > 0)
    {
        <div class="alert alert-info mb-3">
            <strong>@ordenesSeleccionadas.Count orden(es) seleccionada(s)</strong>
            <button class="btn btn-success btn-sm ms-3" @onclick="AutorizarOleada" disabled="@autorizandoOleada">
                <Icon Name="IconName.Send" Size="IconSize.x4" style="margin-right:4px;" />@(autorizandoOleada ? "Enviando..." : "Autorizar oleada a móvil")
            </button>
            <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="LimpiarSeleccion">
                <Icon Name="IconName.XCircle" Size="IconSize.x4" style="margin-right:4px;" />Limpiar
            </button>
        </div>
    }

    <QuickGrid Items="ordenesFiltered!.AsQueryable()" ItemsPerPage="@pageSize" class="table table-hover table-bordered table-striped" Pagination="@paginationIndex" Style="font-size:0.9rem;">
        <TemplateColumn Title="Seleccionar" Sortable="false">
            <input type="checkbox"
                   disabled="@(context.Status == 3 || context.Status == 4 || context.Status == 5 || context.Status == 6)"
                   @onchange="() => ToggleSeleccion(context.Numero)"
                   checked="@ordenesSeleccionadas.Contains(context.Numero)" />
        </TemplateColumn>
        <TemplateColumn Title="Numero" Sortable="true">
            <strong>@context.Numero</strong>
        </TemplateColumn>
        <TemplateColumn Title="Fecha" Sortable="true">
            <Icon Name="IconName.CalendarDate" />
            @context.FechaCreacion.ToString("dd-MM-yyyy HH:mm:ss")
        </TemplateColumn>
        <TemplateColumn Title="Entrega" Sortable="true">
            <Icon Name="IconName.CalendarDate" />
            @context.Fecha.ToString("dd-MM-yyyy")
        </TemplateColumn>
        <TemplateColumn Title="Proveedor" Sortable="true">
            @context.Supply_Name
        </TemplateColumn>
        <PropertyColumn Property="@(o => o.Description)" Title="Descripcion" Sortable="true" />
        <TemplateColumn Title="Items" Sortable="true">
            <Badge Color="BadgeColor.Info" VisuallyHiddenText="Cantidad de líneas">
                @context.Items.Count
            </Badge>
        </TemplateColumn>
        <TemplateColumn Title="Total">
            <span class="fw-semibold">@($"${context.Total:N2}")</span>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            @if (context.Status == 0)
            {
                <Badge Color="BadgeColor.Info">Planificado</Badge>
            }
            else if (context.Status == 1)
            {
                <Badge Color="BadgeColor.Warning">Actualizado</Badge>
            }
            else if (context.Status == 2)
            {
                <Badge Color="BadgeColor.Success">Sincronizado</Badge>
            }
            else if (context.Status == 3)
            {
                <Badge Color="BadgeColor.Secondary">Cerrado</Badge>
            }
            else if (context.Status == 4)
            {
                <Badge Color="BadgeColor.Success">Procesado</Badge>
            }
            else if (context.Status == 5)
            {
                <Badge Color="BadgeColor.Danger">Transacción Fallida</Badge>
            }
            else if (context.Status == 6)
            {
                <Badge Color="BadgeColor.Danger">Anulado</Badge>
            }
            else
            {
                <Badge Color="BadgeColor.Secondary">@context.Status</Badge>
            }
        </TemplateColumn>
        <TemplateColumn Title="Prioridad" Sortable="true">
            @switch (context.Prioridad)
            {
                case "Urgente":
                    <Badge Color="BadgeColor.Danger">Urgente</Badge>
                    break;
                case "Alta":
                    <Badge Color="BadgeColor.Warning">Alta</Badge>
                    break;
                case "Media":
                    <Badge Color="BadgeColor.Info">Media</Badge>
                    break;
                default:
                    <Badge Color="BadgeColor.Secondary">Normal</Badge>
                    break;
            }
        </TemplateColumn>
        <TemplateColumn Title="Cumplimiento">
            @if (EstaAtrasado(context))
            {
                <Tooltip Title="@TextoCumplimiento(context)" Placement="TooltipPlacement.Top">
                    <Badge Color="BadgeColor.Danger">Atrasado</Badge>
                </Tooltip>
            }
            else
            {
                <Tooltip Title="@TextoCumplimiento(context)" Placement="TooltipPlacement.Top">
                    <Badge Color="BadgeColor.Success">Normal</Badge>
                </Tooltip>
            }
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <div style="white-space:nowrap;">
                <Tooltip Title="Ver detalles" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => ShowDetails(context)" style="cursor: pointer; margin-right:6px;">
                        <Icon Name="IconName.EyeFill" Size="IconSize.x5" Color="IconColor.Dark" />
                    </a>
                </Tooltip>
                @if (context.Status != 4 && context.Status != 5 && context.Status != 6 && context.Status != 3)
                {
                    <Tooltip Title="Actualizar" Placement="TooltipPlacement.Top">
                        <a href="javascript:void(0)" @onclick="() => Editar(context)" style="cursor: pointer; margin-right:6px;">
                            <Icon Name="IconName.PencilFill" Size="IconSize.x5" Color="IconColor.Dark" />
                        </a>
                    </Tooltip>
                    <Tooltip Title="Anular" Placement="TooltipPlacement.Top">
                        <a href="javascript:void(0)" @onclick="() => Anular(context)" style="cursor: pointer; margin-right:6px;">
                            <Icon Name="IconName.XCircle" Size="IconSize.x5" Color="IconColor.Danger" />
                        </a>
                    </Tooltip>
                    <Tooltip Title="Procesar orden" Placement="TooltipPlacement.Top">
                        <Button Color="ButtonColor.Success" Size="ButtonSize.Small" @onclick="() => ProcesarOrden(context)" disabled="@procesando">
                            <Icon Name="IconName.CheckCircle" Size="IconSize.x4" />
                        </Button>
                    </Tooltip>
                }
                else
                {
                    <span class="badge bg-secondary" style="font-size:0.75rem;">Bloqueado</span>
                }
            </div>
        </TemplateColumn>
    </QuickGrid>

    @if (ordenesFiltered!.Any())
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <button class="btn btn-outline-primary btn-sm" @onclick="ToggleSeleccionarTodo">
                    <Icon Name="@(ordenesSeleccionadas.Count == (ordenesFiltered?.Count() ?? 0) ? IconName.CheckCircleFill : IconName.CheckCircle)" Size="IconSize.x4" style="margin-right:4px;" />
                    @(ordenesSeleccionadas.Count == (ordenesFiltered?.Count() ?? 0) ? "Seleccionar ninguno" : "Seleccionar todo")
                </button>
            </div>
        </div>
    }

    <div class="mt-2">
        <GridPaginator State="@paginationIndex" />
    </div>
}

@code {

    private List<OrdenCompra>? Ordenes;
    private IEnumerable<OrdenCompra>? ordenesFiltered;
    private string searchText = "";
    private PaginationState paginationIndex = new PaginationState { ItemsPerPage = 15 };
    private int pageSize = 15;
    private ModalDetailsOrdenCompra modalDetails = default!;
    private bool procesando;
    private string procesandoNumero = "";
    private HashSet<string> ordenesSeleccionadas = new();
    private bool autorizandoOleada;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        Ordenes = await servicio.GetOrdersAsync();
        buscar();
    }

    private static int NumeroOrdenKey(OrdenCompra o)
    {
        return int.TryParse(o.Numero?.Replace("OC-", ""), out var n) ? n : 0;
    }

    private void buscar()
    {
        if (Ordenes == null) return;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            ordenesFiltered = Ordenes.OrderByDescending(NumeroOrdenKey);
        }
        else
        {
            ordenesFiltered = Ordenes.Where(o =>
                (o.Numero != null && o.Numero.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (o.Supply_Name != null && o.Supply_Name.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (o.Description != null && o.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (o.FechaCreacion.ToString("dd-MM-yyyy HH:mm:ss").Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (o.Tipo_Documento != null && o.Tipo_Documento.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                .OrderByDescending(NumeroOrdenKey);
        }
        StateHasChanged();
    }

    private void NuevaOC()
    {
        Navigation.NavigateTo("/ordencompra/nueva");
    }

    private void Editar(OrdenCompra oc)
    {
        Navigation.NavigateTo($"/ordencompra/editar/{oc.Numero}");
    }

    private async Task ShowDetails(OrdenCompra oc)
    {
        await modalDetails.ShowAsync(oc);
    }

    private async Task ProcesarOrden(OrdenCompra oc)
    {
        if (procesando) return;

        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Está seguro de que desea procesar la orden {oc.Numero}? Esto incrementará el inventario y no se podrá deshacer.");
        if (!confirm) return;

        procesando = true;
        procesandoNumero = oc.Numero;
        StateHasChanged();

        try
        {
            var resultado = await inventarioService.ProcesarOrdenAsync(oc.Numero);
            if (resultado is not null && resultado.Success)
            {
                ToastService.Notify(new(ToastType.Success, $"Orden {oc.Numero} procesada correctamente."));
                await LoadOrders();
            }
            else
            {
                string msg = resultado?.Message ?? "No se pudo procesar la orden.";
                ToastService.Notify(new(ToastType.Danger, msg));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error al procesar la orden: {ex.Message}"));
        }
        finally
        {
            procesando = false;
            procesandoNumero = "";
            StateHasChanged();
        }
    }

    private void ToggleSeleccion(string numero)
    {
        if (string.IsNullOrWhiteSpace(numero)) return;
        var oc = Ordenes?.FirstOrDefault(o => o.Numero == numero);
        if (oc == null) return;
        // No se seleccionan documentos terminales o ya procesados.
        if (oc.Status == 3 || oc.Status == 4 || oc.Status == 5 || oc.Status == 6) return;
        if (ordenesSeleccionadas.Contains(numero))
            ordenesSeleccionadas.Remove(numero);
        else
            ordenesSeleccionadas.Add(numero);
    }

    private void ToggleSeleccionarTodo()
    {
        if (ordenesFiltered == null) return;
        var todos = ordenesFiltered.Where(o => !string.IsNullOrEmpty(o.Numero) && o.Status != 3 && o.Status != 4 && o.Status != 5 && o.Status != 6).Select(o => o.Numero!).ToList();
        if (ordenesSeleccionadas.Count == todos.Count && todos.Count > 0)
            ordenesSeleccionadas.Clear();
        else
            ordenesSeleccionadas = new HashSet<string>(todos);
    }

    private void LimpiarSeleccion()
    {
        ordenesSeleccionadas.Clear();
    }

    private async Task AutorizarOleada()
    {
        if (ordenesSeleccionadas.Count == 0 || autorizandoOleada) return;

        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Está seguro de autorizar {ordenesSeleccionadas.Count} orden(es) para enviarlas como oleada a la aplicación móvil?");
        if (!confirm) return;

        autorizandoOleada = true;
        StateHasChanged();

        try
        {
            int exitosos = 0;
            foreach (var numero in ordenesSeleccionadas.ToList())
            {
                var oc = Ordenes?.FirstOrDefault(o => o.Numero == numero);
                if (oc == null) continue;

                var ocParaEnviar = new OrdenCompra
                {
                    Numero = oc.Numero,
                    Fecha = oc.Fecha,
                    FechaCreacion = oc.FechaCreacion,
                    Description = oc.Description,
                    Comentario = oc.Comentario,
                    Status = 2, // Sincronizado -> disponible para el móvil
                    Sincro = true,
                    Tipo_Documento = oc.Tipo_Documento,
                    Subtotal = oc.Subtotal,
                    Impuesto = oc.Impuesto,
                    Total = oc.Total,
                    Supply_Id = oc.Supply_Id,
                    Supply_Name = oc.Supply_Name,
                    Reference = oc.Reference,
                    Prioridad = oc.Prioridad,
                    UserName = oc.UserName,
                    UserEmail = oc.UserEmail,
                    UserRole = oc.UserRole,
                    DeviceCode = oc.DeviceCode,
                    DeviceName = oc.DeviceName,
                    WarehouseName = oc.WarehouseName,
                    Items = oc.Items?.Select(i => new DetalleCompras
                    {
                        Id = i.Id,
                        Numero = i.Numero,
                        Product_id = i.Product_id,
                        Product_name = i.Product_name,
                        Cantidad = i.Cantidad,
                        Costo = i.Costo,
                        Subtotal = i.Subtotal,
                        Comentario = i.Comentario,
                        Procesado = i.Procesado,
                        FechaProcesado = i.FechaProcesado
                    }).ToList() ?? []
                };

                var ok = await servicio.UpdateOrderAsync(numero, ocParaEnviar);
                if (ok) exitosos++;
            }

            ToastService.Notify(new(ToastType.Success, $"Oleada autorizada: {exitosos}/{ordenesSeleccionadas.Count} orden(es) enviadas al móvil."));
            ordenesSeleccionadas.Clear();
            await LoadOrders();
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error autorizando oleada: {ex.Message}"));
        }
        finally
        {
            autorizandoOleada = false;
            StateHasChanged();
        }
    }

    private async Task Eliminar(OrdenCompra oc)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas eliminar la orden {oc.Numero}? Esta acción no se puede deshacer.");
        if (!confirm) return;

        var ok = await servicio.DeleteOrderAsync(oc.Numero);
        if (ok)
        {
            ToastService.Notify(new(ToastType.Success, $"Orden {oc.Numero} eliminada."));
            await LoadOrders();
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, "No se pudo eliminar la orden. Los documentos procesados no pueden eliminarse."));
        }
    }

    private async Task Anular(OrdenCompra oc)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas anular la orden {oc.Numero}? Esta acción no se puede deshacer.");
        if (!confirm) return;

        var ok = await servicio.AnularOrderAsync(oc.Numero);
        if (ok)
        {
            oc.Status = 6;
            ToastService.Notify(new(ToastType.Success, $"Orden {oc.Numero} anulada."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, $"No se pudo anular la orden {oc.Numero}."));
        }
        buscar();
    }

    private bool EstaAtrasado(OrdenCompra oc)
    {
        return oc.Status != 4 && DateTime.Today > oc.Fecha.Date;
    }

    private string TextoCumplimiento(OrdenCompra oc)
    {
        var dias = (oc.Fecha.Date - DateTime.Today).Days;
        return EstaAtrasado(oc)
            ? $"Venció hace {Math.Abs(dias)} día(s) desde su creación ({oc.FechaCreacion:dd-MM-yyyy})."
            : $"Dentro del plazo: {dias} día(s) para la entrega tentativa.";
    }
}
