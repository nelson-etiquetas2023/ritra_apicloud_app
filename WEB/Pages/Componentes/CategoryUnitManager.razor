@inject IConfigService service
@inject IJSRuntime JS

<Modal @ref="modal" Size="ModalSize.Large">
    <HeaderTemplate><Icon Name="IconName.Gear" Size="IconSize.x3" /><strong>@title</strong></HeaderTemplate>
    <BodyTemplate>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2" role="alert">@errorMessage</div>
        }

        <div class="d-flex justify-content-between align-items-center mb-3">
            <input class="form-control me-2" placeholder="Buscar..." @bind="searchText" @bind:event="oninput" />
            <Button Color="ButtonColor.Primary" @onclick="NewItem"><Icon Name="IconName.Plus" /> Nuevo</Button>
        </div>

        @if (mode == ManagerMode.Category)
        {
            @if (showForm)
            {
                <EditForm Model="editingCategory" OnValidSubmit="SaveCategory" class="border rounded p-3 mb-3 bg-light">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-5 mb-2"><label class="form-label">Nombre *</label><InputText class="form-control" @bind-Value="editingCategory.Name" /><ValidationMessage For="@(() => editingCategory.Name)" /></div>
                        <div class="col-md-5 mb-2"><label class="form-label">Descripción</label><InputText class="form-control" @bind-Value="editingCategory.Description" /></div>
                        <div class="col-md-2 mb-2 d-flex align-items-end"><Switch @bind-Value="editingCategory.IsActive" Label="Activa" /></div>
                    </div>
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Success">Guardar</Button>
                    <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CancelItem">Cancelar</Button>
                </EditForm>
            }
            <table class="table table-hover align-middle">
                <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var category in FilteredCategories)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td>@category.Description</td>
                            <td><span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">@(category.IsActive ? "Activa" : "Inactiva")</span></td>
                            <td class="text-end">
                                <Button Color="ButtonColor.Link" @onclick="() => EditCategory(category)">Editar</Button>
                                <Button Color="ButtonColor.Link" @onclick="() => DeleteCategory(category)">Eliminar</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            @if (showForm)
            {
                <EditForm Model="editingUnit" OnValidSubmit="SaveUnit" class="border rounded p-3 mb-3 bg-light">
                    <DataAnnotationsValidator />
                    <div class="row">
                        <div class="col-md-5 mb-2"><label class="form-label">Nombre *</label><InputText class="form-control" @bind-Value="editingUnit.Name" /><ValidationMessage For="@(() => editingUnit.Name)" /></div>
                        <div class="col-md-5 mb-2"><label class="form-label">Descripción</label><InputText class="form-control" @bind-Value="editingUnit.Description" /></div>
                        <div class="col-md-2 mb-2 d-flex align-items-end"><Switch @bind-Value="editingUnit.IsActive" Label="Activa" /></div>
                    </div>
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Success">Guardar</Button>
                    <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CancelItem">Cancelar</Button>
                </EditForm>
            }
            <table class="table table-hover align-middle">
                <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                <tbody>
                    @foreach (var unit in FilteredUnits)
                    {
                        <tr>
                            <td>@unit.Name</td>
                            <td>@unit.Description</td>
                            <td><span class="badge @(unit.IsActive ? "bg-success" : "bg-secondary")">@(unit.IsActive ? "Activa" : "Inactiva")</span></td>
                            <td class="text-end">
                                <Button Color="ButtonColor.Link" @onclick="() => EditUnit(unit)">Editar</Button>
                                <Button Color="ButtonColor.Link" @onclick="() => DeleteUnit(unit)">Eliminar</Button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </BodyTemplate>
</Modal>

@code {
    private enum ManagerMode { Category, Unit }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Modal modal = default!;
    private ManagerMode mode;
    private string title = "";
    private string searchText = "";
    private bool showForm;
    private string errorMessage = "";

    private List<Category> categories = [];
    private Category editingCategory = new();

    private List<ProductUnit> units = [];
    private ProductUnit editingUnit = new();

    private IEnumerable<Category> FilteredCategories => categories.Where(c =>
        string.IsNullOrWhiteSpace(searchText) ||
        c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        c.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ProductUnit> FilteredUnits => units.Where(u =>
        string.IsNullOrWhiteSpace(searchText) ||
        u.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
        u.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    public async Task ShowCategoriesAsync()
    {
        mode = ManagerMode.Category;
        title = "Gestión de categorías de productos";
        searchText = "";
        showForm = false;
        errorMessage = "";
        categories = await service.GetCategoriesAsync();
        await modal.ShowAsync();
    }

    public async Task ShowUnitsAsync()
    {
        mode = ManagerMode.Unit;
        title = "Gestión de unidades de productos";
        searchText = "";
        showForm = false;
        errorMessage = "";
        units = await service.GetProductUnitsAsync();
        await modal.ShowAsync();
    }

    private void NewItem()
    {
        errorMessage = "";
        if (mode == ManagerMode.Category)
        {
            editingCategory = new Category { IsActive = true };
        }
        else
        {
            editingUnit = new ProductUnit { IsActive = true };
        }
        showForm = true;
    }

    private void EditCategory(Category category)
    {
        errorMessage = "";
        editingCategory = new Category { Id = category.Id, Name = category.Name, Description = category.Description, IsActive = category.IsActive };
        showForm = true;
    }

    private void EditUnit(ProductUnit unit)
    {
        errorMessage = "";
        editingUnit = new ProductUnit { Id = unit.Id, Name = unit.Name, Description = unit.Description, IsActive = unit.IsActive };
        showForm = true;
    }

    private void CancelItem()
    {
        showForm = false;
        errorMessage = "";
    }

    private async Task SaveCategory()
    {
        var saved = editingCategory.Id == 0
            ? await service.CreateCategoryAsync(editingCategory)
            : await service.UpdateCategoryAsync(editingCategory.Id, editingCategory);

        if (saved == null)
        {
            errorMessage = "No se pudo guardar. Verifica que el nombre no esté repetido.";
            return;
        }

        await ReloadAndNotify();
    }

    private async Task SaveUnit()
    {
        var saved = editingUnit.Id == 0
            ? await service.CreateProductUnitAsync(editingUnit)
            : await service.UpdateProductUnitAsync(editingUnit.Id, editingUnit);

        if (saved == null)
        {
            errorMessage = "No se pudo guardar. Verifica que el nombre no esté repetido.";
            return;
        }

        await ReloadAndNotify();
    }

    private async Task DeleteCategory(Category category)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la categoría '{category.Name}'?")) return;
        if (await service.DeleteCategoryAsync(category.Id))
        {
            await ReloadAndNotify();
        }
    }

    private async Task DeleteUnit(ProductUnit unit)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la unidad '{unit.Name}'?")) return;
        if (await service.DeleteProductUnitAsync(unit.Id))
        {
            await ReloadAndNotify();
        }
    }

    private async Task ReloadAndNotify()
    {
        showForm = false;
        errorMessage = "";
        if (mode == ManagerMode.Category)
        {
            categories = await service.GetCategoriesAsync();
        }
        else
        {
            units = await service.GetProductUnitsAsync();
        }
        await OnChanged.InvokeAsync();
        StateHasChanged();
    }
}
