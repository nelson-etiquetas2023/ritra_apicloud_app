@inject IProductsService service;
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@inject IConfigService configService
@using Shared.Dtos

<Preload LoadingText="Guardando..."/>

<Modal @ref="modalUpdate" Size="ModalSize.Large">
    <HeaderTemplate><Icon Name="IconName.DatabaseSlash" Size="IconSize.x3" />
        <strong>Modificar Producto.</strong></HeaderTemplate>
    <BodyTemplate>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
            </div>
        }
        <EditForm Model="productoLocal" OnValidSubmit="UpdateProducts">
            <DataAnnotationsValidator/>
            <div class="mb-3">
                <label for="txt_product_name"><strong>Nombre del Producto :</strong></label>
                <InputText class="form-control" id="txt_product_name" @bind-Value="productoLocal.Product_Name" />
                <ValidationMessage For="@(() => productoLocal.Product_Name)"/>
            </div>
            <div class="mb-3">
                <label for="txt_category"><strong>Categoria :</strong></label>
                <InputSelect class="form-select" id="txt_category" @bind-Value="productoLocal.Product_Type">
                    <option value="">Seleccione una categoría...</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Name">@category.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => productoLocal.Product_Type)" />
            </div>
            <div class="mb-3">
                <label for="txt_unidad"><strong>Unidad :</strong></label>
                <InputSelect class="form-select" id="txt_unidad" @bind-Value="productoLocal.Unidad">
                    <option value="">Seleccione una unidad...</option>
                    @foreach (var unit in units.Where(u => u.IsActive))
                    {
                        <option value="@unit.Name">@unit.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => productoLocal.Unidad)" />
            </div>
            <div class="mb-3">
                <label for="txt_costo"><strong>Costo :</strong></label>
                <InputNumber class="form-control" id="txt_costo" @bind-Value="productoLocal.Costo" />
            </div>
            <div class="mb-3">
                <label for="txt_codebar"><strong>Codigo de Barra :</strong></label>
                <InputText class="form-control" id="txt_codebar" @bind-Value="productoLocal.Codebar" />
            </div>
            

            <!-- Sección de Imágenes -->
            <div class="mb-3">
                <label><strong>📸 Imágenes del Producto</strong></label>
                <p class="text-muted small">Haz clic en una imagen para reemplazarla o deja vacía para mantenerla</p>

                <div class="row mt-3 mb-3">
                    @for (int i = 0; i < 3; i++)
                    {
                        int currentIndex = i;
                <div class="col-md-4 mb-3">
                    <div class="image-edit-box clickable-box" @onclick="() => OpenFileDialog(currentIndex)">
                        @if (!string.IsNullOrEmpty(imagePreviews[i]))
                        {
                            <div class="image-preview-area">
                                <img src="@imagePreviews[i]" alt="Preview @(i+1)" class="img-preview-edit" />
                                <button type="button" class="btn-remove-image-edit" @onclick:stopPropagation @onclick="() => RemoveImage(i)" title="Eliminar imagen">
                                    ✕
                                </button>
                            </div>
                            <div class="image-info-edit">
                                <small class="text-success">✓ Imagen @(i + 1)</small>
                            </div>
                        }
                        else
                        {
                            <div class="image-placeholder-edit">
                                <div class="placeholder-icon-edit">📷</div>
                                <div class="placeholder-text-edit">Imagen @(i + 1)</div>
                                <div class="placeholder-hint-edit">Haz clic para cambiar</div>
                            </div>
                        }
                    </div>
                </div>
                    }
                </div>

                <InputFile @ref="fileInput" OnChange="OnFileSelected" accept="image/*" style="display:none" />
            </div>

            <div class="mb-3">
                <Button Type="ButtonType.Submit" style="background-color:limegreen"><Icon Name="IconName.Floppy2Fill" /> Guardar</Button>
                <Button Style="background-color:black;color:white" @onclick="HideAsync"><Icon Name="IconName.FileTypeDoc" />Cancelar</Button>
            </div>
            @* <div class="form-check mb-5 mt-5">
                <InputCheckbox @bind-Value="productoLocal.Desactivado" class="form-check-input" id="checkActivate" />
                <label class="form-check-label" for="checkActivate">
                    Desactivar producto
                </label>
            </div> *@
        </EditForm>
    </BodyTemplate>
</Modal>

@code {

    private Modal modalUpdate = default!;
    private InputFile fileInput = default!;
    private string[] imagePreviews = new string[3];
    private string[] imageNames = new string[3];
    private List<Base64ImageData> newImages = new();
    private int nextImageSlot = 0;
    private int lastLoadedProductId = -1;
    private List<Category> categories = [];
    private List<ProductUnit> units = [];
    private string errorMessage = string.Empty;

    // Crear una copia local del producto para evitar problemas de binding
    private Product productoLocal = new Product();

    [Parameter]
    public Product producto { get; set; } = new Product();

    [Parameter]
    public EventCallback<Product> OnProductUpdate { get; set; }

    [Inject]
    protected PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"OnInitializedAsync - Initial product ID: {producto?.Product_id}");
        await LoadProductImages();
    }

    protected override async Task OnParametersSetAsync()
    {
        Console.WriteLine($"OnParametersSetAsync - Product ID changed to: {producto?.Product_id}");
        // No recargar aquí, solo registrar. ShowAsync se encargará de recargar
    }

    private async Task LoadProductImages()
    {
        try
        {
            // Validar que tenemos un producto
            if (producto == null || producto.Product_id <= 0)
            {
                Console.WriteLine("LoadProductImages: Invalid product or no product selected");
                imagePreviews = new string[3];
                imageNames = new string[3];
                return;
            }

            Console.WriteLine($"LoadProductImages: Starting load for product ID {producto.Product_id}");

            // Limpiar arrays SIEMPRE
            imagePreviews = new string[3];
            imageNames = new string[3];

            // Si no hay imágenes, mostrar arrays vacíos
            if (producto?.Images == null || producto?.Images?.Count == 0)
            {
                Console.WriteLine($"LoadProductImages: No images found for product {producto?.Product_id}");
                return;
            }

            Console.WriteLine($"LoadProductImages: Found {producto?.Images?.Count} images for product {producto?.Product_id}");

            // Filtrar imágenes que pertenezcan a este producto
            var productImages = (producto?.Images ?? new List<ProductImage>())
                .Where(i => i.ProductId == producto?.Product_id)
                .OrderBy(i => i.ImageIndex)
                .ToList();

            Console.WriteLine($"LoadProductImages: After filtering by ProductId, found {productImages.Count} images");

            // Log detallado de cada imagen antes de cargar
            foreach (var img in productImages)
            {
                Console.WriteLine($"  - Image ID: {img.Id}, ProductId: {img.ProductId}, ImageIndex: {img.ImageIndex}, FileName: {img.FileName}");
            }

            // Cargar cada imagen
            foreach (var image in productImages)
            {
                if (image.ImageIndex >= 0 && image.ImageIndex < 3)
                {
                    try
                    {
                        Console.WriteLine($"LoadProductImages: Fetching bytes for image {image.Id}");

                        var imageBytes = await service.GetProductImageAsync(image.Id);
                        if (imageBytes != null && imageBytes.Length > 0)
                        {
                            var base64 = Convert.ToBase64String(imageBytes);
                            imagePreviews[image.ImageIndex] = $"data:{image.ContentType};base64,{base64}";
                            imageNames[image.ImageIndex] = image.FileName;
                            Console.WriteLine($"LoadProductImages: Image {image.Id} loaded successfully at index {image.ImageIndex} ({imageBytes.Length} bytes)");
                        }
                        else
                        {
                            Console.WriteLine($"LoadProductImages: Image bytes empty or null for {image.FileName}");
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"LoadProductImages: Error loading image {image.Id}: {ex.Message}");
                    }
                }
                else
                {
                    Console.WriteLine($"LoadProductImages: Invalid ImageIndex: {image.ImageIndex}");
                }
            }

            Console.WriteLine($"LoadProductImages: Completed. Loaded images: {imagePreviews.Count(x => !string.IsNullOrEmpty(x))}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadProductImages: Unexpected error: {ex.Message}\n{ex.StackTrace}");
        }
    }

    private string GetImageUrl(int imageId)
    {
        var client = HttpClientFactory.CreateClient("scanpro");
        var baseUrl = client.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5220";
        return $"{baseUrl}/api/products/getproductimage/{imageId}";
    }

    private async Task OpenFileDialog(int index)
    {
        try
        {
            nextImageSlot = index;
            await JS.InvokeVoidAsync("triggerFileInput");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error opening file dialog: {ex.Message}");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null && nextImageSlot < 3)
        {
            try
            {
                // Leer archivo
                var buffer = new byte[file.Size];
                await using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
                {
                    var totalRead = 0;
                    var remaining = (int)file.Size;
                    while (remaining > 0)
                    {
                        var read = await stream.ReadAsync(buffer, totalRead, remaining);
                        if (read == 0)
                            break;
                        totalRead += read;
                        remaining -= read;
                    }
                }

                // Crear preview en base64
                var base64 = Convert.ToBase64String(buffer);
                var contentType = file.ContentType ?? DetectContentType(file.Name);
                imagePreviews[nextImageSlot] = $"data:{contentType};base64,{base64}";
                imageNames[nextImageSlot] = file.Name;

                // Agregar a lista de nuevas imágenes
                var existingIndex = newImages.FindIndex(x => x.ImageIndex == nextImageSlot);
                if (existingIndex >= 0)
                {
                    newImages[existingIndex] = new Base64ImageData
                    {
                        Base64Data = base64,
                        FileName = file.Name,
                        ContentType = contentType,
                        ImageIndex = nextImageSlot
                    };
                }
                else
                {
                    newImages.Add(new Base64ImageData
                    {
                        Base64Data = base64,
                        FileName = file.Name,
                        ContentType = contentType,
                        ImageIndex = nextImageSlot
                    });
                }

                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando archivo: {ex.Message}");
            }
        }
    }

    private void RemoveImage(int index)
    {
        if (index < 0 || index >= 3)
            return;

        imagePreviews[index] = string.Empty;
        imageNames[index] = string.Empty;

        // Remover de la lista de nuevas imágenes
        var existingIndex = newImages.FindIndex(x => x.ImageIndex == index);
        if (existingIndex >= 0)
        {
            newImages.RemoveAt(existingIndex);
        }

        StateHasChanged();
    }

    private async Task UpdateProducts()
    {
        PreloadService.Show(SpinnerColor.Dark);
        errorMessage = string.Empty;

        try
        {
            int productid = productoLocal.Product_id;

            var updateResult = await service.UpdateProductAsync(productid, productoLocal);
            if (!updateResult.Success)
            {
                errorMessage = updateResult.Message ?? "No se pudo actualizar el producto. Intente de nuevo.";
                PreloadService.Hide();
                return;
            }

            if (newImages.Count > 0)
            {
                var imageErrors = new List<string>();
                for (int i = 0; i < newImages.Count; i++)
                {
                    var success = await service.UpdateProductImageAsync(productid, newImages[i]);
                    if (!success)
                    {
                        imageErrors.Add($"Imagen {i + 1}: {newImages[i].FileName}");
                    }
                }
if (imageErrors.Count > 0)
                {
                    errorMessage = $"Error al guardar algunas im�genes: {string.Join(", ", imageErrors)}";
                }

                foreach (var newImg in newImages)
                {
                    var existingImage = productoLocal.Images?.FirstOrDefault(i => i.ImageIndex == newImg.ImageIndex);
                    if (existingImage != null)
                    {
                        existingImage.FileName = newImg.FileName;
                        existingImage.ContentType = newImg.ContentType;
                    }
                    else
                    {
                        if (productoLocal.Images == null)
                            productoLocal.Images = new List<ProductImage>();
                        productoLocal.Images.Add(new ProductImage
                        {
                            ProductId = productid,
                            FileName = newImg.FileName,
                            ContentType = newImg.ContentType,
                            ImageIndex = newImg.ImageIndex
                        });
                    }
                }
            }

            // Recargar desde el servidor para tener los IDs/imágenes reales
            // y notificar al grid con datos auténticos.
            var refreshed = await service.GetProductByIdAsync(productid);
            var toNotify = refreshed ?? productoLocal;
            await OnProductUpdate.InvokeAsync(toNotify);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al guardar los cambios: {ex.Message}";
            Console.WriteLine($"Error updating product: {ex.Message}");
            Console.WriteLine(ex.StackTrace);
        }

        newImages.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        await modalUpdate.HideAsync();
        PreloadService.Hide();
    }

    public async Task ShowAsync()
    {
        newImages.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        nextImageSlot = 0;

        Console.WriteLine($"ShowAsync called for product {producto?.Product_id}");

        // Verificar si es un producto diferente o si no se ha cargado antes
        if (producto?.Product_id != lastLoadedProductId)
        {
            Console.WriteLine($"New product detected or first load. Loading images for product {producto?.Product_id}");
            await LoadProductImages();
            lastLoadedProductId = producto?.Product_id ?? -1;
        }
        else
        {
            Console.WriteLine($"Same product, reloading images to ensure fresh data: {lastLoadedProductId}");
            await LoadProductImages();
        }

        await modalUpdate.ShowAsync();        
    }

    public async Task ShowAsyncWithProduct(int productId)
    {
        categories = await configService.GetCategoriesAsync();
        units = await configService.GetProductUnitsAsync();
        Console.WriteLine($"ShowAsyncWithProduct called for product ID {productId}");

        // Cargar el producto desde el servidor
        var loadedProduct = await service.GetProductByIdAsync(productId);
        if (loadedProduct == null)
        {
            Console.WriteLine($"ShowAsyncWithProduct: Product {productId} not found");
            return;
        }

        Console.WriteLine($"ShowAsyncWithProduct: Product loaded. Images count: {loadedProduct.Images?.Count ?? 0}");

        // Asignar el producto cargado
        producto = loadedProduct;

        // Crear una copia local para binding del formulario
        productoLocal = new Product
        {
            Product_id = loadedProduct.Product_id,
            Product_Code = loadedProduct.Product_Code,
            Product_Name = loadedProduct.Product_Name,
            Product_Type = loadedProduct.Product_Type,
            Price = loadedProduct.Price,
            Codebar = loadedProduct.Codebar,
            Unidad = loadedProduct.Unidad,
            Costo = loadedProduct.Costo,
            Stock = loadedProduct.Stock,
            Stock_Mix = loadedProduct.Stock_Mix,
            Stock_Max = loadedProduct.Stock_Max,
            StockStatus = loadedProduct.StockStatus,
            Description = loadedProduct.Description,
            Marca = loadedProduct.Marca,
            Model = loadedProduct.Model,
            PartNumber = loadedProduct.PartNumber,
            SkuNumber = loadedProduct.SkuNumber,
            StatusProducts = loadedProduct.StatusProducts,
            Images = loadedProduct.Images != null ? new List<ProductImage>(loadedProduct.Images) : new List<ProductImage>()
        };

        // Forzar refresco UI
        StateHasChanged();

        // Limpiar estado
        newImages.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        nextImageSlot = 0;
        lastLoadedProductId = -1; // Forzar recarga de imágenes

        // Cargar imágenes
        await LoadProductImages();
        lastLoadedProductId = productId;

        // Mostrar modal
        await modalUpdate.ShowAsync();
    }

    private async Task HideAsync()
    {
        newImages.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        await modalUpdate.HideAsync();
    }

    private string DetectContentType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            _ => "image/jpeg" // Default fallback
        };
    }
}
