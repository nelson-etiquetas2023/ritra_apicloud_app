@inject IProductsService service
@inject IJSRuntime JS
@inject IConfigService configService
@using Shared.Dtos

<Preload LoadingText="Guardando..."/>

<Modal @ref="modal" Size="ModalSize.Large" UseStaticBackdrop="true" CloseOnEscape="false" CloseButton="false">
    <HeaderTemplate><Icon Name="IconName.Plus" Size="IconSize.x3" /><strong> Crear producto</strong> </HeaderTemplate>
    <BodyTemplate>

            <EditForm Model="@product" OnValidSubmit="CreateProducts">
                <DataAnnotationsValidator />

            <div class="mb-3">
                <label for="txt_ProductCode"><strong>Coidgo de Producto:</strong> </label>
                <InputText class="form-control" id="txt_ProductCode" @bind-Value=product.Product_Code" />
                <ValidationMessage For="@(() => product.Product_Code)" />
            </div>

                <div class="mb-3">
                    <label for="txt_productname"><strong>Nombre del Producto:</strong> </label>
                    <InputText class="form-control" id="txt_productname" @bind-Value="product.Product_Name" />
                    <ValidationMessage For="@(() => product.Product_Name)" />
                </div>

                <div class="mb-3">
                    <label for="txt_category"><strong>Categoria :</strong></label>
                    <InputSelect class="form-select" id="txt_category" @bind-Value="product.Product_Type">
                        <option value="">Seleccione una categoría...</option>
                        @foreach (var category in categories.Where(c => c.IsActive))
                        {
                            <option value="@category.Name">@category.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => product.Product_Type)" />
                </div>
                <div class="mb-3">
                    <label for="txt_unidad"><strong>Unidad :</strong></label>
                    <InputSelect class="form-select" id="txt_unidad" @bind-Value="product.Unidad">
                        <option value="">Seleccione una unidad...</option>
                        @foreach (var unit in units.Where(u => u.IsActive))
                        {
                            <option value="@unit.Name">@unit.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => product.Unidad)" />
                </div>
                <div class="mb-3">
                    <label for="txt_costo"><strong>Costo :</strong></label>
                    <InputNumber class="form-control" id="txt_costo" @bind-Value="product.Costo" />
                </div>
                <div class="mb-3">
                    <label for="txt_codebar"><strong>Codigo de barra :</strong></label>
                    <InputText class="form-control" id="txt_codebar" @bind-Value="product.Codebar" />
                </div>

                <!-- Sección de Imágenes -->
                <div class="mb-3">
                    <label><strong>📸 Imágenes del Producto (máx 3)</strong></label>
                    <small class="text-muted d-block">
                        Imágenes seleccionadas: <strong>@selectedFiles.Count/3</strong>
                    </small>
                    <p class="text-muted small">Haz clic en una caja vacía para agregar imagen o usa el botón de abajo</p>

                    <div class="row mt-3 mb-3">
                        @for (int i = 0; i < 3; i++)
                        {
                            int currentIndex = i;
                            <div class="col-md-4 mb-3">
                                <div class="image-preview-box clickable-box" @onclick="() => ClickImageBox(currentIndex)">
                                    @if (!string.IsNullOrEmpty(imagePreviews[i]))
                                    {
                                        <div class="image-preview-area">
                                            <img src="@imagePreviews[i]" alt="Preview @(i+1)" class="img-preview" />
                                            <button type="button" class="btn-remove-image" @onclick:stopPropagation @onclick="() => RemoveImage(i)" title="Eliminar imagen">
                                                ✕
                                            </button>
                                        </div>
                                        <div class="image-info">
                                            <small class="text-success">✓ Imagen @(i + 1)</small>
                                            @if (!string.IsNullOrEmpty(imageNames[i]))
                                            {
                                                <div class="text-truncate" title="@imageNames[i]">
                                                    <small>@imageNames[i]</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="image-placeholder">
                                            <div class="placeholder-icon">📷</div>
                                            <div class="placeholder-text">Imagen @(i + 1)</div>
                                            <div class="placeholder-hint">Haz clic para seleccionar</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <InputFile @ref="fileInput" OnChange="OnFileSelected" accept="image/*" hidden />
                    </div>
                </div>

                <div class="mb-3">
                    <Button Type="ButtonType.Submit" Style="background-color:green;color:white" class="btn-save"><Icon Name="IconName.Floppy2Fill" /> Guardar</Button>
                    <Button Style="background-color:black;color:white" @onclick="HideAsync" class="btn-cancel"><Icon Name="IconName.FileTypeDoc" />Cancelar</Button>
                </div>
            </EditForm>
    </BodyTemplate>
</Modal>


@code {

    [Parameter]
    public EventCallback OnProductCreated { get; set; }

    [Inject]
    protected PreloadService PreloadService { get; set; } = default!;

    private Modal modal = default!;
    private InputFile fileInput = default!;
    private Product product = new();
    private List<IBrowserFile> selectedFiles = new();
    private string[] imagePreviews = new string[3];
    private string[] imageNames = new string[3];
    private int nextImageSlot = 0;  // Índice del siguiente slot disponible
    private List<Category> categories = [];
    private List<ProductUnit> units = [];

    private async Task ClickImageBox(int index)
    {
        // Si el card ya tiene imagen, lo eliminamos
        if (!string.IsNullOrEmpty(imagePreviews[index]))
        {
            RemoveImage(index);
        }
        else
        {
            // Si está vacío, abrimos el diálogo de archivos
            nextImageSlot = index;
            await OpenFileDialog();
        }
    }

    private async Task OpenFileDialog()
    {
        try
        {
            if (fileInput != null)
            {
                await JS.InvokeVoidAsync("eval", "document.querySelector('input[type=file]').click()");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file != null && nextImageSlot < 3)
        {
            try
            {
                // Leer archivo
                var buffer = new byte[file.Size];
                using (var stream = file.OpenReadStream(maxAllowedSize: 10_000_000))
                {
                    await stream.ReadAsync(buffer);
                }

                // Crear preview en base64
                var base64 = Convert.ToBase64String(buffer);
                var contentType = file.ContentType ?? DetectContentType(file.Name);
                imagePreviews[nextImageSlot] = $"data:{contentType};base64,{base64}";
                imageNames[nextImageSlot] = file.Name;

                // Agregar a lista de archivos
                if (nextImageSlot >= selectedFiles.Count)
                {
                    selectedFiles.Add(file);
                }
                else
                {
                    selectedFiles[nextImageSlot] = file;
                }

                // Moverse al siguiente slot para la próxima selección
                nextImageSlot++;

                // Si llegamos a 3, mostrar mensaje
                if (nextImageSlot >= 3)
                {
                    nextImageSlot = 2;  // Mantener en el último disponible
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error cargando archivo: {ex.Message}");
            }
        }
    }

    private void RemoveImage(int index)
    {
        // Validar que el índice sea válido
        if (index < 0 || index >= 3)
            return;

        imagePreviews[index] = string.Empty;
        imageNames[index] = string.Empty;

        // Eliminar del archivo seleccionado si existe
        if (index < selectedFiles.Count)
        {
            selectedFiles.RemoveAt(index);
        }

        // Reorganizar archivos para llenar los gaps
        for (int i = index + 1; i < 3; i++)
        {
            if (!string.IsNullOrEmpty(imagePreviews[i]))
            {
                imagePreviews[i - 1] = imagePreviews[i];
                imageNames[i - 1] = imageNames[i];
                imagePreviews[i] = string.Empty;
                imageNames[i] = string.Empty;
            }
        }

        // Recalcular el próximo slot disponible
        nextImageSlot = 0;
        for (int i = 0; i < 3; i++)
        {
            if (string.IsNullOrEmpty(imagePreviews[i]))
            {
                nextImageSlot = i;
                break;
            }
        }
    }

    private async Task CreateProducts()
    {
        PreloadService.Show(SpinnerColor.Dark);

        try
        {
            // Crear request con producto e imágenes (multipart)
            product.Description = "";
            product.Marca = "";
            product.Model = "";
            product.PartNumber = "";
            product.SkuNumber = "";
            //product.SerialStatus = false;
            product.StatusProducts = "";
            product.StockStatus = "";
            // Crear producto con imágenes mediante multipart/form-data
            var createdProduct = await service.CreateProductWithFilesAsync(product, selectedFiles);

            if (createdProduct == null)
            {
                Console.WriteLine("Error al crear el producto - respuesta nula del servidor");
            }
            else
            {
                Console.WriteLine($"Producto creado exitosamente: ID={createdProduct.Product_id}, Imágenes={createdProduct.Images?.Count ?? 0}");
            }

            // Limpiar datos antes de cerrar
            selectedFiles.Clear();
            imagePreviews = new string[3];
            imageNames = new string[3];
            nextImageSlot = 0;

            // Cerrar modal correctamente
            await modal.HideAsync();

            // Esperar un momento para que el modal termine de ocultarse
            await Task.Delay(300);

            // Notificar que el producto fue creado
            await OnProductCreated.InvokeAsync();

            await Task.Delay(500);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error general en CreateProducts: {ex.Message}");
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    private string DetectContentType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLower();
        return extension switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".bmp" => "image/bmp",
            _ => "image/jpeg" // Default fallback
        };
    }

    public async Task ShowAsync()
    {
        categories = await configService.GetCategoriesAsync();
        units = await configService.GetProductUnitsAsync();
        product = new Product();
        product.Product_Name = "";
        product.Product_Type = "";
        product.Price = 0;
        product.Unidad = "";
        product.Codebar = "";
        selectedFiles.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        nextImageSlot = 0;
        await modal.ShowAsync();
    }

    private async Task HideAsync()
    {
        selectedFiles.Clear();
        imagePreviews = new string[3];
        imageNames = new string[3];
        nextImageSlot = 0;
        await modal.HideAsync();
    }
}
