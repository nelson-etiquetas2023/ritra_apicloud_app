    private async Task RegistrarMovimientoAsync()
    {
        if (seleccionado == null) return;

        // Validaciones básicas
        if (string.IsNullOrWhiteSpace(usuarioMovimiento))
        {
            mensajeMovimiento = "El usuario es obligatorio.";
            tipoAlertaMovimiento = "alert-warning";
            return;
        }

        registrandoMovimiento = true;
        mensajeMovimiento = "";
        StateHasChanged();

        try
        {
            var request = new Shared.Dtos.Inventario.RegistroMovimientoRequest
            {
                CodigoProducto = seleccionado.Product_Code,
                NombreProducto = seleccionado.Product_Name,
                Inicial = stockInicial,
                Entradas = stockEntradas,
                Salidas = stockSalidas,
                Motivo = string.IsNullOrWhiteSpace(motivoMovimiento) ? "Ajuste manual" : motivoMovimiento,
                Usuario = usuarioMovimiento,
                Comentario = $"Registro desde Búsqueda Avanzada de Productos - {seleccionado.Product_Code}"
            };

            var ok = await inventarioService.RegistrarMovimientoInventarioAsync(request);

            if (ok)
            {
                mensajeMovimiento = $"Movimiento registrado correctamente. Existencia: {stockExistencia:N2}";
                tipoAlertaMovimiento = "alert-success";
                // Limpiar formulario
                stockInicial = 0;
                stockEntradas = 0;
                stockSalidas = 0;
                stockExistencia = 0;
                usuarioMovimiento = "";
                motivoMovimiento = "Ajuste manual";
                // Refrescar historial y existencia del producto
                await CargarMovimientosAsync();
                var fresh = await productsService.GetProductByIdAsync(seleccionado.Product_id);
                if (fresh != null)
                {
                    seleccionado = fresh;
                    var idx = products?.FindIndex(x => x.Product_id == fresh.Product_id) ?? -1;
                    if (idx >= 0 && products != null) products[idx] = fresh;
                }
                ToastSvc.Notify(new(ToastType.Success, "Movimiento de inventario registrado."));
            }
            else
            {
                mensajeMovimiento = "No se pudo registrar el movimiento. Verifique que el endpoint de la API esté disponible.";
                tipoAlertaMovimiento = "alert-danger";
            }
        }
        catch (Exception ex)
        {
            mensajeMovimiento = $"Error: {ex.Message}";
            tipoAlertaMovimiento = "alert-danger";
        }
        finally
        {
            registrandoMovimiento = false;
            StateHasChanged();
        }
    }

