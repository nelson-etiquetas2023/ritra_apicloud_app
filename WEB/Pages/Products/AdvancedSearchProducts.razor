    private List<UbicacionFake> GetInventarioFake(Product p)
    {
        var seed = Math.Abs(p.Product_id);
        var codigos = new[] { "PS100-T", "A02-15-B", "B07-03-A", "C11-22-C", "PS104-P", "D05-09-B" };
        var n = 2 + (seed % 3);
        var lista = new List<UbicacionFake>();
        for (var i = 0; i < n; i++)
        {
            var cantidad = 5 + ((seed * 13 + i * 29) % 60);
            lista.Add(new UbicacionFake
            {
                Codigo = codigos[(seed + i * 2) % codigos.Length],
                Almacen = ((seed + i) % 2 == 0) ? "Principal" : "Norte",
                Cantidad = cantidad,
                Unidad = p.Unidad,
                Lote = $"LT-{(seed % 90) + 10}-{i + 1}",
                UltimoConteo = DateTime.Today.AddDays(-((seed + i * 3) % 12)).ToString("dd/MM/yyyy"),
                Estado = cantidad > 40 ? "Alto" : cantidad >= 15 ? "Normal" : "Bajo"
            });
        }
        return lista;
    }

