@page "/products"
@implements IDisposable
@inject IProductsService service
@inject IJSRuntime JS
@using WEB.Pages.Products
@using ClosedXML.Excel
@using System.IO
@using System.Text

<ModalCreateProducts @ref="ModalCreate" OnProductCreated="LoadProducts" />
<!--Franja de Titulo y menu -->
<div class="d-flex justify-content-between align-items-center mt-0">
    <div d-flex align-items-center>
        <h2 class="mb-0"><Icon Name="IconName.Box" Size="IconSize.x2" /> Productos</h2>
    </div>
    <button class="btn btn-primary" type="button" @onclick="CreateProducts">
        <Icon Name="IconName.Archive" Size="IconSize.x4" /> Crear Producto</button>
</div>
<!-- Franja de importación masiva -->
<div id="dropZone" class="alert @(isDragOver ? "alert-warning" : "alert-success") d-flex align-items-center justify-content-between position-relative p-2 mt-2 mb-2" 
     style="border: 2px dashed @(isDragOver ? "#ffc107" : "#c3e6cb"); background-color: @(isDragOver ? "#fff3cd" : "#d4edda"); color: #155724; cursor: pointer;"
     @ondragover:preventDefault
     @ondragenter="() => isDragOver = true"
     @ondragleave="() => isDragOver = false">
    
    <div class="d-flex align-items-center">
        <Icon Name="@(isDragOver ? IconName.FileEarmarkCheck : IconName.FileEarmarkArrowUp)" Size="IconSize.x3" class="me-3" />
        <div>
            <strong>@(isDragOver ? "Suelta el archivo aquí" : "Importación masiva de productos")</strong>
            <p class="mb-0 small">Arrastra y suelta tu archivo Excel aquí para importar.</p>
        </div>
    </div>
    <img src="/images/upload-excel.png" alt="Nube de descarga" style="height:44px; position:absolute; left:50%; transform:translateX(-50%);" />
    <div class="d-flex align-items-center gap-2">
        <Button Color="ButtonColor.Link" @onclick="DownloadTemplate"><Icon Name="IconName.FileEarmarkArrowDown" /> Descargar Plantilla</Button>
    </div>
</div>

<Modal @ref="modalImportResult" Title="Resultado de la importación">
    <BodyTemplate>
        <pre style="white-space:pre-wrap;font-family:inherit;margin-bottom:0;">@importResultMessage</pre>
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="CloseImportModal">Cerrar</Button>
    </FooterTemplate>
</Modal>



@if (products == null)
{
    <div class="d-flex justify-content-center align-items-center vh-100 position-fixed top-0 start-0 w-100">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else
{
    <!--buscador-->
    <nav class="navbar navbar-expand-lg navbar-light bg-light px-2 py-1 mt-0">
        <div class="container-fluid d-flex justify-content-between align-items-center p-0">
            <form id="formbusqueda" class="d-flex align-items-center gap-2 w-100" @onsubmit="buscar" @onsubmit:preventDefault>
                <strong class="text-nowrap">buscar por filtro:</strong>
                <div class="d-flex flex-grow-1">
                    <input id="txt_busqueda" type="text" class="form-control me-2" placeholder="Buscar..."
                           @bind-value="searchText"
                           @bind-value:event="oninput" />
                    <Button Type="ButtonType.Submit"
                            class="btn btn-primary">
                        <Icon Name="IconName.Search" />
                    </Button>
                    
                </div>
                <strong class="text-nowrap" style="width: 100px;">@products.Count.ToString() Items.</strong>
            </form>
        </div>
    </nav>
    <!--QuickGrid de Productos-->
    <QuickGridProducts 
        productsFiltered="productsFiltered!.AsQueryable()" 
        pagination="pagination" OnUpdateListProduct="RefreshListProducts" />
}


@code {

    private List<Product>? products;
    IEnumerable<Product>? productsFiltered { get; set; }
    PaginationState pagination = new PaginationState { ItemsPerPage = 18 };
    private string searchText = "";
    ModalCreateProducts ModalCreate { get; set; } = default!;

    private Modal? modalImportResult;
    private string importResultMessage = "";

    [Inject] protected PreloadService PreloadService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            JS.InvokeVoidAsync("initProductDropZone", dotNetRef);
        }
    }

    private void buscar()
    {
        // Lógica para buscar documentos
        if (products == null) return;

        // Filtro vacío => mostrar la lista completa respetando la paginación
        if (string.IsNullOrWhiteSpace(searchText))
        {
            productsFiltered = products;
            StateHasChanged();
            return;
        }

        productsFiltered = products.Where(o =>
            o.Product_Type.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            o.Product_Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            o.Unidad.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            o.Codebar.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        StateHasChanged();
    }

    private async Task LoadProducts()
    {
        products = await service.GetProductAsync();
        productsFiltered = products.AsQueryable();
    }

    private async Task CreateProducts()
    {
        await ModalCreate.ShowAsync();
    } 

    private async void RefreshListProducts(IQueryable<Product> lista)
    {
        if (lista.Count() == 0)
        {
            await LoadProducts();
            return;
        }
        

        products = lista.ToList();
        productsFiltered = lista.AsEnumerable();
        StateHasChanged();
    }
    
    private async Task DownloadTemplate()
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Productos");
        
        worksheet.Cell(1, 1).Value = "product_code*";
        worksheet.Cell(1, 2).Value = "nombre del producto*";
        worksheet.Cell(1, 3).Value = "categoria";
        worksheet.Cell(1, 4).Value = "unidad";
        worksheet.Cell(1, 5).Value = "codigo de barra";
        worksheet.Cell(1, 6).Value = "costo";
        worksheet.Row(1).Style.Font.Bold = true;

        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        var content = stream.ToArray();
        
        // Asumiendo que tienes una función JS 'downloadFile' implementada
        await JS.InvokeVoidAsync("downloadFile", "PlantillaProductos.xlsx", Convert.ToBase64String(content));
    }

    private async Task CloseImportModal()
    {
        if (modalImportResult != null)
        {
            await modalImportResult.HideAsync();
        }
    }

    private bool isDragOver;
    private DotNetObjectReference<Index>? dotNetRef;

    [JSInvokable]
    public async Task OnFileDropped(string fileName, long fileSize, string contentType, string base64Data)
    {
        isDragOver = false;
        if (!IsValidExcelFile(fileName))
        {
            importResultMessage = "El archivo debe ser un Excel (.xlsx o .xls).";
            if (modalImportResult != null)
                await modalImportResult.ShowAsync();
            StateHasChanged();
            return;
        }
        await ProcessFile(new BrowserFile(fileName, fileSize, contentType, base64Data));
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnInvalidFileDropped()
    {
        isDragOver = false;
        importResultMessage = "El archivo debe ser un Excel (.xlsx o .xls).";
        if (modalImportResult != null)
            await modalImportResult.ShowAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
        GC.SuppressFinalize(this);
    }

    private static bool IsValidExcelFile(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension is ".xlsx" or ".xls";
    }

    private async Task ProcessFile(IBrowserFile file)
    {
        if (!IsValidExcelFile(file.Name))
        {
            importResultMessage = "El archivo debe ser un Excel (.xlsx o .xls).";
            if (modalImportResult != null)
                await modalImportResult.ShowAsync();
            return;
        }

        PreloadService.Show(SpinnerColor.Dark, "Importando productos...");

        try
        {
            // El archivo se envía a la API, que lo procesa en lotes (batching + upsert).
            var result = await service.ImportProductsFromExcelAsync(file);

            var sb = new StringBuilder();

            if (!result.Success)
            {
                sb.AppendLine("⚠️ La importación falló y no se guardó ningún cambio.");
            }
            else
            {
                sb.AppendLine("✔️ Importación completada correctamente.");
            }

            sb.AppendLine($"Productos insertados: {result.Inserted}");
            sb.AppendLine($"Productos actualizados: {result.Updated}");
            sb.AppendLine($"Filas omitidas: {result.Skipped}");

            if (result.Errors.Count > 0)
            {
                sb.AppendLine();
                sb.AppendLine($"Errores ({result.Errors.Count}):");
                foreach (var error in result.Errors.Take(50))
                {
                    sb.AppendLine($"  Fila {error.Row}: {error.Message}");
                }
                if (result.Errors.Count > 50)
                {
                    sb.AppendLine($"  ... y {result.Errors.Count - 50} error(es) más.");
                }
            }

            importResultMessage = sb.ToString();

            await LoadProducts(); // Recarga la lista
            StateHasChanged();    // Fuerza refresco de la UI

            if (modalImportResult != null)
            {
                await modalImportResult.ShowAsync();
            }
        }
        catch (Exception ex)
        {
            importResultMessage = $"Error en la importación: {ex.Message}";
            if (modalImportResult != null)
            {
                await modalImportResult.ShowAsync();
            }
        }
        finally
        {
            PreloadService.Hide();
        }
    }

}

