@using Shared.Dtos
@inject IEtiquetasService Etiquetas
@inject ToastService ToastService

<Modal @ref="modal" Title="@titulo" Size="ModalSize.Large">
    <BodyTemplate>
        @if (!string.IsNullOrWhiteSpace(errorMsg))
        {
            <div class="alert alert-danger">@errorMsg</div>
        }
        @if (!string.IsNullOrWhiteSpace(pngUrl))
        {
            <div class="border d-flex align-items-center justify-content-center bg-light overflow-hidden mx-auto mb-1"
                 style="width:@(AnchoPx());max-width:100%;aspect-ratio:@(Ratio());">
                <img src="@pngUrl" class="w-100 h-100" style="object-fit:contain;" alt="Vista previa" />
            </div>
            <div class="text-muted small text-center mb-2">@Inv(actual?.WidthIn ?? 2) x @Inv(actual?.HeightIn ?? 1) in · @(actual?.Dpi ?? 203) dpi (tamaño aprox.)</div>
            <div>
                <Button Size="ButtonSize.Small" Color="ButtonColor.Secondary" @onclick="GuardarMiniatura">Guardar como miniatura</Button>
            </div>
        }
        else if (cargando)
        {
            <p>Generando vista previa...</p>
        }
        @if (!string.IsNullOrWhiteSpace(zpl))
        {
            <strong>ZPL fusionado:</strong>
            <pre class="border p-2 small">@zpl</pre>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="HideAsync">Cerrar</Button>
        <a class="btn btn-info" target="_blank" href="@DesignerUrl()">Abrir en ZPLDesigner</a>
    </FooterTemplate>
</Modal>

@code {
    private Modal modal = default!;
    private string titulo = "Vista previa";
    private string errorMsg = "";
    private string pngUrl = "";
    private string zpl = "";
    private string designerZpl = "";
    private bool cargando = false;
    private LabelTemplate? actual;

    public async Task ShowAsync(LabelTemplate template)
    {
        actual = template;
        titulo = $"Vista previa {template.Codigo}";
        errorMsg = "";
        pngUrl = "";
        zpl = "";
        designerZpl = template.ZplTemplate ?? "";
        cargando = true;
        StateHasChanged();
        await modal.ShowAsync();

        try
        {
            zpl = await Etiquetas.PreviewZplAsync(template.Id, null, null) ?? "";
            designerZpl = string.IsNullOrWhiteSpace(zpl) ? template.ZplTemplate ?? "" : zpl;
            pngUrl = Etiquetas.PreviewPngUrl(template.Id, null, 12);
        }
        catch (Exception ex)
        {
            errorMsg = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    public async Task HideAsync() => await modal.HideAsync();

    private string AspectoPct()
    {
        var w = actual?.WidthIn ?? 2;
        if (w <= 0) return "100%";
        var pct = (actual?.HeightIn ?? 1) / w * 100;
        return pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }

    private static string Inv(double v) =>
        v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string AnchoPx() => $"{Inv((actual?.WidthIn ?? 2) * 96)}px";
    private string Ratio() => $"{Inv(actual?.WidthIn ?? 2)} / {Inv(actual?.HeightIn ?? 1)}";

    private string DesignerUrl()
    {
        var b64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(designerZpl));
        var dpi = actual?.Dpi ?? 203;
        var w = actual?.WidthIn ?? 2;
        var h = actual?.HeightIn ?? 1;
        return $"https://app.zpldesigner.com/?zpl={Uri.EscapeDataString(b64)}&dpi={dpi}&format={w:0.##}x{h:0.##}in";
    }

    private async Task GuardarMiniatura()
    {
        if (actual == null) return;
        try
        {
            using var http = new HttpClient();
            var bytes = await http.GetByteArrayAsync(pngUrl);
            actual.ThumbnailBase64 = $"data:image/png;base64,{Convert.ToBase64String(bytes)}";
            if (await Etiquetas.UpdateTemplateAsync(actual.Id, actual))
                ToastService.Notify(new(ToastType.Success, "Miniatura guardada."));
            else
                ToastService.Notify(new(ToastType.Danger, "No se pudo guardar la miniatura."));
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Miniatura falló: {ex.Message}"));
        }
    }
}
