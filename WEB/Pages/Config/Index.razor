@page "/config"
@inject IConfigService service 
@inject IJSRuntime JS

<Preload LoadingText="Loading data..." />
<Toasts Messages="messages" Class="p-3" AutoHide="true" Delay="1000" Placement="ToastsPlacement.TopRight" />

<h3><Icon Name="IconName.Gear" Style="margin-right:10px;" />Configuración</h3>

<div class="container">
    <div class="row">
        <div class="col-2"></div>
        <div class="col-8">
            <Accordion AlwaysOpen="true" @ref="acordion" Class="mx-5" >
                <AccordionItem>
                    <TitleTemplate>
                        <Icon Name="IconName.FileTypeDoc" Class="me-1" /> Documents Settigs
                    </TitleTemplate>
                    <Content>
                        <form>
                            <div class="mb-3">
                                <label>Numero Consecutivo:</label>
                                <input type="text" @bind="documentSettings.Consec" name="txt_numconsec"  class="form-control fw-bold" />
                            </div>
                            <div class="mb-3">
                                <label>Prefijo:</label>
                                <input type="text" @bind="documentSettings.Prefijo"  name="txt_prefijo" 
                                class="form-control fw-bold" />
                            </div>
                            <div class="mb-3">
                                <label>Caracter:</label>
                                <input type="text" @bind="documentSettings.CharacterSeparator" name="txt_charseparator"
                                       class="form-control fw-bold" />
                            </div>
                            <div class="mb-3">
                                <Switch Value = "documentSettings.useSeparator" Label="Usar Separador" 
                                        ValueExpression="() => documentSettings.useSeparator" ValueChanged="SwitchChanged1" />
                                <Switch value="documentSettings.usePref" Label="Usar Prefijo"
                                        ValueExpression="() => documentSettings.usePref" ValueChanged="SwitchChanged2" />
                            </div>
                            <p class="fw-bold">Ejemplo: @exampleFormat</p>
                            <Tooltip Class="d-inline-block" Title="Guardar los datos..." role="button">
                                <div class="mb-3">
                                    <a @onclick="SaveDocumentSettings"><Icon Name="IconName.Floppy" Size="IconSize.x3" /></a>
                                </div>
                            </Tooltip>
                        </form>
                    </Content>
                </AccordionItem>
                <!--setting codebar-->
                <AccordionItem Title="Codigo de Barras">
                    <Content>
                        <b>This is the first item's accordion body.</b> It is shown by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It's also worth noting that just about any HTML can go within the .accordion-body, though the transition does limit overflow.
                    </Content>
                </AccordionItem>
                <AccordionItem Title="Setting Data">
                    <Content>
                        <b>This is the first item's accordion body.</b> It is shown by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It's also worth noting that just about any HTML can go within the .accordion-body, though the transition does limit overflow.
                    </Content>
                </AccordionItem>
                <AccordionItem Title="Configuración de Categorias">
                    <Content>
                        <b>This is the first item's accordion body.</b> It is shown by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It's also worth noting that just about any HTML can go within the .accordion-body, though the transition does limit overflow.
                    </Content>
                </AccordionItem>
                <AccordionItem Title="Unidades de productos">
                    <Content>
                        <b>This is the first item's accordion body.</b> It is shown by default, until the collapse plugin adds the appropriate classes that we use to style each element. These classes control the overall appearance, as well as the showing and hiding via CSS transitions. You can modify any of this with custom CSS or overriding our default variables. It's also worth noting that just about any HTML can go within the .accordion-body, though the transition does limit overflow.
                    </Content>
                </AccordionItem>
            </Accordion>
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Gestión de categorías de productos</strong>
                    <Button Color="ButtonColor.Primary" @onclick="NewCategory"><Icon Name="IconName.Plus" /> Nueva categoría</Button>
                </div>
                <div class="card-body">
                    <input class="form-control mb-3" placeholder="Buscar categoría..." @bind="categorySearch" @bind:event="oninput" />
                    @if (showCategoryForm)
                    {
                        <EditForm Model="editingCategory" OnValidSubmit="SaveCategory" class="border rounded p-3 mb-3 bg-light">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-5 mb-2"><label class="form-label">Nombre *</label><InputText class="form-control" @bind-Value="editingCategory.Name" /><ValidationMessage For="@(() => editingCategory.Name)" /></div>
                                <div class="col-md-5 mb-2"><label class="form-label">Descripción</label><InputText class="form-control" @bind-Value="editingCategory.Description" /></div>
                                <div class="col-md-2 mb-2 d-flex align-items-end"><Switch @bind-Value="editingCategory.IsActive" Label="Activa" /></div>
                            </div>
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Success">Guardar</Button>
                            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CancelCategory">Cancelar</Button>
                        </EditForm>
                    }
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var category in FilteredCategories)
                            {
                                <tr><td>@category.Name</td><td>@category.Description</td><td><span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">@(category.IsActive ? "Activa" : "Inactiva")</span></td><td class="text-end"><Button Color="ButtonColor.Link" @onclick="() => EditCategory(category)">Editar</Button><Button Color="ButtonColor.Link" @onclick="() => DeleteCategory(category)">Eliminar</Button></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Gestión de unidades de productos</strong>
                    <Button Color="ButtonColor.Primary" @onclick="NewUnit"><Icon Name="IconName.Plus" /> Nueva unidad</Button>
                </div>
                <div class="card-body">
                    <input class="form-control mb-3" placeholder="Buscar unidad..." @bind="unitSearch" @bind:event="oninput" />
                    @if (showUnitForm)
                    {
                        <EditForm Model="editingUnit" OnValidSubmit="SaveUnit" class="border rounded p-3 mb-3 bg-light">
                            <DataAnnotationsValidator />
                            <div class="row">
                                <div class="col-md-5 mb-2"><label class="form-label">Nombre *</label><InputText class="form-control" @bind-Value="editingUnit.Name" /><ValidationMessage For="@(() => editingUnit.Name)" /></div>
                                <div class="col-md-5 mb-2"><label class="form-label">Descripción</label><InputText class="form-control" @bind-Value="editingUnit.Description" /></div>
                                <div class="col-md-2 mb-2 d-flex align-items-end"><Switch @bind-Value="editingUnit.IsActive" Label="Activa" /></div>
                            </div>
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Success">Guardar</Button>
                            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CancelUnit">Cancelar</Button>
                        </EditForm>
                    }
                    <table class="table table-hover align-middle">
                        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
                        <tbody>
                            @foreach (var unit in FilteredUnits)
                            {
                                <tr><td>@unit.Name</td><td>@unit.Description</td><td><span class="badge @(unit.IsActive ? "bg-success" : "bg-secondary")">@(unit.IsActive ? "Activa" : "Inactiva")</span></td><td class="text-end"><Button Color="ButtonColor.Link" @onclick="() => EditUnit(unit)">Editar</Button><Button Color="ButtonColor.Link" @onclick="() => DeleteUnit(unit)">Eliminar</Button></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card mt-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Gestión de ubicaciones</strong>
                    <Button Color="ButtonColor.Primary" @onclick="NewLocation"><Icon Name="IconName.Plus" /> Nueva ubicación</Button>
                </div>
                <div class="card-body">
                    <input class="form-control mb-3" placeholder="Buscar ubicación (código, zona, pasillo, rack, nivel, posición, almacén)..." @bind="locationSearch" @bind:event="oninput" />
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Almacén</th>
                                <th>Código</th>
                                <th>Zona</th>
                                <th>Pasillo</th>
                                <th>Rack</th>
                                <th>Nivel</th>
                                <th>Pos.</th>
                                <th>Capacidad</th>
                                <th>Usado</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var location in FilteredLocations)
                            {
                                <tr>
                                    <td>@location.WarehouseName</td>
                                    <td>@location.Code</td>
                                    <td>@location.Zone</td>
                                    <td>@location.Aisle</td>
                                    <td>@location.Rack</td>
                                    <td>@location.Level</td>
                                    <td>@location.Position</td>
                                    <td>@location.Capacity</td>
                                    <td>@location.CurrentCapacity</td>
                                    <td><span class="badge @(location.IsActive ? "bg-success" : "bg-secondary")">@(location.IsActive ? "Activa" : "Inactiva")</span></td>
                                    <td class="text-end">
                                        <Button Color="ButtonColor.Link" @onclick="() => EditLocation(location)">Editar</Button>
                                        <Button Color="ButtonColor.Link" @onclick="() => ToggleLocation(location)">@(location.IsActive ? "Desactivar" : "Activar")</Button>
                                        <Button Color="ButtonColor.Link" @onclick="() => DeleteLocation(location)">Eliminar</Button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <Modal @ref="locationModal" Size="ModalSize.Large" Title="@(editingLocation.LocationId == 0 ? "Nueva ubicación" : "Editar ubicación")">
                <BodyTemplate>
                    @if (!string.IsNullOrEmpty(locationErrorMessage))
                    {
                        <div class="alert alert-danger py-2" role="alert">@locationErrorMessage</div>
                    }
                    <EditForm Model="editingLocation" OnValidSubmit="SaveLocation">
                        <DataAnnotationsValidator />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Almacén *</label>
                                <InputSelect class="form-select" @bind-Value="editingLocation.WarehouseId">
                                    <option value="0">Seleccione almacén...</option>
                                    @foreach (var warehouse in warehouses)
                                    {
                                        <option value="@warehouse.WarehouseId">@warehouse.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Código *</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Code" />
                                <ValidationMessage For="@(() => editingLocation.Code)" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Código de barras</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Barcode" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Tipo de código</label>
                                <InputText class="form-control" @bind-Value="editingLocation.BarcodeType" placeholder="Code128, Code39, QR..." />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Zona</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Zone" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Pasillo</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Aisle" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Rack</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Rack" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Nivel</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Level" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Posición</label>
                                <InputText class="form-control" @bind-Value="editingLocation.Position" />
                            </div>
                            <div class="col-md-4 mb-2">
                                <label class="form-label">Capacidad máxima</label>
                                <InputNumber class="form-control" @bind-Value="editingLocation.Capacity" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Capacidad usada</label>
                                <InputNumber class="form-control" @bind-Value="editingLocation.CurrentCapacity" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Estado</label>
                                <InputNumber class="form-control" @bind-Value="editingLocation.Status" min="0" max="255" />
                            </div>
                            <div class="col-md-6 mb-2"><Switch @bind-Value="editingLocation.AllowMixedProducts" Label="Permite productos mezclados" /></div>
                            <div class="col-md-6 mb-2"><Switch @bind-Value="editingLocation.IsActive" Label="Activa" /></div>
                        </div>
                        <div class="mt-3">
                            <Button Type="ButtonType.Submit" Color="ButtonColor.Success"><Icon Name="IconName.Floppy2Fill" /> Guardar</Button>
                            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" @onclick="CancelLocation"><Icon Name="IconName.XCircle" /> Cancelar</Button>
                        </div>
                    </EditForm>
                </BodyTemplate>
            </Modal>
            <div class="col-2"></div>
        </div>
    </div>
</div>

@code {
    [Inject] protected PreloadService PreloadService { get; set; } = default!;
    [Inject] protected ToastService toastService { get; set; } = default!;
    List<ToastMessage> messages = new List<ToastMessage>();
    private Accordion acordion = default!;
    List<Parameter> settings = [];
    DocumentSettings documentSettings = new();
    string exampleFormat = "";
    List<Category> categories = [];
    Category editingCategory = new();
    string categorySearch = "";
    bool showCategoryForm;

    List<ProductUnit> units = [];
    ProductUnit editingUnit = new();
    string unitSearch = "";
    bool showUnitForm;

    List<Warehouse> warehouses = [];
    List<Location> locations = [];
    Location editingLocation = new();
    string locationSearch = "";
    string locationErrorMessage = "";
    Modal locationModal = default!;

    IEnumerable<Location> FilteredLocations => locations.Where(l =>
        string.IsNullOrWhiteSpace(locationSearch) ||
        l.Code.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Zone.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Aisle.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Rack.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Level.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Position.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        l.Barcode.Contains(locationSearch, StringComparison.OrdinalIgnoreCase) ||
        (l.WarehouseName ?? string.Empty).Contains(locationSearch, StringComparison.OrdinalIgnoreCase));

    IEnumerable<Category> FilteredCategories => categories.Where(c =>
        string.IsNullOrWhiteSpace(categorySearch) ||
        c.Name.Contains(categorySearch, StringComparison.OrdinalIgnoreCase) ||
        c.Description.Contains(categorySearch, StringComparison.OrdinalIgnoreCase));

    IEnumerable<ProductUnit> FilteredUnits => units.Where(u =>
        string.IsNullOrWhiteSpace(unitSearch) ||
        u.Name.Contains(unitSearch, StringComparison.OrdinalIgnoreCase) ||
        u.Description.Contains(unitSearch, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadDataConfig();
        await LoadCategories();
        await LoadUnits();
        await LoadWarehouses();
        await LoadLocations();
    }

    private async Task LoadCategories() => categories = await service.GetCategoriesAsync();
    private async Task LoadUnits() => units = await service.GetProductUnitsAsync();

    private void NewCategory()
    {
        editingCategory = new Category { IsActive = true };
        showCategoryForm = true;
    }

    private void EditCategory(Category category)
    {
        editingCategory = new Category { Id = category.Id, Name = category.Name, Description = category.Description, IsActive = category.IsActive };
        showCategoryForm = true;
    }

    private async Task SaveCategory()
    {
        var saved = editingCategory.Id == 0
            ? await service.CreateCategoryAsync(editingCategory)
            : await service.UpdateCategoryAsync(editingCategory.Id, editingCategory);

        if (saved == null)
        {
            messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Categorías", Message = "No se pudo guardar. Verifica que el nombre no esté repetido." });
            return;
        }

        await LoadCategories();
        showCategoryForm = false;
        messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Categorías", Message = "Categoría guardada correctamente." });
    }

    private void CancelCategory() => showCategoryForm = false;

    private async Task DeleteCategory(Category category)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la categoría '{category.Name}'?")) return;
        if (await service.DeleteCategoryAsync(category.Id))
        {
            await LoadCategories();
            messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Categorías", Message = "Categoría eliminada." });
        }
    }

    private void NewUnit()
    {
        editingUnit = new ProductUnit { IsActive = true };
        showUnitForm = true;
    }

    private void EditUnit(ProductUnit unit)
    {
        editingUnit = new ProductUnit { Id = unit.Id, Name = unit.Name, Description = unit.Description, IsActive = unit.IsActive };
        showUnitForm = true;
    }

    private async Task SaveUnit()
    {
        var saved = editingUnit.Id == 0
            ? await service.CreateProductUnitAsync(editingUnit)
            : await service.UpdateProductUnitAsync(editingUnit.Id, editingUnit);

        if (saved == null)
        {
            messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Unidades", Message = "No se pudo guardar. Verifica que el nombre no esté repetido." });
            return;
        }

        await LoadUnits();
        showUnitForm = false;
        messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Unidades", Message = "Unidad guardada correctamente." });
    }

    private void CancelUnit() => showUnitForm = false;

    private async Task DeleteUnit(ProductUnit unit)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la unidad '{unit.Name}'?")) return;
        if (await service.DeleteProductUnitAsync(unit.Id))
        {
            await LoadUnits();
            messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Unidades", Message = "Unidad eliminada." });
        }
    }

    private async Task LoadWarehouses() => warehouses = await service.GetWarehousesAsync();

    private async Task LoadLocations() => locations = await service.GetLocationsAsync();

    private async Task NewLocation()
    {
        locationErrorMessage = "";
        editingLocation = new Location { WarehouseId = 0, IsActive = true, Status = 1 };
        await locationModal.ShowAsync();
    }

    private async Task EditLocation(Location location)
    {
        locationErrorMessage = "";
        editingLocation = new Location
        {
            LocationId = location.LocationId,
            WarehouseId = location.WarehouseId,
            Code = location.Code,
            Barcode = location.Barcode,
            BarcodeType = location.BarcodeType,
            Zone = location.Zone,
            Aisle = location.Aisle,
            Rack = location.Rack,
            Level = location.Level,
            Position = location.Position,
            Capacity = location.Capacity,
            CurrentCapacity = location.CurrentCapacity,
            AllowMixedProducts = location.AllowMixedProducts,
            Status = location.Status,
            IsActive = location.IsActive
        };
        await locationModal.ShowAsync();
    }

    private async Task SaveLocation()
    {
        locationErrorMessage = "";
        if (editingLocation.WarehouseId <= 0)
        {
            locationErrorMessage = "Debe seleccionar un almacén.";
            return;
        }

        var saved = editingLocation.LocationId == 0
            ? await service.CreateLocationAsync(editingLocation)
            : await service.UpdateLocationAsync(editingLocation.LocationId, editingLocation);

        if (saved == null)
        {
            locationErrorMessage = "No se pudo guardar. Verifica que el código no esté repetido en el almacén.";
            return;
        }

        await LoadLocations();
        await locationModal.HideAsync();
        messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Ubicaciones", Message = "Ubicación guardada correctamente." });
    }

    private async Task CancelLocation()
    {
        locationErrorMessage = "";
        await locationModal.HideAsync();
    }

    private async Task ToggleLocation(Location location)
    {
        location.IsActive = !location.IsActive;
        var saved = await service.UpdateLocationAsync(location.LocationId, location);
        if (saved == null)
        {
            messages.Add(new ToastMessage { Type = ToastType.Danger, Title = "Ubicaciones", Message = "No se pudo actualizar el estado." });
            return;
        }
        await LoadLocations();
        messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Ubicaciones", Message = "Estado actualizado." });
    }

    private async Task DeleteLocation(Location location)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la ubicación '{location.Code}'?")) return;
        if (await service.DeleteLocationAsync(location.LocationId))
        {
            await LoadLocations();
            messages.Add(new ToastMessage { Type = ToastType.Success, Title = "Ubicaciones", Message = "Ubicación eliminada." });
        }
    }

    private async Task LoadDataConfig()
    {
        settings = await service.LoadDataConfig();
        var document = settings.Where(x => x.Module == "DocumentSetting").FirstOrDefault();
        if (document == null) return;
        //Load DocumentSettings
        documentSettings.Consec = Convert.ToInt32(document.Value1);
        documentSettings.Prefijo = document.Value2;
        documentSettings.useSeparator = Convert.ToBoolean(document.Value3);
        documentSettings.usePref = Convert.ToBoolean(document.Value4);
        documentSettings.CharacterSeparator = document.Value5;
    }

    private async Task SaveDocumentSettings()
    {
        PreloadService.Show(SpinnerColor.Dark, "Guardando los cambios...");
        await Task.Delay(1000); // Simula una carga de datos de 3 segundos
        documentSettings.NumberDocComplete = exampleFormat;
        await service.UpdateDocumentSettings("DocumentSetting", documentSettings);
        PreloadService.Hide();
    }

    private void SwitchChanged1(bool value)
    {
        documentSettings.useSeparator = value;
        FormatChanged();
    }

    private void SwitchChanged2(bool value)
    {
        documentSettings.usePref = value;
        FormatChanged();
    }

    private void FormatChanged()
    {
        if (documentSettings.useSeparator && documentSettings.usePref)
        {
            exampleFormat = documentSettings.Prefijo + documentSettings.CharacterSeparator +
             documentSettings.Consec;
        }
        if (!documentSettings.useSeparator && documentSettings.usePref)
        {
            exampleFormat = documentSettings.Prefijo +
             documentSettings.Consec;
        }
        if (!documentSettings.useSeparator && !documentSettings.usePref)
        {
            exampleFormat = documentSettings.Consec.ToString();
        }
    }
}
