@page "/CargaInicial/nueva"
@inject IInventarioTeoricoService servicio
@inject NavigationManager Navigation
@using WEB.Services.Inventarios
@using Shared.Dtos.Inventarios

<div class="d-flex justify-content-between align-items-center mt-0">
    <h2 class="mb-0"><Icon Name="IconName.FileExcel" Size="IconSize.x2" /> Nuevo Inventario Teórico</h2>
</div>

<p class="text-muted mt-1 mb-2">
    Arrastre el Excel con las columnas esperadas o use la plantilla. El documento queda como
    referencia y no modifica el stock.
</p>

<EditorInventarioTeorico InventarioTeorico="carga"
                    OnSaved="IrIndex"
                    OnCancel="IrIndex" />

@code {

    private InventarioTeorico carga = new()
    {
        Numero = "SIT-0001",
        FechaCreacion = DateTime.Now,
        Detalles = []
    };

    protected override async Task OnInitializedAsync()
    {
        carga.Numero = await servicio.GetNextNumAsync();
    }

    private void IrIndex()
    {
        Navigation.NavigateTo("/CargaInicial");
    }
}