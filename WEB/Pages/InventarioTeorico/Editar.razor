@page "/CargaInicial/editar/{id:int}"
@inject IInventarioTeoricoService servicio
@inject NavigationManager Navigation
@using WEB.Services.Inventarios
@using Shared.Dtos.Inventarios

@if (loading)
{
    <div class="d-flex justify-content-center align-items-center p-5">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mt-0">
        <h2 class="mb-0"><Icon Name="IconName.FileExcel" Size="IconSize.x2" /> Editar Inventario Teórico</h2>
    </div>

    <EditorInventarioTeorico InventarioTeorico="carga"
                        OnSaved="IrIndex"
                        OnCancel="IrIndex" />
}

@code {

    [Parameter] public int Id { get; set; }

    private InventarioTeorico carga = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        carga = await servicio.GetByIdAsync(Id);
        loading = false;
    }

    private void IrIndex()
    {
        Navigation.NavigateTo("/CargaInicial");
    }
}