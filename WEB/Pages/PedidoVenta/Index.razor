@page "/pedidoventa"
@inject ToastService ToastService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IVentasService VentaService
@inject IPickingService PickingService
@using WEB.Pages.PedidoVenta
@using WEB.Services.Picking
@using Microsoft.AspNetCore.Components.QuickGrid

<ModalDetailsPedidoVenta @ref="modalDetails" />
<ModalProcesarPedidoVenta @ref="modalProcesar" OnProcesado="RecargarPedidos" />

<div class="d-flex justify-content-between align-items-center mt-0">
    <h2 class="mb-0"><Icon Name="IconName.Cart4" Size="IconSize.x2" /> Pedido de Venta</h2>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-outline-success" type="button"
                data-testid="btn-enviar-picking"
                disabled="@(selected.Count == 0 || procesando)"
                title="@($"De los {selected.Count} marcados, {seleccionablesCount} se pueden enviar a picking")"
                @onclick="TransferirAPicking">
            <Icon Name="IconName.BoxArrowRight" Size="IconSize.x4" />
            Enviar a Picking (@seleccionablesCount)
            @if (selected.Count != seleccionablesCount)
            {
                <span class="ms-1 small">de @selected.Count marcados</span>
            }
        </button>
        <button class="btn btn-primary" type="button" @onclick="NuevoPV">
            <Icon Name="IconName.Plus" Size="IconSize.x4" /> Nuevo Pedido
        </button>
    </div>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-light px-2 py-1 mt-2">
    <div class="container-fluid d-flex justify-content-between align-items-center p-0">
        <form id="formbusqueda" class="d-flex align-items-center gap-2 w-100" @onsubmit="buscar" @onsubmit:preventDefault>
            <strong class="text-nowrap">buscar por filtro:</strong>
            <div class="d-flex flex-grow-1">
                <input id="txt_busqueda" type="text" class="form-control me-2" placeholder="Buscar por numero, cliente, descripcion o fecha..."
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <Button Type="ButtonType.Submit" class="btn btn-primary">
                    <Icon Name="IconName.Search" />
                </Button>
            </div>
            <button type="button" class="btn btn-sm @(soloParaPicking ? "btn-success" : "btn-outline-secondary")"
                    data-testid="btn-solo-picking"
                    title="Muestra solo los pedidos que se pueden enviar a picking"
                    @onclick="AlternarSoloParaPicking">
                <Icon Name="IconName.Filter" /> Solo para picking (@conteoEnviables)
            </button>
            <strong class="text-nowrap" style="width: 100px;">@PedidosFiltrados.Count() Items.</strong>
        </form>
    </div>
</nav>

@if (Pedidos == null)
{
    <div class="d-flex justify-content-center align-items-center p-5">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else if (!PedidosFiltrados.Any())
{
    <div class="text-center py-5">
        <h6 class="text-muted"><Icon Name="IconName.Inbox" /> No hay documentos</h6>
        <p class="text-muted">Presiona "Nuevo Pedido" para crear el primer pedido de venta.</p>
    </div>
}
else
{
    <QuickGrid @ref="grid" Items="@ItemsGrid" RowClass="@FilaClase" ItemsPerPage="@pageSize" class="table table-hover table-bordered table-striped" Pagination="@paginationIndex" Style="font-size:0.9rem;">
    <TemplateColumn Title="Sel">
        <HeaderTemplate>
            <div class="d-flex flex-column align-items-center gap-1">
                <input type="checkbox"
                       data-testid="sel-todos"
                       checked="@(PedidosFiltrados.Any(p => PuedeTransferirA(p)) && PedidosFiltrados.Where(p => PuedeTransferirA(p)).All(p => selected.Contains(p.Id)))"
                       @onchange="@(e => ToggleSeleccionarTodo((bool)(e.Value ?? false)))" />
                <small class="text-muted" style="font-size:.65rem;">picking</small>
            </div>
        </HeaderTemplate>
        <ChildContent>
            <input type="checkbox"
                   data-testid="sel-pedido"
                   class="@(PuedeTransferirA(context) ? "" : "opacity-50")"
                   checked="@selected.Contains(context.Id)"
                   title="@(PuedeTransferirA(context) ? "Marcar para enviar a picking" : MotivoNoTransferible(context))"
                   @onchange="@(e => ToggleSeleccion(context.Id, (bool)(e.Value ?? false)))" />
        </ChildContent>
    </TemplateColumn>
    <TemplateColumn Title="Numero" Sortable="true">
            <strong>@context.Numero</strong>
        </TemplateColumn>
        <TemplateColumn Title="Fecha" Sortable="true">
            <Icon Name="IconName.CalendarDate" />
            @context.FechaCreacion.ToString("dd-MM-yyyy HH:mm:ss")
        </TemplateColumn>
        <TemplateColumn Title="Entrega" Sortable="true">
            <Icon Name="IconName.CalendarDate" />
            @context.Fecha.ToString("dd-MM-yyyy")
        </TemplateColumn>
        <TemplateColumn Title="Cliente" Sortable="true">
            @context.Cliente_Nombre
        </TemplateColumn>
        <PropertyColumn Property="@(o => o.Description)" Title="Descripcion" Sortable="true" />
        <TemplateColumn Title="Items" Sortable="true">
            <Badge Color="BadgeColor.Info" VisuallyHiddenText="Cantidad de líneas">
                @context.Items.Count
            </Badge>
        </TemplateColumn>
        <TemplateColumn Title="Total">
            <span class="fw-semibold">@context.Total.ToString("N2")</span>
        </TemplateColumn>
        <TemplateColumn Title="Status">
            @if (context.Status == 0)
            {
                <Badge Color="BadgeColor.Info">Planificado</Badge>
            }
            else if (context.Status == 1)
            {
                <Badge Color="BadgeColor.Warning">Modificado</Badge>
            }
            else if (context.Status == 2)
            {
                <Badge Color="BadgeColor.Success">Sincronizado</Badge>
            }
            else if (context.Status == 3)
            {
                <Badge Color="BadgeColor.Secondary">Cerrado</Badge>
            }
            else if (context.Status == 4)
            {
                <Badge Color="BadgeColor.Success">Procesado</Badge>
            }
            else if (context.Status == 5)
            {
                <Badge Color="BadgeColor.Danger">Transacción Fallida</Badge>
            }
            else if (context.Status == 6)
            {
                <Badge Color="BadgeColor.Danger">Anulado</Badge>
            }
            else if (context.Status == PedidoVentaStatus.Picking)
            {
                <Badge Color="BadgeColor.Primary">Picking</Badge>
            }
            else
            {
                <Badge Color="BadgeColor.Secondary">@context.Status</Badge>
            }
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            <div style="white-space:nowrap;">
                @if (context.Status != 4 && context.Status != 5 && context.Status != 6)
                {
                    <Tooltip Title="Actualizar" Placement="TooltipPlacement.Top">
                        <a href="javascript:void(0)" @onclick="() => Editar(context)" style="cursor: pointer">
                            <Icon Name="IconName.PencilFill" Size="IconSize.x5" Color="IconColor.Dark" />
                        </a>
                    </Tooltip>
                    <Tooltip Title="Anular" Placement="TooltipPlacement.Top">
                        <a href="javascript:void(0)" @onclick="() => Anular(context)" style="cursor: pointer; margin-left:10px;">
                            <Icon Name="IconName.XCircle" Size="IconSize.x5" Color="IconColor.Danger" />
                        </a>
                    </Tooltip>
                }
                @if (context.Status == PedidoVentaStatus.Picking)
                {
                    <Tooltip Title="Cancelar Picking" Placement="TooltipPlacement.Top">
                        <a href="javascript:void(0)" @onclick="() => CancelarPicking(context)" style="cursor: pointer; margin-left:10px;">
                            <Icon Name="IconName.XCircleFill" Size="IconSize.x5" Color="IconColor.Warning" />
                        </a>
                    </Tooltip>
                }
            </div>
        </TemplateColumn>
    </QuickGrid>
    <div class="mt-2">
        <GridPaginator State="@paginationIndex" />
    </div>
}

@code {

    private HashSet<int> selected = [];
    private List<PedidoVenta>? Pedidos;
    private string searchText = "";
    private PaginationState paginationIndex = new PaginationState { ItemsPerPage = 15 };
    private int pageSize = 15;
    private QuickGrid<PedidoVenta>? grid;
    private ModalDetailsPedidoVenta modalDetails = default!;
    private ModalProcesarPedidoVenta modalProcesar = default!;

    protected override async Task OnInitializedAsync()
    {
        Pedidos = await VentaService.GetAllAsync();
        await buscar();
    }

    private async Task buscar()
    {
        // La consulta se invalida solo cuando cambia el filtro: QuickGrid
        // vuelve a consultar cada vez que cambia la referencia de Items, y si
        // se crea una nueva en cada render se queda en estado "cargando".
        // No hay que llamar a RefreshDataAsync: el propio cambio de Items
        // hace que el grid vuelva a pedir los datos.
        _items = null;
        await Task.CompletedTask;
    }

    private IQueryable<PedidoVenta>? _items;

    /// <summary>
    /// Origen de datos del grid. Se mantiene la misma referencia entre renders
    /// para que QuickGrid no vuelva a consultar en cada repintado.
    /// Con el filtro activo se ponen primero los pedidos que se pueden enviar:
    /// el numero de pedidos de la pagina no cambia, solo el orden.
    /// </summary>
    private IQueryable<PedidoVenta> ItemsGrid =>
        _items ??= (soloParaPicking
            ? PedidosFiltrados
                .OrderBy(p => PuedeTransferirA(p) ? 0 : 1)
                .ThenByDescending(o => o.Id)
                .AsQueryable()
            : PedidosFiltrados.OrderByDescending(o => o.Id).AsQueryable());

    /// <summary>
    /// pedidos que cumplen el filtro de busqueda y el de solo picking.
    /// </summary>
    private IEnumerable<PedidoVenta> PedidosFiltrados
    {
        get
        {
            IEnumerable<PedidoVenta> filtrados = Pedidos ?? [];

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                filtrados = filtrados.Where(o =>
                    (o.Numero != null && o.Numero.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (o.Cliente_Nombre != null && o.Cliente_Nombre.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (o.Description != null && o.Description.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                    (o.FechaCreacion.ToString("dd-MM-yyyy HH:mm:ss").Contains(searchText, StringComparison.OrdinalIgnoreCase)));
            }

            return filtrados;
        }
    }

    /// <summary>
    /// Con el filtro "Solo para picking" se ocultan las filas que no se pueden
    /// enviar. Se oculta la fila en vez de quitar el pedido de la consulta
    /// porque QuickGrid no recalcula bien el DOM cuando cambia el numero de
    /// elementos de la pagina.
    /// </summary>
    private string FilaClase(PedidoVenta pedido) =>
        soloParaPicking && !PuedeTransferirA(pedido) ? "d-none" : "";

    private ValueTask<ItemsProviderResult<PedidoVenta>> ProveerPedidos(GridItemsProviderRequest<PedidoVenta> request)
    {
        var consulta = PedidosFiltrados.OrderByDescending(o => o.Id).AsQueryable();
        var total = consulta.Count();
        var items = consulta
            .Skip(request.StartIndex)
            .Take(request.Count ?? pageSize)
            .ToList();

        return ValueTask.FromResult(new ItemsProviderResult<PedidoVenta>(items, total));
    }

    private void NuevoPV()
    {
        Navigation.NavigateTo("/pedidoventa/nueva");
    }

    private void ToggleSeleccion(int id, bool on)
    {
        // No se bloquea la casilla: Blazor solo reescribe el atributo cuando el
        // valor cambia, asi que impedir la seleccion dejaba el checkbox
        // marcado en el DOM sin estar en el conjunto. Se marca siempre y el
        // boton indica cuantos son realmente enviables.
        if (on) selected.Add(id); else selected.Remove(id);
        StateHasChanged();
    }

    /// <summary>
    /// Solo los pedidos planificados o modificados pueden enviarse a picking.
    /// </summary>
    private static bool PuedeTransferirA(PedidoVenta pedido) =>
        pedido.Status != PedidoVentaStatus.Procesado &&
        pedido.Status != PedidoVentaStatus.Anulado &&
        pedido.Status != PedidoVentaStatus.Picking;

    private static string MotivoNoTransferible(PedidoVenta pedido) => pedido.Status switch
    {
        PedidoVentaStatus.Procesado => $"El pedido {pedido.Numero} ya fue procesado y no se puede enviar a picking.",
        PedidoVentaStatus.Anulado => $"El pedido {pedido.Numero} está anulado y no se puede enviar a picking.",
        PedidoVentaStatus.Picking => $"El pedido {pedido.Numero} ya está en picking.",
        _ => $"El pedido {pedido.Numero} no se puede enviar a picking en su estado actual."
    };

    /// <summary>Cantidad de pedidos seleccionados que realmente se pueden enviar.</summary>
    private int seleccionablesCount =>
        Pedidos?.Count(p => selected.Contains(p.Id) && PuedeTransferirA(p)) ?? 0;

    /// <summary>Cantidad de pedidos de la lista que se pueden enviar a picking.</summary>
    private int conteoEnviables =>
        Pedidos?.Count(p => PuedeTransferirA(p)) ?? 0;

    private bool soloParaPicking;

    private void AlternarSoloParaPicking()
    {
        // Se reordena la consulta: los pedidos enviables pasan a la primera
        // pagina. El numero de pedidos no cambia, por eso el grid no deja
        // filas en blanco.
        soloParaPicking = !soloParaPicking;
        _items = null;
        StateHasChanged();
    }

    private void ToggleSeleccionarTodo(bool on)
    {
        foreach (var p in PedidosFiltrados)
        {
            if (on) selected.Add(p.Id); else selected.Remove(p.Id);
        }
        StateHasChanged();
    }

    private bool procesando = false;

    private async Task TransferirAPicking()
    {
        if (selected.Count == 0 || Pedidos is null) return;

        var aTransferir = Pedidos.Where(p => selected.Contains(p.Id)).ToList();
        if (aTransferir.Count == 0) { ToastService.Notify(new(ToastType.Warning, "No hay pedidos válidos para transferir.")); return; }

        // Se descartan los que no son transferibles para avisar al usuario
        // en vez de mandar al servidor un lote que va a ser rechazado entero.
        var validos = aTransferir.Where(PuedeTransferirA).ToList();
        var descartados = aTransferir.Where(p => !PuedeTransferirA(p)).ToList();

        if (validos.Count == 0)
        {
            ToastService.Notify(new(ToastType.Warning,
                $"Ninguno de los {descartados.Count} pedidos marcados se puede enviar a picking: {MotivoNoTransferible(descartados[0])}"));
            return;
        }

        procesando = true;
        StateHasChanged();

        try
        {
            var numeros = validos.Select(p => p.Numero).ToList();
            var result = await PickingService.TransferirAPickingAsync(numeros, null);

            if (result.Success)
            {
                ToastService.Notify(new(ToastType.Success, result.Message));

                if (descartados.Count > 0)
                {
                    ToastService.Notify(new(ToastType.Warning,
                        $"No se enviaron a picking ({descartados.Count}): {MotivoNoTransferible(descartados[0])}"));
                }
            }
            else
            {
                ToastService.Notify(new(ToastType.Danger, result.Message));
            }
        }
        catch (Exception ex)
        {
            ToastService.Notify(new(ToastType.Danger, $"Error al transferir a picking: {ex.Message}"));
        }
        finally
        {
            procesando = false;
        }

        selected.Clear();
        Pedidos = await VentaService.GetAllAsync();
        await buscar();
    }

    private async Task CancelarPicking(PedidoVenta pv)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Deseas sacar el pedido {pv.Numero} de picking? El dispositivo dejará de traerlo en la próxima sincronización.");
        if (!confirm) return;

        var result = await PickingService.CancelarPickingAsync(pv.Numero);

        if (result.Success)
        {
            ToastService.Notify(new(ToastType.Success, result.Message));
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, result.Message));
        }

        selected.Clear();
        Pedidos = await VentaService.GetAllAsync();
        await buscar();
    }

    private void Editar(PedidoVenta pv)
    {
        Navigation.NavigateTo($"/pedidoventa/editar/{pv.Id}");
    }

    private async Task ShowDetails(PedidoVenta pv)
    {
        await modalDetails.ShowAsync(pv);
    }

    private async Task Procesar(PedidoVenta pv)
    {
        await modalProcesar.ShowAsync(pv);
    }

    private async Task RecargarPedidos()
    {
        selected.Clear();
        Pedidos = await VentaService.GetAllAsync();
        await buscar();
    }

    private async Task Eliminar(PedidoVenta pv)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas eliminar el pedido {pv.Numero}? Esta acción no se puede deshacer.");
        if (!confirm) return;

        var ok = await VentaService.DeleteAsync(pv.Id);
        if (ok)
        {
            Pedidos?.Remove(pv);
            ToastService.Notify(new(ToastType.Success, $"Pedido {pv.Numero} eliminado."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, $"No se pudo eliminar el pedido {pv.Numero}."));
        }
        await buscar();
    }

    private async Task Anular(PedidoVenta pv)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm",
            $"¿Estás seguro de que deseas anular el pedido {pv.Numero}? Esta acción no se puede deshacer.");
        if (!confirm) return;

        var ok = await VentaService.AnularAsync(pv.Id);
        if (ok)
        {
            pv.Status = 6;
            ToastService.Notify(new(ToastType.Success, $"Pedido {pv.Numero} anulado."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, $"No se pudo anular el pedido {pv.Numero}."));
        }
        await buscar();
    }
}



