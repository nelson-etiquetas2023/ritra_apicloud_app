@inject ISuppliersService service
@inject ToastService ToastService
@using Shared.Dtos

<Preload LoadingText="Guardando..." />

<Modal @ref="modal" Size="ModalSize.Large" UseStaticBackdrop="true" CloseOnEscape="false" CloseButton="false">
    <HeaderTemplate><Icon Name="IconName.PersonPlus" Size="IconSize.x3" /><strong> Crear Proveedor</strong> </HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="@supplier" OnValidSubmit="CreateSupplier">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty" aria-label="Close"></button>
                </div>
            }

            <div class="mb-3">
                <label for="txt_suppliercode"><strong>Código del Proveedor :</strong></label>
                <input class="form-control" id="txt_suppliercode" value="@supplier.SupplierCode" readonly
                       placeholder="Se asignará automáticamente (P######)" />
            </div>

            <div class="mb-3">
                <label for="txt_suppliername"><strong>Nombre del Proveedor :</strong> </label>
                <InputText class="form-control" id="txt_suppliername" @bind-Value="supplier.SupplierName" />
                <ValidationMessage For="@(() => supplier.SupplierName)" />
            </div>

            <div class="mb-3">
                <label for="txt_address"><strong>Dirección :</strong> </label>
                <InputText class="form-control" id="txt_address" @bind-Value="supplier.Address" />
            </div>

            <div class="mb-3">
                <label for="txt_ruc"><strong>RNC :</strong></label>
                <InputText class="form-control" id="txt_ruc" @bind-Value="supplier.Ruc" />
            </div>

            <div class="mb-3">
                <label for="txt_contact"><strong>Persona de Contacto :</strong></label>
                <InputText class="form-control" id="txt_contact" @bind-Value="supplier.ContactName" />
            </div>

            <div class="mb-3">
                <label for="txt_phone"><strong>Teléfono :</strong></label>
                <InputText class="form-control" id="txt_phone" @bind-Value="supplier.Phone" />
            </div>

            <div class="mb-3">
                <label for="txt_email"><strong>Email :</strong></label>
                <InputText class="form-control" id="txt_email" @bind-Value="supplier.Email" />
            </div>

            <div class="mb-3">
                <Button Type="ButtonType.Submit" Style="background-color:green;color:white" class="btn-save"><Icon Name="IconName.Floppy2Fill" /> Guardar</Button>
                <Button Style="background-color:black;color:white" @onclick="HideAsync" class="btn-cancel"><Icon Name="IconName.FileTypeDoc" />Cancelar</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

@code {

    [Parameter]
    public EventCallback OnSupplierCreated { get; set; }

    [Inject]
    protected PreloadService PreloadService { get; set; } = default!;

    private Modal modal = default!;
    private Supplier supplier = new();
    private string errorMessage = string.Empty;

    private async Task CreateSupplier()
    {
        PreloadService.Show(SpinnerColor.Dark);
        errorMessage = string.Empty;

        try
        {
            var success = await service.CreateSupplierAsync(supplier);
            if (!success)
            {
                errorMessage = "No se pudo crear el proveedor. Verifique que el RUC no esté registrado o intente de nuevo.";
                PreloadService.Hide();
                return;
            }

            ToastService.Notify(new(ToastType.Success, $"Proveedor {supplier.SupplierCode} creado correctamente."));
            supplier = new Supplier();
            await modal.HideAsync();
            await Task.Delay(300);
            await OnSupplierCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Error general en CreateSupplier: {ex.Message}");
        }
        finally
        {
            PreloadService.Hide();
        }
    }

    public async Task ShowAsync()
    {
        supplier = new Supplier { IsActive = true };
        errorMessage = string.Empty;
        supplier.SupplierCode = await service.GetNextNumAsync();

        // Respaldo: si el endpoint de numeracion no esta disponible,
        // se calcula con la lista actual (el API revalida el codigo al guardar).
        if (string.IsNullOrWhiteSpace(supplier.SupplierCode))
        {
            var proveedores = await service.GetSuppliersAsync();
            var max = 0;
            foreach (var p in proveedores)
            {
                var match = System.Text.RegularExpressions.Regex.Match(p.SupplierCode ?? "", @"P(\d+)$");
                if (match.Success && int.TryParse(match.Groups[1].Value, out var n) && n > max)
                    max = n;
            }
            supplier.SupplierCode = $"P{max + 1:D6}";
        }

        await modal.ShowAsync();
    }

    private async Task HideAsync()
    {
        supplier = new Supplier();
        errorMessage = string.Empty;
        await modal.HideAsync();
    }
}