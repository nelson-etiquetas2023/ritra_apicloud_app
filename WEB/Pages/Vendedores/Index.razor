@page "/vendedores"
@inject ToastService ToastService
@inject IJSRuntime JS
@inject IVendedoresService service
@using WEB.Services.Vendedores
@using Shared.Dtos

<ModalCreateVendedor @ref="modalCreate" OnVendedorCreated="LoadVendedores" />
<ModalUpdateVendedor @ref="modalUpdate" OnVendedorUpdate="ActualizarLista" />
<ConfirmDialog @ref="dialog" />

<div class="d-flex justify-content-between align-items-center mt-0">
    <h2 class="mb-0"><Icon Name="IconName.PersonBadge" Size="IconSize.x2" /> Vendedores</h2>
    <button class="btn btn-primary" type="button" @onclick="CrearVendedor">
        <Icon Name="IconName.Plus" Size="IconSize.x4" /> Nuevo Vendedor
    </button>
</div>

<nav class="navbar navbar-expand-lg navbar-light bg-light px-2 py-1 mt-2">
    <div class="container-fluid d-flex justify-content-between align-items-center p-0">
        <form id="formbusqueda" class="d-flex align-items-center gap-2 w-100" @onsubmit="buscar" @onsubmit:preventDefault>
            <strong class="text-nowrap">buscar por filtro:</strong>
            <div class="d-flex flex-grow-1">
                <input id="txt_busqueda" type="text" class="form-control me-2" placeholder="Buscar por codigo, nombre, telefono o email..."
                       @bind-value="searchText"
                       @bind-value:event="oninput" />
                <Button Type="ButtonType.Submit" class="btn btn-primary">
                    <Icon Name="IconName.Search" />
                </Button>
            </div>
            <strong class="text-nowrap" style="width: 100px;">@vendedoresFiltered?.Count().ToString() Items.</strong>
        </form>
    </div>
</nav>

@if (vendedores == null)
{
    <div class="d-flex justify-content-center align-items-center p-5">
        <Spinner Size="SpinnerSize.Large" /> <strong style="margin-left:10px;"> Cargando datos...</strong>
    </div>
}
else if (!vendedoresFiltered!.Any())
{
    <div class="text-center py-5">
        <h6 class="text-muted"><Icon Name="IconName.Inbox" /> No hay vendedores</h6>
        <p class="text-muted">Presiona "Nuevo Vendedor" para crear el primero.</p>
    </div>
}
else
{
    <QuickGrid Items="@vendedoresFiltered!.AsQueryable()" ItemsPerPage="@pageSize" Pagination="@pagination"
               class="table table-hover table-bordered table-striped mt-2" Style="font-size:0.9rem;">
        <TemplateColumn Title="Codigo" Sortable="true">
            <strong>@context.vendedor_code</strong>
        </TemplateColumn>
        <TemplateColumn Title="Nombre" Sortable="true">
            <div style="min-width:280px;">@context.vendedor_name</div>
        </TemplateColumn>
        <TemplateColumn Title="Telefono">
            <div style="white-space:nowrap;">@context.telefono</div>
        </TemplateColumn>
        <PropertyColumn Property="@(v => v.email)" Title="Email" Sortable="true" />
        <TemplateColumn Title="Acciones">
            <div style="white-space:nowrap;">
                <Tooltip Title="Actualizar" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => Editar(context)" style="cursor: pointer">
                        <Icon Name="IconName.PencilFill" Size="IconSize.x5" Color="IconColor.Dark" />
                    </a>
                </Tooltip>
                <Tooltip Title="Eliminar" Placement="TooltipPlacement.Top">
                    <a href="javascript:void(0)" @onclick="() => Eliminar(context)" style="cursor: pointer; margin-left:10px;">
                        <Icon Name="IconName.TrashFill" Size="IconSize.x5" Color="IconColor.Danger" />
                    </a>
                </Tooltip>
            </div>
        </TemplateColumn>
    </QuickGrid>
    <div class="mt-2">
        <Paginator State="@pagination" />
    </div>
}

@code {

    private List<Vendedor>? vendedores;
    private IEnumerable<Vendedor>? vendedoresFiltered;
    private string searchText = "";
    private PaginationState pagination = new PaginationState { ItemsPerPage = 15 };
    private int pageSize = 15;
    private ModalCreateVendedor modalCreate = default!;
    private ModalUpdateVendedor modalUpdate = default!;
    private ConfirmDialog dialog = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadVendedores();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            JS.InvokeVoidAsync("PreventEnterKey", "formbusqueda");
    }

    private async Task LoadVendedores()
    {
        vendedores = await service.GetVendedoresAsync();
        buscar();
    }

    private void buscar()
    {
        if (vendedores == null) return;

        if (string.IsNullOrWhiteSpace(searchText))
        {
            vendedoresFiltered = vendedores.OrderBy(v => v.vendedor_name);
        }
        else
        {
            vendedoresFiltered = vendedores.Where(v =>
                (v.vendedor_code != null && v.vendedor_code.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (v.vendedor_name != null && v.vendedor_name.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (v.telefono != null && v.telefono.Contains(searchText, StringComparison.OrdinalIgnoreCase)) ||
                (v.email != null && v.email.Contains(searchText, StringComparison.OrdinalIgnoreCase)))
                .OrderBy(v => v.vendedor_name);
        }
        StateHasChanged();
    }

    private async Task CrearVendedor()
    {
        await modalCreate.ShowAsync();
    }

    private async Task Editar(Vendedor vendedor)
    {
        await modalUpdate.ShowAsyncWithId(vendedor.vendedor_id);
    }

    private async Task ActualizarLista(Vendedor vendedorActualizado)
    {
        if (vendedores != null)
        {
            var index = vendedores.FindIndex(v => v.vendedor_id == vendedorActualizado.vendedor_id);
            if (index >= 0)
                vendedores[index] = vendedorActualizado;
        }
        buscar();
    }

    private async Task Eliminar(Vendedor vendedor)
    {
        var confirm = await dialog.ShowAsync(title: "¿Está seguro de borrar este vendedor?",
            message1: "Este registro se borrará. Una vez borrado no podrá revertirlo.",
            message2: "¿Está seguro de proceder?");

        if (!confirm) return;

        var ok = await service.DeleteVendedorAsync(vendedor.vendedor_id);
        if (ok)
        {
            vendedores?.Remove(vendedor);
            ToastService.Notify(new(ToastType.Success, $"Vendedor {vendedor.vendedor_code} eliminado."));
        }
        else
        {
            ToastService.Notify(new(ToastType.Danger, $"No se pudo eliminar el vendedor {vendedor.vendedor_code}."));
        }
        buscar();
    }
}
