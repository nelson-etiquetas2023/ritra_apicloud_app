/* Estilos para la sección de imágenes en el modal de crear productos */

.image-preview-box {
    border: 2px solid #e0e0e0;
    border-radius: 8px;
    padding: 0;
    background-color: #fff;
    overflow: hidden;
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.image-preview-box:hover {
    border-color: #667eea;
    box-shadow: 0 4px 8px rgba(102, 126, 234, 0.15);
}

.clickable-box {
    cursor: pointer;
}

.clickable-box:hover {
    border-color: #667eea;
    box-shadow: 0 6px 12px rgba(102, 126, 234, 0.25);
    transform: translateY(-2px);
}

.image-preview-area {
    position: relative;
    width: 100%;
    height: 220px;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.img-preview {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    width: auto;
    height: auto;
}

.btn-remove-image {
    position: absolute;
    top: 5px;
    right: 5px;
    background-color: #dc3545;
    color: white;
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.2s ease;
    padding: 0;
    z-index: 10;
}

.btn-remove-image:hover {
    background-color: #c82333;
    transform: scale(1.1);
}

.image-placeholder {
    width: 100%;
    height: 220px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    color: #999;
    gap: 8px;
    transition: all 0.3s ease;
}

.clickable-box:hover .image-placeholder {
    background: linear-gradient(135deg, #e8ecf1 0%, #b3c5d9 100%);
    color: #667eea;
}

.placeholder-icon {
    font-size: 32px;
    transition: all 0.3s ease;
}

.clickable-box:hover .placeholder-icon {
    font-size: 40px;
    transform: scale(1.1);
}

.placeholder-text {
    font-size: 14px;
    font-weight: 600;
    color: #666;
}

.placeholder-hint {
    font-size: 12px;
    color: #999;
    font-style: italic;
    transition: all 0.3s ease;
}

.clickable-box:hover .placeholder-hint {
    color: #667eea;
}

.image-info {
    padding: 10px 12px;
    background-color: #f8f9fa;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
}

.image-info .text-success {
    color: #28a745 !important;
    font-weight: 600;
}

.image-info small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Botón para seleccionar imágenes */
.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    font-weight: 600;
    padding: 10px 20px;
    transition: all 0.3s ease;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    transform: translateY(-2px);
}

.btn-primary:active {
    transform: translateY(0);
}

/* Contador de imágenes */
.image-counter {
    display: inline-block;
    background-color: #667eea;
    color: white;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 12px;
}

/* Grid responsivo */
@media (max-width: 768px) {
    .image-preview-area {
        height: 180px;
    }

    .image-placeholder {
        height: 180px;
    }

    .placeholder-icon {
        font-size: 24px;
    }

    .placeholder-text {
        font-size: 12px;
    }

    .clickable-box:hover .placeholder-icon {
        font-size: 32px;
    }
}

@media (max-width: 576px) {
    .image-preview-area {
        height: 150px;
    }

    .image-placeholder {
        height: 150px;
    }

    .placeholder-icon {
        font-size: 20px;
    }

    .clickable-box:hover .placeholder-icon {
        font-size: 28px;
    }
}
