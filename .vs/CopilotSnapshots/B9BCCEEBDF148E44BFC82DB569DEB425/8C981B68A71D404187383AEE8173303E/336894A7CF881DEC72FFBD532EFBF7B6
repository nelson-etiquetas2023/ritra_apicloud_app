@inject IProductsService service;
@inject NavigationManager navigator;
@inject IJSRuntime JS
@inject IHttpClientFactory HttpClientFactory
@using Shared.Dtos

<Preload LoadingText="Guardando..."/>

<Modal @ref="modalUpdate">
    <HeaderTemplate><Icon Name="IconName.DatabaseSlash" Size="IconSize.x3" />
        <strong>Modificar Proucto.</strong></HeaderTemplate>
    <BodyTemplate>
        <EditForm Model="producto" OnValidSubmit="UpdateProducts">
            <DataAnnotationsValidator/>
            <div class="mb-3">
                <label for="txt_product_name"><strong>Nombre del Producto :</strong></label>
                <InputText class="form-control" id="txt_product_name" @bind-Value="producto.Product_Name" />
                <ValidationMessage For="@(() => producto.Product_Name)"/>
            </div>
            <div class="mb-3">
                <label for="txt_category"><strong>Categoria :</strong></label>
                <InputText class="form-control" id="txt_category" @bind-Value="producto.Product_Type" />
                <ValidationMessage For="@(() => producto.Product_Type)" />
            </div>
            <div class="mb-3">
                <label for="txt_unidad"><strong>Unidad :</strong></label>
                <InputText class="form-control" id="txt_unidad" @bind-Value="producto.Unidad" />
                <ValidationMessage For="@(() => producto.Unidad)" />
            </div>
            <div class="mb-3">
                <label for="txt_price"><strong>Precio :</strong></label>
                <InputNumber class="form-control" id="txt_price" @bind-Value="producto.Price" />
            </div>
            <div class="mb-3">
                <label for="txt_codebar"><strong>Codigo de Barra :</strong></label>
                <InputText class="form-control" id="txt_codebar" @bind-Value="producto.Codebar" />
            </div>
            <div class="form-check mb-5 mt-5">
                <InputCheckbox @bind-Value="producto.Desactivado" class="form-check-input" id="checkActivate" />
                <label class="form-check-label" for="checkActivate">
                    Desactivar producto
                </label>
            </div>

            <!-- Sección de Imágenes -->
            <div class="mb-3">
                <label><strong>📸 Imágenes del Producto</strong></label>
                <p class="text-muted small">Haz clic en una imagen para reemplazarla o deja vacía para mantenerla</p>

                <div class="row mt-3 mb-3">
                    @for (int i = 0; i < 3; i++)
                    {
                        int currentIndex = i;
                        <div class="col-md-4 mb-3">
                            <div class="image-edit-box">
                                @if (!string.IsNullOrEmpty(imagePreviews[i]))
                                {
                                    <div class="image-preview-area">
                                        <img src="@imagePreviews[i]" alt="Preview @(i+1)" class="img-preview-edit" />
                                        <button type="button" class="btn-remove-image-edit" @onclick:stopPropagation @onclick="() => RemoveImage(i)" title="Eliminar imagen">
                                            ✕
                                        </button>
                                    </div>
                                    <div class="image-info-edit">
                                        <small class="text-success">✓ Imagen @(i + 1)</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="image-placeholder-edit">
                                        <div class="placeholder-icon-edit">📷</div>
                                        <div class="placeholder-text-edit">Imagen @(i + 1)</div>
                                        <div class="placeholder-hint-edit">Haz clic para cambiar</div>
                                    </div>
                                }
                                <button type="button" class="btn btn-sm btn-outline-primary mt-2 w-100" @onclick="() => OpenFileDialog(currentIndex)">
                                    Cambiar
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <InputFile @ref="fileInput" OnChange="OnFileSelected" accept="image/*" hidden />
            </div>

            <div class="mb-3">
                <Button Type="ButtonType.Submit" style="background-color:limegreen"><Icon Name="IconName.Floppy2Fill" /> Guardar</Button>
                <Button Style="background-color:black;color:white" @onclick="HideAsync"><Icon Name="IconName.FileTypeDoc" />Cancelar</Button>
            </div>
        </EditForm>
    </BodyTemplate>
</Modal>

@code {

    private Modal modalUpdate = default!;

    [Parameter]
    public Product producto { get; set; } = new Product();

    [Parameter]
    public EventCallback<Product> OnProductUpdate { get; set; }

    [Inject]
    protected PreloadService PreloadService { get; set; } = default!;

    private async void UpdateProducts()
    {
        PreloadService.Show(SpinnerColor.Dark);
        int productid = producto.Product_id;
        await service.UpdateProductAsync(productid, producto);
        await OnProductUpdate.InvokeAsync(producto);
        await modalUpdate.HideAsync();
        await Task.Delay(1000);
        PreloadService.Hide();
        navigator.NavigateTo("/products");
    }

    public async Task ShowAsync()
    {
        await modalUpdate.ShowAsync();        
    }

    private async Task HideAsync()
    {
        await modalUpdate.HideAsync();

    }   
}
