@using WEB.Pages.Products
@inject IProductsService service

<ConfirmDialog @ref="dialog" />

<ModalUpdateProducts @ref="modalUpdate" 
    producto=@productEdit 
    OnProductUpdate="ActualizarLista" />
<div>
    <QuickGrid Items="productsFiltered" 
            class="table table-hover table-bordered table-striped" ItemsPerPage="@pageSize" Pagination="@pagination" style="margin-top:15px;">
        <PropertyColumn Property="@(products => products.Product_id)" Title="Product Id" />
        <PropertyColumn Property="@(products => products.Product_Name)" Title="Nombre del Producto" Sortable="true" />
        <PropertyColumn Property="@(products => products.Product_Type)" Title="Categoria" />
        <PropertyColumn Property="@(products => products.Unidad)" Title="Unidad" />
        <PropertyColumn Property="@(products => products.Price)" Title="Precio" />
        <PropertyColumn Property="@(products => products.Codebar)" Title="Codigo de Barra" />
        <!--Columna de Herramientas o Action-->
        <TemplateColumn Title="Acciones" Context="item">
            <Tooltip Title="Editar Documento" Placement="TooltipPlacement.Top">
                <a @onclick="() => EditProducts(item)" style="cursor: pointer;">
                    <Icon Name="IconName.PencilFill" Size="IconSize.x5" Color="IconColor.Dark" />
                </a>
            </Tooltip>
            <Tooltip Title="Eliminar fila" Placement="TooltipPlacement.Top">
                <a @onclick="() => DeleteProducts(item.Product_id)" style="cursor: pointer"><Icon Name="IconName.XLg" Size="IconSize.x5" Color="IconColor.Dark" /></a>
            </Tooltip>
            <Tooltip Title="Imprimir Etiqueta" Placement="TooltipPlacement.Top">
                <a @onclick="() => PrintLabels(item)" style="cursor: pointer"><Icon Name="IconName.UpcScan" Size="IconSize.x5" Color="IconColor.Dark" /></a>
            </Tooltip>
        </TemplateColumn>
    </QuickGrid>
</div>
<div class="mt-2">
    <Paginator State="@pagination" />
</div>

@code {

    public Product productEdit = new();
    ModalUpdateProducts modalUpdate { get; set; } = default!;

    [Parameter]
    public IQueryable<Product>? productsFiltered { get; set; }

    [Parameter]
    public PaginationState? pagination { get; set; }
    public int pageSize { get; set; } = 18;

    [Parameter]
    public EventCallback<IQueryable<Product>> OnUpdateListProduct { get; set; }


    private ConfirmDialog dialog = default!;

    private async Task EditProducts(Product product)
    {
        productEdit = product;
        await modalUpdate.ShowAsync();
        await OnUpdateListProduct.InvokeAsync(productsFiltered);
    }

    private async Task DeleteProducts(int id)
    {
        var ConfirmationDeleteProducts = await 
            dialog.ShowAsync(title:"Esta seguro de borra este producto?",
            message1:"Este registro se borrara. Una vez borrado no podra revertirlo!",
            message2: "Esta seguro de proceder ?");

        if (ConfirmationDeleteProducts)
        {
            await service.DeleteProductAsync(id);
            UpdateListDelete(id);
        }
    }

    private void PrintLabels(Product product)
    {
    }

    private async void UpdateListDelete(int productid)
    {
        var lista = productsFiltered?.ToList();
        var productoBorrar = lista?.
        FirstOrDefault(p => p.Product_id == productid);
        if (productoBorrar != null)
        {
            lista?.Remove(productoBorrar);
        }
        productsFiltered = lista?.AsQueryable();
              
        await OnUpdateListProduct.InvokeAsync(productsFiltered);
    } 

    private void ActualizarLista(Product productUpdate)
    {    
        var productoActualizado = productsFiltered?.
            FirstOrDefault(p => p.Product_id == productUpdate.Product_id);

        if (productoActualizado != null)
        {
            productoActualizado.Product_Name = productUpdate.Product_Name;
            productoActualizado.Product_Type = productUpdate.Product_Type;
            productoActualizado.Unidad = productUpdate.Unidad;
            productoActualizado.Price = productUpdate.Price;
            productoActualizado.Codebar = productUpdate.Codebar;
        }
    }
}
