@page "/Upload" 
@using System.Net.Http.Headers
@inject UploadService Uploadservice
@inject IHttpClientFactory HttpClientFactory

<div class="upload-container">
    <div class="row">
        <div class="col-md-12">
            <h2 class="mb-4">🖼️ Gestor de Imágenes</h2>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white upload-card-header">
                    <h5 class="mb-0">📤 Cargar Nuevas Imágenes</h5>
                </div>
                <div class="card-body">
                    <div class="upload-input-area">
                        <InputFile OnChange="@UploadImagen" multiple accept="image/*" />
                        <small class="form-text text-muted d-block mt-2">
                            ✓ Selecciona una o más imágenes para cargar
                        </small>
                    </div>

                    @if (isUploading)
                    {
                        <div class="mt-3 text-center">
                            <div class="spinner-border spinner-custom" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando imágenes...</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadMessage))
                    {
                        <div class="alert @(uploadMessage.Contains("error") || uploadMessage.Contains("Error") ? "alert-danger alert-danger-custom" : "alert-success alert-success-custom") mt-3 alert-custom">
                            @uploadMessage
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">🗂️ Imágenes Guardadas (@uploadResults.Count)</h5>
                </div>
                <div class="card-body">
                    @if (uploadResults.Count > 0)
                    {
                        <div class="image-gallery">
                            @foreach (var image in uploadResults)
                            {
                                <div class="image-card">
                                    <div class="image-container">
                                        @if (!string.IsNullOrEmpty(image.StoredFileName))
                                        {
                                            <img src="@GetImageUrl(image.Id)" 
                                                 alt="@image.FileName"
                                                 loading="lazy"
                                                 onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22%3E%3Crect fill=%22%23f0f0f0%22 width=%22200%22 height=%22200%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 font-size=%2216%22 fill=%22%23999%22 text-anchor=%22middle%22 dominant-baseline=%22middle%22%3EImagen no disponible%3C/text%3E%3C/svg%3E'" />
                                        }
                                        <button class="btn-delete-image" 
                                                @onclick="() => ConfirmDeleteImage(image.Id)" 
                                                title="Eliminar imagen">
                                            ✕
                                        </button>
                                    </div>
                                    <div class="image-info">
                                        <div class="image-filename" title="@image.FileName">
                                            @(image.FileName?.Length > 30 ? image.FileName.Substring(0, 27) + "..." : image.FileName)
                                        </div>
                                        <div class="image-stored-name">
                                            <strong>Almacenado:</strong><br>
                                            @image.StoredFileName
                                        </div>
                                        <div class="image-id">
                                            <strong>ID:</strong> @image.Id
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @if (!isLoadingImages)
                        {
                            <div class="text-center py-5">
                                <h6 class="text-muted">📭 No hay imágenes cargadas</h6>
                                <p class="text-muted">Selecciona imágenes arriba para comenzar.</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border spinner-custom" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <p class="mt-2 text-muted">Cargando imágenes...</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public int maxAllowedFiles = int.MaxValue;
    public long maxFileSize = long.MaxValue;
    private List<string> fileNames = [];
    private List<UploadResult> uploadResults = [];
    private bool isUploading = false;
    private bool isLoadingImages = false;
    private string? uploadMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadImagesAsync();
    }

    private async Task LoadImagesAsync()
    {
        try
        {
            isLoadingImages = true;
            uploadResults = await Uploadservice.GetAllImages();
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error al cargar imágenes: {ex.Message}";
        }
        finally
        {
            isLoadingImages = false;
        }
    }

    private async Task UploadImagen(InputFileChangeEventArgs e)
    {
        try
        {
            isUploading = true;
            uploadMessage = null;
            fileNames.Clear();

            using var content = new MultipartFormDataContent();

            foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
            {
                var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

                fileNames.Add(file.Name);

                content.Add(
                    content: fileContent,
                    name: "\"files\"",
                    fileName: file.Name
                );
            }

            var newUploadResults = await Uploadservice.UploadFile(content);

            if (newUploadResults is not null)
            {
                uploadResults = uploadResults.Concat(newUploadResults).ToList();
                uploadMessage = $"✓ {newUploadResults.Count} imagen(es) cargada(s) exitosamente.";
                fileNames.Clear();
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error al cargar imágenes: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private string? GetStoredFileName(string fileName)
    {
        var uploadResult = uploadResults.SingleOrDefault(f => f.FileName == fileName);
        if (uploadResult is not null)
            return uploadResult.StoredFileName;

        return "archivo no encontrado"; 
    }

    private string GetImageUrl(int imageId)
    {
        // Construir URL completa para la API
        var client = HttpClientFactory.CreateClient("ritrama");
        var baseUrl = client.BaseAddress?.ToString().TrimEnd('/') ?? "http://localhost:5220";
        return $"{baseUrl}/api/upload/getimagenbyid?id={imageId}";
    }

    private async Task ConfirmDeleteImage(int imageId)
    {
        var confirmDelete = await Js.InvokeAsync<bool>("confirm", 
            "¿Estás seguro de que deseas eliminar esta imagen? Esta acción no se puede deshacer.");

        if (confirmDelete)
        {
            await DeleteImage(imageId);
        }
    }

    private async Task DeleteImage(int imageId)
    {
        try
        {
            var success = await Uploadservice.DeleteImage(imageId);

            if (success)
            {
                uploadResults.RemoveAll(i => i.Id == imageId);
                uploadMessage = "✓ Imagen eliminada correctamente.";
                StateHasChanged();
            }
            else
            {
                uploadMessage = "❌ Error al eliminar la imagen.";
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"❌ Error al eliminar la imagen: {ex.Message}";
        }
    }

    // Inyección de JS necesaria para la confirmación
    @inject IJSRuntime Js
}
