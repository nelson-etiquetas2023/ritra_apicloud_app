@page "/Upload" 
@using System.Net.Http.Headers
@inject UploadService Uploadservice

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2>Gestor de Imágenes</h2>

            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Cargar Nuevas Imágenes</h5>
                </div>
                <div class="card-body">
                    <InputFile OnChange="@UploadImagen" multiple accept="image/*" />
                    <small class="form-text text-muted">
                        Selecciona una o más imágenes para cargar
                    </small>

                    @if (isUploading)
                    {
                        <div class="spinner-border mt-2" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadMessage))
                    {
                        <div class="alert @(uploadMessage.Contains("error") || uploadMessage.Contains("Error") ? "alert-danger" : "alert-success") mt-2">
                            @uploadMessage
                        </div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Imágenes Guardadas</h5>
                </div>
                <div class="card-body">
                    @if (uploadResults.Count > 0)
                    {
                        <div class="row">
                            @foreach (var image in uploadResults)
                            {
                                <div class="col-md-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-img-top" style="background-color: #f0f0f0; height: 200px; display: flex; align-items: center; justify-content: center;">
                                            @if (!string.IsNullOrEmpty(image.StoredFileName))
                                            {
                                                <img src="api/upload/getimagenbyid?id=@image.Id" 
                                                     alt="@image.FileName" 
                                                     style="max-width: 100%; max-height: 100%; object-fit: cover;" />
                                            }
                                        </div>
                                        <div class="card-body">
                                            <h6 class="card-title">@image.FileName</h6>
                                            <p class="card-text small text-muted">
                                                <strong>Nombre Almacenado:</strong><br>
                                                @image.StoredFileName
                                            </p>
                                            <p class="card-text small text-muted">
                                                <strong>ID:</strong> @image.Id
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @if (!isLoadingImages)
                        {
                            <p class="text-muted">No hay imágenes cargadas. Selecciona imágenes para comenzar.</p>
                        }
                        else
                        {
                            <p class="text-muted">Cargando imágenes...</p>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public int maxAllowedFiles = int.MaxValue;
    public long maxFileSize = long.MaxValue;
    private List<string> fileNames = [];
    private List<UploadResult> uploadResults = [];
    private bool isUploading = false;
    private bool isLoadingImages = false;
    private string? uploadMessage = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadImagesAsync();
    }

    private async Task LoadImagesAsync()
    {
        try
        {
            isLoadingImages = true;
            uploadResults = await Uploadservice.GetAllImages();
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error al cargar imágenes: {ex.Message}";
        }
        finally
        {
            isLoadingImages = false;
        }
    }

    private async Task UploadImagen(InputFileChangeEventArgs e)
    {
        try
        {
            isUploading = true;
            uploadMessage = null;
            fileNames.Clear();

            using var content = new MultipartFormDataContent();

            foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
            {
                var fileContent = new StreamContent(file.OpenReadStream(maxFileSize));
                fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

                fileNames.Add(file.Name);

                content.Add(
                    content: fileContent,
                    name: "\"files\"",
                    fileName: file.Name
                );
            }

            var newUploadResults = await Uploadservice.UploadFile(content);

            if (newUploadResults is not null)
            {
                uploadResults = uploadResults.Concat(newUploadResults).ToList();
                uploadMessage = $"✓ {newUploadResults.Count} imagen(es) cargada(s) exitosamente.";
                fileNames.Clear();
            }
        }
        catch (Exception ex)
        {
            uploadMessage = $"Error al cargar imágenes: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private string? GetStoredFileName(string fileName)
    {
        var uploadResult = uploadResults.SingleOrDefault(f => f.FileName == fileName);
        if (uploadResult is not null)
            return uploadResult.StoredFileName;

        return "archivo no encontrado"; 
    }
}