/* Estilos para la sección de imágenes en el modal de crear productos */

.image-upload-box {
    border: 2px dashed #667eea;
    border-radius: 8px;
    padding: 15px;
    background-color: #f8f9fa;
    transition: all 0.3s ease;
}

.image-upload-box:hover {
    background-color: #f0f4ff;
    border-color: #764ba2;
}

.image-preview-area {
    position: relative;
    width: 100%;
    height: 150px;
    background-color: #fff;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
    border: 1px solid #e0e0e0;
}

.image-preview-area img {
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
}

.placeholder {
    color: #999;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
}

.img-preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.position-absolute {
    position: absolute;
}
