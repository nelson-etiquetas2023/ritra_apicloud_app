/* Galería de Productos - Estilos Profesionales eCommerce */

.details-container {
    padding: 40px 20px;
    max-width: 1400px;
    margin: 0 auto;
    background-color: #ffffff;
}

.gallery-container {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 40px;
    margin-top: 20px;
}

.gallery-main {
    order: 2;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.main-image-wrapper {
    position: relative;
    width: 100%;
    height: 600px;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    background: linear-gradient(135deg, #f5f5f5 0%, #ffffff 100%);
    cursor: zoom-in;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease;
}

.main-image-wrapper:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
}

.main-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    padding: 20px;
}

.zoom-lens {
    position: absolute;
    width: 280px;
    height: 280px;
    border: 3px solid #FF6B35;
    background-color: rgba(255, 107, 53, 0.05);
    overflow: hidden;
    pointer-events: none;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.3),
                0 8px 25px rgba(255, 107, 53, 0.35),
                inset 0 0 15px rgba(255, 107, 53, 0.15);
    z-index: 100;
}

.zoomed-image {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.navigation-controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%);
    padding: 20px;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
}

.nav-button {
    padding: 12px 28px;
    background: linear-gradient(135deg, #FF6B35 0%, #FF8555 100%);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
}

.nav-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 107, 53, 0.4);
    background: linear-gradient(135deg, #FF5A1F 0%, #FF7A45 100%);
}

.nav-button:active:not(:disabled) {
    transform: translateY(0);
}

.nav-button:disabled {
    background: linear-gradient(135deg, #cccccc 0%, #dddddd 100%);
    cursor: not-allowed;
    opacity: 0.5;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
}

.image-counter {
    font-weight: 700;
    color: #333333;
    min-width: 80px;
    text-align: center;
    font-size: 15px;
    background: rgba(255, 107, 53, 0.08);
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid rgba(255, 107, 53, 0.2);
}

.thumbnails-column {
    order: 1;
    width: 140px;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    background-color: #fafafa;
    padding: 12px;
    overflow-y: auto;
    max-height: 620px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

.thumbnails-scroll {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.thumbnail-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border: 3px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    background-color: white;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
}

.thumbnail-wrapper:hover {
    border-color: #FF6B35;
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.25);
    transform: translateY(-4px);
}

.thumbnail-wrapper.active {
    border-color: #FF6B35;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #FF6B35, 0 4px 15px rgba(255, 107, 53, 0.3);
    background-color: #fffafb;
}

.thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* Custom Scrollbar */
.thumbnails-column::-webkit-scrollbar {
    width: 6px;
}

.thumbnails-column::-webkit-scrollbar-track {
    background: transparent;
}

.thumbnails-column::-webkit-scrollbar-thumb {
    background: #FF6B35;
    border-radius: 3px;
    transition: background 0.3s ease;
}

.thumbnails-column::-webkit-scrollbar-thumb:hover {
    background: #FF5A1F;
}

/* Firefox Scrollbar */
.thumbnails-column {
    scrollbar-color: #FF6B35 transparent;
    scrollbar-width: thin;
}

/* Responsive Design - Tablets */
@media (max-width: 1024px) {
    .gallery-container {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .gallery-main {
        order: 1;
    }

    .thumbnails-column {
        order: 2;
        width: 100%;
        max-height: 150px;
        padding: 10px;
    }

    .thumbnails-scroll {
        flex-direction: row;
        overflow-x: auto;
        overflow-y: hidden;
    }

    .thumbnail-wrapper {
        width: 130px;
        min-width: 130px;
        height: 130px;
    }

    .main-image-wrapper {
        height: 500px;
    }
}

/* Responsive Design - Mobile Landscape/Small Tablets */
@media (max-width: 768px) {
    .details-container {
        padding: 20px 15px;
    }

    .main-image-wrapper {
        height: 400px;
    }

    .zoom-lens {
        width: 150px;
        height: 150px;
    }

    .thumbnails-column {
        width: 100%;
        max-height: 120px;
    }

    .thumbnail-wrapper {
        width: 110px;
        min-width: 110px;
        height: 110px;
    }

    .navigation-controls {
        flex-wrap: wrap;
        gap: 12px;
    }

    .nav-button {
        padding: 10px 20px;
        font-size: 13px;
    }
}

/* Responsive Design - Mobile Portrait */
@media (max-width: 480px) {
    .main-image-wrapper {
        height: 300px;
    }

    .zoom-lens {
        width: 120px;
        height: 120px;
    }

    .thumbnail-wrapper {
        width: 90px;
        min-width: 90px;
        height: 90px;
    }

    .nav-button {
        padding: 10px 16px;
        font-size: 12px;
    }

    .image-counter {
        min-width: 60px;
        font-size: 13px;
    }
}
