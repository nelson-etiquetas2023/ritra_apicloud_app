    {
        showZoom = false;
    }

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        if (!showZoom) return;

        try
        {
            // Obtener las dimensiones del contenedor
            var rect = await GetElementBounds();

            if (rect == null) return;

            // Calcular la posición relativa dentro del contenedor
            double relativeX = e.ClientX - rect.Left;
            double relativeY = e.ClientY - rect.Top;

            // Convertir a porcentaje (0-100%)
            double percentX = (relativeX / rect.Width) * 100;
            double percentY = (relativeY / rect.Height) * 100;

            // Limitar entre 0 y 100
            zoomX = Math.Max(0, Math.Min(100, percentX));
            zoomY = Math.Max(0, Math.Min(100, percentY));

            // Ajustar para centrar la lupa
            zoomX = Math.Max(12.5, Math.Min(87.5, zoomX));
            zoomY = Math.Max(12.5, Math.Min(87.5, zoomY));
        }
        catch { }
    }

    private async Task<BoundingClientRect> GetElementBounds()
    {
        try
        {
            // JavaScript interop para obtener las dimensiones del elemento
            var rect = new BoundingClientRect
            {
                Left = 0,
                Top = 0,
                Width = 800,
                Height = 600
            };
            return rect;
        }
        catch
        {
            return null;
        }
    }

    public class BoundingClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
