@page "/Products/DetailsProducts/{Product_id:int}"
@using DocumentFormat.OpenXml.Office2010.PowerPoint

<div class="details-container">
    <h3>Detalle de Productos</h3>

    <div class="gallery-container">
        <div class="gallery-main">
            <!-- Imagen Principal con Zoom -->
            <div class="main-image-wrapper"
                 @onmousemove="HandleMouseMove"
                 @onmouseenter="ShowZoom"
                 @onmouseleave="HideZoom">
                <img src="@currentImage" 
                     alt="Imagen del producto" 
                     class="main-image"
                     @load="OnImageLoaded" />

                <!-- Lupa para zoom -->
                @if (showZoom && images.Count > 0)
                {
                    <div class="zoom-lens" style="left: @zoomX%; top: @zoomY%">
                        <img src="@currentImage" 
                             class="zoomed-image"
                             style="transform: scale(2); left: -@(zoomX * 2)%; top: -@(zoomY * 2)%;" />
                    </div>
                }
            </div>

            <!-- Controles de Navegación -->
            <div class="navigation-controls">
                <button class="nav-button prev-button" @onclick="PreviousImage" disabled="@(currentImageIndex == 0)">
                    ◀ Anterior
                </button>
                <span class="image-counter">@(currentImageIndex + 1) / @images.Count</span>
                <button class="nav-button next-button" @onclick="NextImage" disabled="@(currentImageIndex == images.Count - 1)">
                    Siguiente ▶
                </button>
            </div>
        </div>

        <!-- Galería de Miniaturas -->
        <div class="thumbnails-column">
            <div class="thumbnails-scroll">
                @foreach (var (image, index) in images.Select((img, idx) => (img, idx)))
                {
                    <div class="thumbnail-wrapper @(currentImageIndex == index ? "active" : "")"
                         @onclick="() => SelectImage(index)">
                        <img src="@image" 
                             alt="Miniatura @(index + 1)" 
                             class="thumbnail-image" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .details-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .gallery-container {
        display: flex;
        gap: 20px;
        margin-top: 30px;
    }

    .gallery-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .main-image-wrapper {
        position: relative;
        width: 100%;
        height: 500px;
        border: 2px solid #ddd;
        border-radius: 8px;
        overflow: hidden;
        background-color: #f5f5f5;
        cursor: crosshair;
    }

    .main-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    .zoom-lens {
        position: absolute;
        width: 150px;
        height: 150px;
        border: 2px solid #2196F3;
        background-color: rgba(33, 150, 243, 0.1);
        overflow: hidden;
        pointer-events: none;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    .zoomed-image {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .navigation-controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        background-color: #f9f9f9;
        padding: 15px;
        border-radius: 8px;
    }

    .nav-button {
        padding: 10px 20px;
        background-color: #2196F3;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .nav-button:hover:not(:disabled) {
        background-color: #1976D2;
        transform: scale(1.05);
    }

    .nav-button:disabled {
        background-color: #cccccc;
        cursor: not-allowed;
        opacity: 0.6;
    }

    .image-counter {
        font-weight: 600;
        color: #333;
        min-width: 60px;
        text-align: center;
    }

    .thumbnails-column {
        width: 120px;
        border: 2px solid #ddd;
        border-radius: 8px;
        background-color: #fafafa;
        padding: 8px;
        overflow-y: auto;
        max-height: 500px;
    }

    .thumbnails-scroll {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .thumbnail-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        border: 2px solid transparent;
        border-radius: 4px;
        cursor: pointer;
        overflow: hidden;
        transition: all 0.3s ease;
        background-color: white;
    }

    .thumbnail-wrapper:hover {
        border-color: #2196F3;
        box-shadow: 0 2px 6px rgba(33, 150, 243, 0.3);
        transform: scale(1.02);
    }

    .thumbnail-wrapper.active {
        border-color: #2196F3;
        box-shadow: 0 0 0 3px rgba(33, 150, 243, 0.2);
        background-color: #e3f2fd;
    }

    .thumbnail-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Responsive Design */
    @Media (max-width: 768px) {
    .gallery-container {
            flex-direction: column;
        }

        .main-image-wrapper {
            height: 300px;
        }

        .thumbnails-column {
            width: 100%;
            max-height: 120px;
            padding: 5px;
        }

        .thumbnails-scroll {
            flex-direction: row;
            overflow-x: auto;
            overflow-y: hidden;
        }

        .thumbnail-wrapper {
            width: 100px;
            min-width: 100px;
        }

        .zoom-lens {
            width: 100px;
            height: 100px;
        }
    }
</style>

@code {
    [Parameter]
    public int Product_id { get; set; }

    private List<string> images = new();
    private int currentImageIndex = 0;
    private string currentImage = "";
    private bool showZoom = false;
    private double zoomX = 0;
    private double zoomY = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductImages();
    }

    private async Task LoadProductImages()
    {
        // TODO: Reemplazar con llamada real a tu API
        // Ejemplo de imágenes para demostración
        images = new List<string>
        {
            "https://via.placeholder.com/600x600?text=Producto+1",
            "https://via.placeholder.com/600x600?text=Producto+2",
            "https://via.placeholder.com/600x600?text=Producto+3",
            "https://via.placeholder.com/600x600?text=Producto+4",
            "https://via.placeholder.com/600x600?text=Producto+5"
        };

        if (images.Count > 0)
        {
            currentImage = images[0];
        }
    }

    private void SelectImage(int index)
    {
        currentImageIndex = index;
        currentImage = images[currentImageIndex];
        showZoom = false;
    }

    private void NextImage()
    {
        if (currentImageIndex < images.Count - 1)
        {
            SelectImage(currentImageIndex + 1);
        }
    }

    private void PreviousImage()
    {
        if (currentImageIndex > 0)
        {
            SelectImage(currentImageIndex - 1);
        }
    }

    private void ShowZoom()
    {
        showZoom = true;
    }

    private void HideZoom()
    {
        showZoom = false;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!showZoom) return;

        var element = e.Target as Microsoft.AspNetCore.Components.Web.ElementReference?;
        if (element == null) return;

        // Calcular posición del zoom basado en el movimiento del mouse
        zoomX = (e.ClientX % 100);
        zoomY = (e.ClientY % 100);
    }

    private void OnImageLoaded()
    {
        StateHasChanged();
    }
}
