@page "/Products/DetailsProducts/{Product_id:int}"

<div class="details-container">
    <h3>Detalle de Productos</h3>

    <div class="gallery-container">
        <div class="gallery-main">
            <!-- Imagen Principal con Zoom -->
            <div class="main-image-wrapper"
                 @onmousemove="HandleMouseMove"
                 @onmouseenter="ShowZoom"
                 @onmouseleave="HideZoom">
                <img src="@currentImage" 
                     alt="Imagen del producto" 
                     class="main-image" />

                <!-- Lupa para zoom -->
                @if (showZoom && images.Count > 0)
                {
                    <div class="zoom-lens" style="left: @zoomX%; top: @zoomY%">
                        <img src="@currentImage" 
                             class="zoomed-image"
                             style="transform: scale(2); left: -@(zoomX * 2)%; top: -@(zoomY * 2)%;" />
                    </div>
                }
            </div>

            <!-- Controles de Navegación -->
            <div class="navigation-controls">
                <button class="nav-button prev-button" @onclick="PreviousImage" disabled="@(currentImageIndex == 0)">
                    ◀ Anterior
                </button>
                <span class="image-counter">@(currentImageIndex + 1) / @images.Count</span>
                <button class="nav-button next-button" @onclick="NextImage" disabled="@(currentImageIndex == images.Count - 1)">
                    Siguiente ▶
                </button>
            </div>
        </div>

        <!-- Galería de Miniaturas -->
        <div class="thumbnails-column">
            <div class="thumbnails-scroll">
                @foreach (var (image, index) in images.Select((img, idx) => (img, idx)))
                {
                    <div class="thumbnail-wrapper @(currentImageIndex == index ? "active" : "")"
                         @onclick="() => SelectImage(index)">
                        <img src="@image" 
                             alt="Miniatura @(index + 1)" 
                             class="thumbnail-image" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int Product_id { get; set; }

    private List<string> images = new();
    private int currentImageIndex = 0;
    private string currentImage = "";
    private bool showZoom = false;
    private double zoomX = 0;
    private double zoomY = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductImages();
    }

    private async Task LoadProductImages()
    {
        // TODO: Reemplazar con llamada real a tu API
        // Imágenes de prueba de calidad tipo ecommerce
        images = new List<string>
        {
            "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=1200&h=1200&fit=crop",
            "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=1200&h=1200&fit=crop",
            "https://images.unsplash.com/photo-1572635196237-14b3f281503f?w=1200&h=1200&fit=crop",
            "https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=1200&h=1200&fit=crop",
            "https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=1200&h=1200&fit=crop"
        };

        if (images.Count > 0)
        {
            currentImage = images[0];
        }

        await Task.CompletedTask;
    }

    private void SelectImage(int index)
    {
        currentImageIndex = index;
        currentImage = images[currentImageIndex];
        showZoom = false;
    }

    private void NextImage()
    {
        if (currentImageIndex < images.Count - 1)
        {
            SelectImage(currentImageIndex + 1);
        }
    }

    private void PreviousImage()
    {
        if (currentImageIndex > 0)
        {
            SelectImage(currentImageIndex - 1);
        }
    }

    private void ShowZoom()
    {
        showZoom = true;
    }

    private void HideZoom()
    {
        showZoom = false;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!showZoom) return;

        zoomX = (e.ClientX % 100);
        zoomY = (e.ClientY % 100);
    }
}

