@inject IOrdenCompraService servicio
@page "/mobile"

<Preload LoadingText="Cargando..." />


<h3>Conexion con Aplicacion movil.</h3>
<button class="btn btn-primary" @onclick="LoadOrders">Sincronizar</button>

<h5>Documentos sincronizados</h5>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>It.</th>
            <th>Numero</th>
            <th>Fecha</th>
            <th>Descripcion</th>
            <th>Status</th>
            <th>Sincro</th>
            <th>Tipo Doc.</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Ordenes == null || !Ordenes.Any())
        {
            <tr>
                <td colspan="8" class="text-center">No hay datos...</td>
            </tr>
        }
        else
        {
            var idx = 1;
            @foreach (var item in Ordenes)
            {
                <tr>
                    <td>@idx</td>
                    <td>@item.Numero</td>
                    <td>@item.Fecha.ToString("dd-MM-yyyy")</td>
                    <td>@item.Description</td>
                    <td>@(item.Status == 1 ? "Abierto" : "Cerrado")</td>
                    <td>@(item.Sincro ? "Sí" : "No")</td>
                    <td>@item.Tipo_Documento</td>
                    <td>
                        <a href="#" style="text-decoration:none">Update</a>
                        <a href="#" style="text-decoration:none">Details</a>
                        <a href="#" style="text-decoration:none">Delete</a>
                    </td>
                </tr>
                idx++;
            }
        }
    </tbody>
</table>

<h5>Numero de Documentos: @Ordenes?.Count</h5>

<br />
<br />


@code {

    [Inject]
    protected PreloadService PreloadService { get; set; } = default!;

    private List<OrdenCompra>? Ordenes;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            PreloadService.Show(SpinnerColor.Dark);
            Ordenes = await servicio.GetOrdersAsync();
        }
        finally
        {
            PreloadService.Hide();
        }

    }

}