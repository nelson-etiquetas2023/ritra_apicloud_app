<Solution>
  <Folder Name="/Elementos de la solución/" />
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
  </Folder>
  <Project Path="ScanProMovil/ScanProMovil.csproj">
    <Deploy Solution="Debug|*" />
  </Project>
  <Project Path="ScanProMovil.Data/ScanProMovil.Data.csproj" />
  <!-- Shared.csproj debe estar en la solucion: ScanProMovil.Data lo referencia
       via ProjectReference y VS no resuelve referencias fuera de la solucion. -->
  <Project Path="../Shared/Shared.csproj" />
</Solution>
