<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.ComprasIndexPage"
             Title="Compras"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data" 
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:ComprasViewModel">
    <Grid Padding="1"
          RowDefinitions="Auto, *">
        <!--Barra de Busqueda -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".7*"></ColumnDefinition>
                <ColumnDefinition Width=".3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                 Margin="0,5,0,0"
                 Stroke="gray"
                 StrokeThickness="1"
                 Background="White">    
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                </Border.StrokeShape>
                <SearchBar 
                     Text="{Binding SearchText}"
                     Placeholder="Buscar Ordenes..." 
                     FontAttributes="Bold"/>
            </Border>
            <!--Total de Ordenes-->
            <Label Text="{Binding TotalOrders, StringFormat='{0} Items'}" 
                 Grid.Column="1"
                 FontSize="10"
                 TextColor="White"
                 FontAttributes="Bold" VerticalTextAlignment="Center" 
                 HorizontalOptions="Center" Background="Black" 
                 Margin="0,5,0,5" Padding="20,0,20,0"/>
        </Grid>
        <!--Lista de Ordenes -->
        <CollectionView Grid.Row="1"
            x:Name="CvOrdenes"
            EmptyView="No Data..."
            ItemsLayout="VerticalList"
            SelectionMode="Single"
            ItemsSource="{Binding Ordenes}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrdenCompra">
                    <Border Margin="1" 
                        Stroke="gray"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <!--layuot de la tarjeta-->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".08*" />
                                <ColumnDefinition Width=".2*" />
                                <ColumnDefinition Width=".44*" />
                            </Grid.ColumnDefinitions>
                            <!--Seccion de la Foto -->
                            <HorizontalStackLayout Grid.Column="0">
                                <Image Source="downloads.png"  />
                            </HorizontalStackLayout>
                            <!--Seccion del medio Numero-fecha-tatus -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Numero}"
                                       FontAttributes="Bold"
                                       FontSize="20"/>
                                <Label Text="{Binding Supply_Name}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Items.Count, StringFormat='0/{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
    
    
</ContentPage>



