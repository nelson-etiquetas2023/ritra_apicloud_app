<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.ComprasIndexPage"
             Title="Compras"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data" 
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:ComprasViewModel">

    <Grid Padding="1" 
          RowDefinitions="Auto, Auto, *">
        <!--Barra de Acciones-->
        <ScrollView Grid.Row="0" 
                    Orientation="Horizontal">
            <HorizontalStackLayout 
                Spacing="3">
                <Button 
                     x:Name="btnAddOrders"
                     Text="ADD"       
                     ImageSource="add.png"
                     BackgroundColor="DodgerBlue" 
                     ContentLayout="Top, 2"
                     TextColor="White" WidthRequest="80"
                     Clicked="btnAddOrders_Clicked"/>
                <Button 
                     x:Name="btnDetailsOrders"
                     Text="INFO"       
                     ImageSource="document_info.png"
                     BackgroundColor="DodgerBlue" 
                     ContentLayout="Top, 2"
                     TextColor="White" WidthRequest="80"
                     Clicked="btnDetailsOrders_Clicked" />

                <Button 
                     x:Name="btnConfig"
                     Text="CONF"       
                     ImageSource="gear_24px.png"
                     BackgroundColor="DodgerBlue" 
                     ContentLayout="Top, 2"
                     TextColor="White" WidthRequest="80"
                     Clicked="btnConfig_Clicked" />
                <Button 
                    x:Name="btn_sincrOrdenes"
                    Text="SINC"
                    ImageSource="uploadcloud.png"
                    BackgroundColor="DodgerBlue" 
                    ContentLayout="Top, 2"
                    TextColor="White" 
                    WidthRequest="80"
                    Clicked="btn_sincrOrdenes_Clicked" />
                <Button 
                    x:Name="btnReceiveOrders"
                    Text="RECEIVE"
                    ImageSource="receive.png"
                    BackgroundColor="Green" 
                    ContentLayout="Top, 2"
                    TextColor="White" 
                    WidthRequest="80"
                    IsEnabled="{Binding CanReceive}"
                    Clicked="btnReceiveOrders_Clicked" />
                <Label Text="{Binding SelectedCount, StringFormat='Sel: {0}'}" 
                       FontSize="10" TextColor="White" FontAttributes="Bold" 
                       VerticalOptions="Center" Margin="10,0,0,0"/>
                <Button 
                    Text="DELETE"
                    x:Name="btnDeleteOrder"
                    ImageSource="delete.png"
                    BackgroundColor="DodgerBlue" 
                    ContentLayout="Top, 2"
                    TextColor="White"  WidthRequest="80"
                    Clicked="btnDeleteOrder_Clicked" />
                <Button Text="CANCEL"
                  x:Name="btnCancelOrder"
                  ImageSource="cancel.png"
                  BackgroundColor="DodgerBlue" 
                  ContentLayout="Top, 2"
                  TextColor="White" WidthRequest="80"
                  Clicked="btnCancelOrder_Clicked"/>
            </HorizontalStackLayout>
        </ScrollView>
        <!--Barra de Busqueda -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".7*"></ColumnDefinition>
                <ColumnDefinition Width=".3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                 Margin="0,5,0,0"
                 Stroke="gray"
                 StrokeThickness="1"
                 Background="White">    
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                </Border.StrokeShape>
                <SearchBar 
                     Text="{Binding SearchText}"
                     Placeholder="Buscar Ordenes..." 
                     FontAttributes="Bold"/>
            </Border>
            <!--Total de Ordenes-->
            <Label Text="{Binding TotalOrders, StringFormat='{0} Items'}" 
                 Grid.Column="1" 
                 FontSize="10"
                 TextColor="White"
                 FontAttributes="Bold" VerticalTextAlignment="Center" 
                 HorizontalOptions="Center" Background="Black" 
                 Margin="0,5,0,5" Padding="20,0,20,0"/>
        </Grid>
        <!--Lista de Ordenes -->
        <CollectionView Grid.Row="2"
            x:Name="CvOrdenes"
            EmptyView="No Data..."
            ItemsLayout="VerticalList"
            SelectionMode="Single"
            ItemsSource="{Binding Ordenes}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrdenCompra">
                    <Border Margin="1" 
                        Stroke="gray"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <!--layuot de la tarjeta-->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".08*" />
                                <ColumnDefinition Width=".2*" />
                                <ColumnDefinition Width=".44*" />
                            </Grid.ColumnDefinitions>
                            <!--Columna de seleccion (Receive)-->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding PuedeRecibir}"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"/>
                            <!--Seccion de la Foto -->
                            <HorizontalStackLayout Grid.Column="1">
                                <Image Source="downloads.png"  />
                            </HorizontalStackLayout>
                            <!--Seccion del medio Numero-fecha-tatus -->
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="{Binding Numero}"
                                       FontAttributes="Bold"
                                       FontSize="20"/>
                                <Label Text="{Binding Supply_Name}"
                                       FontSize="12"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding ItemsNumber, StringFormat='0/{0}'}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB"/>
                            </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
    
    
</ContentPage>
