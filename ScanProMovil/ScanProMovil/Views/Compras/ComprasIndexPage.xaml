<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.ComprasIndexPage"
             Title="Recepción"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:ComprasViewModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sincronizar"
                     Clicked="OnSincronizarClicked"
                     Order="Primary"
                     Priority="0"/>
        <ToolbarItem Text="Eliminar Todo"
                     Command="{Binding DeleteAllOrdersLocalCommand}"
                     Order="Primary"
                     Priority="1"
                     IconImageSource="delete_50px.png"/>
    </ContentPage.ToolbarItems>

    <Grid Padding="1"
          RowDefinitions="Auto, *">
        <!--Barra de Busqueda -->
        <Border Grid.Row="0"
             Margin="0,5,0,0"
             Stroke="#D1D5DB"
             StrokeThickness="1"
             StrokeShape="RoundRectangle 6"
             Padding="8"
             BackgroundColor="White">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Image Source="search_50px.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"/>
                <Entry Text="{Binding SearchText}"
                       Placeholder="Buscar Ordenes..."
                       FontSize="14"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
        <!--Lista de Ordenes -->
        <CollectionView Grid.Row="1"
            x:Name="CvOrdenes"
            EmptyView="No Data..."
            ItemsLayout="VerticalList"
            SelectionMode="Single"
            ItemsSource="{Binding Ordenes}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrdenCompra">
                    <Border Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14"
                            Margin="10,0,10,6"
                            BackgroundColor="White">

                        <!-- Todo el card es clickeable para abrir el detalle de productos -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOrdenCardTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center">

                            <!-- Icono del documento de compra -->
                            <Image Source="downloads.png"
                                   WidthRequest="70"
                                   HeightRequest="70"
                                   VerticalOptions="Center"/>

                            <!-- InformaciÃ³n de la orden -->
                            <VerticalStackLayout Spacing="4">

                                <!-- LÃ­nea 1: proveedor -->
                                <Label Text="{Binding Supply_Name}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"
                                       LineBreakMode="TailTruncation"/>
                                <!-- Línea 2: número de orden y fecha -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Numero}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#374151"/>
                                    <Label Text=" | "
                                           FontSize="14"
                                           TextColor="#9CA3AF"/>
                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>
                                </HorizontalStackLayout>

                                <!-- Línea 3: contador de unidades recibidas/por recibir -->
                                <Label Text="{Binding ProgresoTexto}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       TextColor="#2563EB"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
