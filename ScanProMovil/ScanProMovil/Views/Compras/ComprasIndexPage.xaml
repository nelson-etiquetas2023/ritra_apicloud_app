<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.ComprasIndexPage"
             Title="Compras"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data" 
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:DataType="vm:ComprasViewModel">
    <Grid Padding="1"
          RowDefinitions="Auto, *">
        <!--Barra de Busqueda -->
        <Border Grid.Row="0"
             Margin="0,5,0,0"
             Stroke="#D1D5DB"
             StrokeThickness="1"
             StrokeShape="RoundRectangle 6"
             Padding="8"
             BackgroundColor="White">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Image Source="search_50px.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"/>
                <SearchBar Text="{Binding SearchText}"
                          Placeholder="Buscar Ordenes..."
                          FontAttributes="Bold"
                          BackgroundColor="Transparent"
                          VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>
        </Grid>
        <!--Lista de Ordenes -->
        <CollectionView Grid.Row="1"
            x:Name="CvOrdenes"
            EmptyView="No Data..."
            ItemsLayout="VerticalList"
            SelectionMode="Single"
            ItemsSource="{Binding Ordenes}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:OrdenCompra">
                    <Border Margin="1" 
                        Stroke="gray"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"></RoundRectangle>
                        </Border.StrokeShape>
                        <!--layuot de la tarjeta-->
                        <!-- Tarjeta estilo picking -->
                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                            <Image Source="downloads.png"
                                   WidthRequest="60"
                                   HeightRequest="60"
                                   VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Numero}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>
                                <Label Text="{Binding Supply_Name}"
                                       FontSize="14"
                                       TextColor="#6B7280"
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
    
    
</ContentPage>



