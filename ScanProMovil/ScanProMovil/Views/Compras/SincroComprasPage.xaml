<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.SincroComprasPage"
             Title="SINCRONIZACION"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels.Compras"
             x:DataType="vm:SincroComprasViewModels"
             >
    <VerticalStackLayout>
        <Button x:Name="btn_sincro" 
                Text="Iniciar Sincronización" 
                WidthRequest="300" 
                Command="{Binding SendPurchaseOrderCommand}"
                IsEnabled="{Binding IsSincronizarEnabled}"/>

        <ActivityIndicator 
            IsRunning="{Binding IsSincronizando}"
            IsVisible="{Binding IsSincronizando}"
            Color="Blue"
            WidthRequest="50"
            HeightRequest="50"
            Margin="0,10,0,0"/>

        <Label Text="{Binding ResultadoSincro}"
               TextColor="{Binding ResultadoColor}"
               FontAttributes="Bold"
               Margin="5,10,0,0"/>

        <Label Text="{Binding DuracionSincro}"
               Margin="5,5,0,0"/>
        
        <Label Text="Datos de la Orden de Compra" 
               Margin="5,15,0,0" 
               FontAttributes="Bold" />
        <BoxView 
            HeightRequest="1" 
            BackgroundColor="LightGray"
            VerticalOptions="End"
            HorizontalOptions="Fill" 
            Margin="0,15,0,15"/>
        <Label 
            Text="{Binding Orden.Numero, 
            StringFormat='Orden de Compra : {0}' }"
            FontAttributes="Bold" />

        <Label Text="{Binding Orden.Fecha, StringFormat='Fecha: {0}'}" />


    </VerticalStackLayout>
</ContentPage>