<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Compras.ComprasDetalleProductosPage"
             Title="Detalle de Compra"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Encabezado: numero de la orden y proveedor (fila 0 - compacto) -->
        <Border Grid.Row="0"
                Padding="8"
                Margin="0,4,0,0"
                BackgroundColor="#F9FAFB">
            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding Orden.Numero}"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#1F2937"/>
                    <Label Text="{Binding Orden.ItemsNumber, StringFormat='· {0} líneas'}"
                           FontSize="11"
                           TextColor="#6B7280"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{Binding Orden.UnidadesRecibidas, StringFormat='Recibidas: {0}'}"
                           FontSize="10"
                           TextColor="#6B7280"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding Orden.TotalUnidades, StringFormat='de {0}'}"
                           FontSize="10"
                           TextColor="#6B7280"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="{Binding Orden.Supply_Name, StringFormat='Proveedor: {0}'}"
                       FontSize="11"
                       TextColor="#6B7280"/>
            </VerticalStackLayout>
        </Border>

        <!-- Captura de codigo de barras (fila 1) - Escaneo automatico para dispositivo Zebra -->
        <Border Grid.Row="1"
                Stroke="#D1D5DB"
                StrokeThickness="1"
                StrokeShape="Rectangle 6"
                Padding="6"
                Margin="10,6,10,6"
                BackgroundColor="White">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Image Source="search_50px.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"/>
                <Entry x:Name="EntryCodigoBarra"
                       Placeholder="Escanear código de barras..."
                       FontSize="14"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Keyboard="Text"
                       ReturnType="Done"
                       TextChanged="OnCodigoBarraTextChanged"
                       Completed="OnCodigoBarraCompleted"
                       IsEnabled="{Binding EstaBloqueado, Converter={StaticResource InverseBoolConverter}}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Mensaje de feedback del escaneo -->
        <Label Grid.Row="2"
               Text="{Binding MensajeEscaneo}"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="{Binding ColorMensajeEscaneo}"
               HorizontalOptions="Center"
               Margin="0,4,0,0"/>

        <!-- Lista de productos a recibir (fila 3 - se expande y hace scroll) -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        EmptyView="Sin productos en esta orden.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="0" Padding="8,4">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.AbrirDialogoCommand, Source={x:Reference Root}}"
                                                  CommandParameter="{Binding .}"/>
                        </VerticalStackLayout.GestureRecognizers>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                            <!-- Columna 1: Check (primero, izquierda) -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding RecibidoCompleto, Mode=OneWay}"
                                      IsEnabled="False"
                                      Color="#10B981"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"
                                      WidthRequest="22"
                                      HeightRequest="22"/>

                            <!-- Columna 2: Contenido del producto -->
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">

                                <!-- Fila 1: Código producto (izq) | Contador recibido/ordenado (der) -->
                                <Label Grid.Column="0" Grid.Row="0"
                                       Text="{Binding Product_id}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#374151"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1" Grid.Row="0"
                                       Text="{Binding RecibidoTexto}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding RecibidoCompleto}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#10B981"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Fila 2: Nombre del producto -->
                                <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding Product_Name}"
                                       FontSize="10"
                                       TextColor="#6B7280"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"/>
                            </Grid>

                        </Grid>

                        <!-- Línea divisoria sutil entre productos -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#F3F4F6"
                                 Margin="0,6,0,0"/>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Indicador de carga (fila 4) -->
        <ActivityIndicator Grid.Row="4"
                           IsRunning="{Binding IsLoading}"
                           Color="Blue"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

        <!-- Diálogo de confirmación de recepción (scan & confirm) - fondo oscuro -->
        <BoxView Grid.RowSpan="5"
                 BackgroundColor="Black"
                 Opacity="0.55"
                 IsVisible="{Binding DialogoAbierto}"
                 InputTransparent="True"/>

        <!-- Diálogo de confirmación de recepción -->
        <Border Grid.RowSpan="5"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                IsVisible="{Binding DialogoAbierto}"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 12"
                Padding="0"
                WidthRequest="340">
            <VerticalStackLayout Spacing="0"
                                 HorizontalOptions="Center">
                <!-- Encabezado del producto (caja gris) -->
                <Border BackgroundColor="#F9FAFB"
                        Padding="16"
                        Margin="0">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ProductoDialog.Product_id, StringFormat='Código: {0}'}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#374151"/>
                        <Label Text="{Binding ProductoDialog.Product_Name, StringFormat='Producto: {0}'}"
                               FontSize="13"
                               TextColor="#6B7280"/>
                        <Label Text="{Binding ProductoDialog.RecibidoTexto}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#2563EB"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Escaneo de código de barras dentro del diálogo (estilo picking) -->
                <Border Stroke="#D1D5DB"
                        StrokeThickness="1"
                        StrokeShape="Rectangle 6"
                        Padding="6"
                        BackgroundColor="White"
                        Margin="0,8,0,0"
                        HorizontalOptions="Center"
                        WidthRequest="300">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                        <Image Source="search_50px.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               VerticalOptions="Center"/>
                        <Entry x:Name="EntryCodigoBarraDialogo"
                               Text="{Binding CodigoEscaneoDialogo, Mode=TwoWay}"
                               Placeholder="Escanear código de barras..."
                               FontSize="14"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Keyboard="Text"
                               ReturnType="Done"
                               TextChanged="OnCodigoBarraDialogoTextChanged"
                               Completed="OnCodigoBarraDialogoCompleted"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Cantidad a recibir (botón - | entry centrado con border | botón +) -->
                <VerticalStackLayout Spacing="8" Margin="0,8,0,0" HorizontalOptions="Center">
                    <Label Text="Cantidad a recibir:"
                           FontSize="12"
                           TextColor="#6B7280"
                           HorizontalOptions="Center"/>

                    <Border Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="Rectangle 6"
                            Padding="6"
                            BackgroundColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Grid ColumnDefinitions="44,Auto,44" ColumnSpacing="6" HorizontalOptions="Center">
                            <Button Grid.Column="0"
                                    Text="-"
                                    Command="{Binding DecrementarDialogoCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#DC2626"
                                    FontSize="16"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"/>

                            <Entry Grid.Column="1"
                                   Text="{Binding CantidadDialog, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   TextColor="#1F2937"
                                   BackgroundColor="Transparent"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   WidthRequest="80"/>

                            <Button Grid.Column="2"
                                    Text="+"
                                    Command="{Binding IncrementarDialogoCommand}"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    BackgroundColor="#F3F4F6"
                                    TextColor="#15803D"
                                    FontSize="16"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"/>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="12"
                                           Padding="0,12,0,12">
                        <Button Text="Cancelar"
                                Command="{Binding CancelarDialogoCommand}"
                                WidthRequest="110"
                                HeightRequest="44"
                                BackgroundColor="#F3F4F6"
                                TextColor="#6B7280"/>

                        <Button Text="Guardar"
                                Command="{Binding GuardarDialogoCommand}"
                                WidthRequest="110"
                                HeightRequest="44"
                                BackgroundColor="#15803D"
                                TextColor="White"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
