<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ScanProMovil.Data.Entities;assembly=ScanProMovil.Data"
             x:Class="ScanProMovil.Views.Picking.PickingDetailPage"
             Title="Detalle de Picking"
             x:Name="Root">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Encabezado: número del pedido para ubicarse (fila 0 - compacto) -->
        <Border Grid.Row="0"
                Padding="8"
                Margin="0,4,0,0"
                BackgroundColor="#F9FAFB">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Orden.NumeroPedidoVenta}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#1F2937"/>
                <Label Text="{Binding Orden.ClienteNombre, StringFormat='Cliente: {0}'}"
                       FontSize="11"
                       TextColor="#6B7280"/>
            </VerticalStackLayout>
        </Border>

        <!-- Captura de código de barras (fila 1) - Escaneo automático para dispositivo Zebra -->
        <Border Grid.Row="1"
                Stroke="#D1D5DB"
                StrokeThickness="1"
                StrokeShape="Rectangle 6"
                Padding="6"
                Margin="10,6,10,6"
                BackgroundColor="White">
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Image Source="search_50px.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"/>
                <Entry x:Name="EntryCodigoBarra"
                       Placeholder="Escanear código de barras..."
                       FontSize="14"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Keyboard="Text"
                       ReturnType="Done"
                       TextChanged="OnCodigoBarraTextChanged"
                       Completed="OnCodigoBarraCompleted"
                       IsEnabled="{Binding EstaBloqueado, Converter={StaticResource InverseBoolConverter}}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Mensaje de feedback del escaneo -->
        <Label Grid.Row="2"
               Text="{Binding MensajeEscaneo}"
               FontSize="11"
               FontAttributes="Bold"
               TextColor="{Binding ColorMensajeEscaneo}"
               HorizontalOptions="Center"
               Margin="0,4,0,0"/>

        <!-- Lista de productos a picking (fila 3 - se expande y hace scroll) -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        EmptyView="Sin productos en esta orden.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="0" Padding="8,4">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">

                            <!-- Columna 1: Check (primero, izquierda) -->
                            <CheckBox Grid.Column="0"
                                      IsChecked="{Binding Completado, Mode=OneWay}"
                                      IsEnabled="False"
                                      Color="#10B981"
                                      VerticalOptions="Center"
                                      HorizontalOptions="Center"
                                      WidthRequest="22"
                                      HeightRequest="22"/>

                            <!-- Columna 2: Contenido del producto -->
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="2">

                                <!-- Fila 1: Código producto (izq) | Contador 0/1 (der) -->
                                <Label Grid.Column="0" Grid.Row="0"
                                       Text="{Binding ProductCode}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#374151"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1" Grid.Row="0"
                                       Text="{Binding ProgresoTexto}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="End">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Completado}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="#10B981"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <!-- Fila 2: Nombre del producto -->
                                <Label Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2"
                                       Text="{Binding ProductName}"
                                       FontSize="10"
                                       TextColor="#6B7280"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"/>
                            </Grid>

                        </Grid>

                        <!-- Línea divisoria sutil entre productos -->
                        <BoxView HeightRequest="1"
                                 BackgroundColor="#F3F4F6"
                                 Margin="0,6,0,0"/>

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Indicador de carga (fila 4) -->
        <ActivityIndicator Grid.Row="4"
                           IsRunning="{Binding IsLoading}"
                           Color="Blue"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

    </Grid>

</ContentPage>
