<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScanProMovil.Views.Picking.PickingPage"
             x:Name="Root"
             Title="Picking - Pedidos Pendientes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sincronizar"
                     IconImageSource="refresh"
                     Clicked="Btn_Sincronizar_Clicked"
                     Order="Primary"
                     Priority="0"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Buscador cuadrado con lupa (fila 0) -->
        <Border Grid.Row="0"
                Stroke="#D1D5DB"
                StrokeThickness="1"
                StrokeShape="Rectangle 6"
                Padding="8"
                Margin="10,0,10,10"
                BackgroundColor="White">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Image Source="search_50px.png"
                       WidthRequest="20"
                       HeightRequest="20"
                       VerticalOptions="Center"/>
                <Entry Placeholder="Buscar por número de pedido..."
                       Text="{Binding SearchText}"
                       FontSize="14"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Tarjetas de pedidos pendientes (fila 1 - se expande y hace scroll) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding FilteredOrders}"
                        SelectionMode="None"
                        EmptyView="No hay pedidos pendientes. Presiona 'Sincronizar Picking' para descargar desde el servidor.">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#D1D5DB"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="14"
                            Margin="10,0,10,6"
                            BackgroundColor="White">

                        <!-- Todo el card es clickeable para abrir el detalle del documento -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPickingCardTapped"/>
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="14" VerticalOptions="Center">

                            <!-- Icono del documento de picking (más grande) -->
                            <Image Source="package_delivery_logistics_64px.png"
                                   WidthRequest="70"
                                   HeightRequest="70"
                                   VerticalOptions="Center"/>

                            <!-- Información del pedido -->
                            <VerticalStackLayout Spacing="4">

                                <!-- Línea 1: nombre del cliente -->
                                <Label Text="{Binding ClienteNombre}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#1F2937"/>

                                <!-- Línea 2: número de pedido y fecha -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding NumeroPedidoVenta}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="#374151"/>
                                    <Label Text=" | "
                                           FontSize="14"
                                           TextColor="#9CA3AF"/>
                                    <Label Text="{Binding FechaCreacion, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                           FontSize="12"
                                           TextColor="#6B7280"/>
                                </HorizontalStackLayout>

                                <!-- Línea 3: progreso + badge PICKED cuando la orden ya se cerro -->
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding ProgresoTexto}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="#2563EB"/>
                                    <Border IsVisible="{Binding EsPicked}"
                                            BackgroundColor="#7C3AED"
                                            Padding="6,2"
                                            StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center">
                                        <Label Text="PICKED"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="White"/>
                                    </Border>
                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Indicador de carga (fila 2) -->
        <ActivityIndicator Grid.Row="2"
                           IsRunning="{Binding IsLoading}"
                           Color="Blue"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"/>

    </Grid>

</ContentPage>
