<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
             x:Class="ScanProMovil.Views.Orders.ConfigPage"
             Title="Configuracion">
    
    <ContentPage.BindingContext>
        <vm:OrderConfigViewModel />
    </ContentPage.BindingContext>
    
    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="5">
            <!--Seccion Sincronizacion de Data. -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <HorizontalStackLayout 
                        Spacing="3" 
                        BackgroundColor="Gray"
                        HeightRequest="60">
                        <Image Source="upload_document_64px.png" 
                               HeightRequest="48" 
                               WidthRequest="48" />
                        <Label 
                            Text="Sincronizacion de Data" 
                            FontSize="16" 
                            FontAttributes="Bold"
                            TextColor="Black" 
                            VerticalTextAlignment="Center"/>
                    </HorizontalStackLayout>
                </toolkit:Expander.Header>
                
                <VerticalStackLayout Spacing="10" 
                                     Padding="10" 
                                     BackgroundColor="#e0e0e0">
                    <HorizontalStackLayout 
                        Spacing="10">
                        <Label Text="Modo Seleccion Multiple" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding SelectMultipleRows}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Maximo de Ordenes a Procesar:"/>
                    <Entry Text="{Binding MaxOrdersProcess}" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </toolkit:Expander>
            <Button 
                x:Name="Btn_SaveConfigOrders"
                Margin="0,200,0,0" 
                Text="Guardar"
                Clicked="Btn_SaveConfigOrders_Clicked"/>
        </VerticalStackLayout>





        
    </ScrollView>
   
    
    
</ContentPage>