<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="ScanProMovil.Views.StockInit.MainStockInitPage"
            xmlns:entities="clr-namespace:ScanProMovil.Entities"
            xmlns:vm="clr-namespace:ScanProMovil.ViewModels"
            Title="Conteo Físico">

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage Title="Conteo Físico"
                             BackgroundColor="#F0F4F8"
                             x:DataType="vm:StockInitViewModel">
                    <ContentPage.ToolbarItems>
                        <ToolbarItem Text=""
                                     IconImageSource="back_arrow_32px.png"
                                     Order="Primary"
                                     Priority="0"
                                     Clicked="OnBackClicked" />
                    </ContentPage.ToolbarItems>
                    <Grid Padding="1"
                          RowDefinitions="Auto, Auto, *">

                        <!--Barra de Acciones (toolbar sobre el documento seleccionado)-->
                        <ScrollView Grid.Row="0"
                                    Orientation="Horizontal">
                            <HorizontalStackLayout Spacing="3">
                                <Button x:Name="btnAddDoc"
                                        Text="ADD"
                                        ImageSource="add.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnAddDoc_Clicked" />
                                <Button x:Name="btnInfoDoc"
                                        Text="INFO"
                                        ImageSource="document_info.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnInfoDoc_Clicked" />
                                <Button x:Name="btnConfig"
                                        Text="CONF"
                                        ImageSource="gear_24px.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnConfig_Clicked" />
                                <Button x:Name="btnSincDoc"
                                        Text="SINC"
                                        ImageSource="uploadcloud.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnSincDoc_Clicked" />
                                <Button x:Name="btnDeleteDoc"
                                        Text="DELETE"
                                        ImageSource="delete.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnDeleteDoc_Clicked" />
                                <Button x:Name="btnCancelDoc"
                                        Text="CLOSE"
                                        ImageSource="cancel.png"
                                        BackgroundColor="DodgerBlue"
                                        ContentLayout="Top, 2"
                                        TextColor="White"
                                        WidthRequest="80"
                                        Clicked="btnCancelDoc_Clicked" />
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!--Barra de Busqueda + contador-->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".7*"></ColumnDefinition>
                                <ColumnDefinition Width=".3*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Margin="0,5,0,0"
                                    Stroke="gray"
                                    StrokeThickness="1"
                                    Background="White">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"></RoundRectangle>
                                </Border.StrokeShape>
                                <SearchBar Text="{Binding SearchText}"
                                           Placeholder="Buscar documentos..."
                                           FontAttributes="Bold" />
                            </Border>
                            <!--Total de documentos-->
                            <Label Grid.Column="1"
                                   Text="{Binding TotalDocs, StringFormat='{0} Docs'}"
                                   FontSize="10"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   VerticalTextAlignment="Center"
                                   HorizontalOptions="Center"
                                   Background="Black"
                                   Margin="0,5,0,5"
                                   Padding="20,0,20,0" />
                        </Grid>

                        <!--Lista de documentos-->
                        <CollectionView Grid.Row="2"
                                        x:Name="DocsCollection"
                                        ItemsLayout="VerticalList"
                                        SelectionMode="Single"
                                        ItemsSource="{Binding Docs}"
                                        SelectedItem="{Binding SelectedDoc, Mode=TwoWay}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="12">
                                    <Border BackgroundColor="#F3F4F6"
                                            Padding="24"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            Opacity="0.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="50" />
                                        </Border.StrokeShape>
                                        <Image Source="warehouse_50px.png"
                                               WidthRequest="48"
                                               HeightRequest="48" />
                                    </Border>
                                    <Label Text="Sin documentos"
                                           TextColor="#6B7280"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="Crea un nuevo conteo físico para comenzar"
                                           TextColor="#9CA3AF"
                                           FontSize="13"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="entities:StockInit">
                                    <Border Margin="0,6"
                                            BackgroundColor="White"
                                            Padding="16"
                                            Stroke="Transparent"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Grid RowDefinitions="Auto,Auto,Auto"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">

                                            <!-- Fila 1: Número y Status -->
                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding NumeroVisible}"
                                                   TextColor="#1D3557"
                                                   FontSize="18"
                                                   FontAttributes="Bold" />

                                            <Border Grid.Row="0" Grid.Column="1"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToBadgeStyleConverter}}"
                                                    Padding="8,4"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Iniciado">
                                                            <Setter Property="TextColor" Value="#DC2626" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Actualizado">
                                                            <Setter Property="TextColor" Value="#D97706" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Sincronizado">
                                                            <Setter Property="TextColor" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Cerrado">
                                                            <Setter Property="TextColor" Value="#6B7280" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>

                                            <!-- Fila 2: Descripción -->
                                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Description}"
                                                   TextColor="#374151"
                                                   FontSize="14"
                                                   LineBreakMode="WordWrap"
                                                   Margin="0,4,0,0" />

                                            <!-- Fila 3: Fecha y resumen -->
                                            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  Margin="0,8,0,0">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="#F3F4F6"
                                                        Padding="8,4"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                                           TextColor="#6B7280"
                                                           FontSize="12" />
                                                </Border>
                                                <Label Grid.Column="2"
                                                       Text="{Binding ItemsSummary}"
                                                       TextColor="#6B7280"
                                                       FontSize="12"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>
