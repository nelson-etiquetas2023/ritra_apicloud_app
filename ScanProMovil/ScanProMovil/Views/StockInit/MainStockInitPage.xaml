<?xml version="1.0" encoding="utf-8" ?>
<FlyoutPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="ScanProMovil.Views.StockInit.MainStockInitPage"
            xmlns:entities="clr-namespace:ScanProMovil.Entities"
            Title="Conteo Físico">

    <FlyoutPage.Detail>
        <NavigationPage>
            <x:Arguments>
                <ContentPage Title="Conteo Físico" BackgroundColor="#F0F4F8">
                    <ContentPage.ToolbarItems>
                        <ToolbarItem Text=""
                                     IconImageSource="back_arrow_32px.png"
                                     Order="Primary"
                                     Priority="0"
                                     Clicked="OnBackClicked" />
                    </ContentPage.ToolbarItems>
                    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

                        <!-- Header con resumen y botón sincronizar todo -->
                        <Border Grid.Row="0"
                                BackgroundColor="White"
                                Padding="16,12"
                                Stroke="Transparent"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Conteo Físico"
                                           TextColor="#1D3557"
                                           FontSize="20"
                                           FontAttributes="Bold" />
                                    <Label x:Name="SummaryLabel"
                                           TextColor="#6B7280"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#EEF2FF"
                                        Padding="10,6"
                                        Stroke="Transparent"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <ImageButton Source="upload_to_the_cloud_32px.png"
                                                 WidthRequest="28"
                                                 HeightRequest="28"
                                                 BackgroundColor="Transparent"
                                                 Padding="0"
                                                 Clicked="OnSyncAllClicked"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 ToolTipProperties.Text="Sincronizar documentos pendientes" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Buscador -->
                        <Border Grid.Row="1"
                                BackgroundColor="White"
                                Padding="12,8"
                                Stroke="Transparent"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Image Source="search_50px.png"
                                       WidthRequest="20"
                                       HeightRequest="20"
                                       VerticalOptions="Center"
                                       Opacity="0.6" />
                                <Entry x:Name="SearchEntry"
                                       Grid.Column="1"
                                       Placeholder="Buscar por número o descripción..."
                                       TextChanged="OnSearchChanged"
                                       FontSize="14"
                                       TextColor="#1D3557"
                                       PlaceholderColor="#9CA3AF" />
                            </Grid>
                        </Border>

                        <!-- Botones de acción -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Button Grid.Column="0"
                                    Text="Nuevo Conteo"
                                    ImageSource="add.png"
                                    BackgroundColor="#3B82F6"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Clicked="OnCreateNewClicked" />
                            <Button Grid.Column="1"
                                    Text="Sincronizar Todo"
                                    ImageSource="upload_to_the_cloud_32px.png"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    Clicked="OnSyncAllClicked" />
                        </Grid>

                        <!-- Lista de documentos -->
                        <CollectionView x:Name="DocsCollection"
                                        Grid.Row="3"
                                        SelectionMode="None">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="12">
                                    <Border BackgroundColor="#F3F4F6"
                                            Padding="24"
                                            Stroke="Transparent"
                                            StrokeThickness="0"
                                            Opacity="0.5">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="50" />
                                        </Border.StrokeShape>
                                        <Image Source="warehouse_50px.png"
                                               WidthRequest="48"
                                               HeightRequest="48" />
                                    </Border>
                                    <Label Text="Sin documentos"
                                           TextColor="#6B7280"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center" />
                                    <Label Text="Crea un nuevo conteo físico para comenzar"
                                           TextColor="#9CA3AF"
                                           FontSize="13"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="entities:StockInit">
                                    <Border Margin="0,6"
                                            BackgroundColor="White"
                                            Padding="16"
                                            Stroke="Transparent"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDocTapped" />
                                        </Border.GestureRecognizers>
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">

                                            <!-- Fila 1: Número y Status -->
                                            <Label Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding NumeroVisible}"
                                                   TextColor="#1D3557"
                                                   FontSize="18"
                                                   FontAttributes="Bold" />

                                            <Border Grid.Row="0" Grid.Column="1"
                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToBadgeStyleConverter}}"
                                                    Padding="8,4"
                                                    Stroke="Transparent"
                                                    StrokeThickness="0">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="12" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Status}"
                                                       FontSize="11"
                                                       FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Iniciado">
                                                            <Setter Property="TextColor" Value="#DC2626" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Actualizado">
                                                            <Setter Property="TextColor" Value="#D97706" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Sincronizado">
                                                            <Setter Property="TextColor" Value="#059669" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Cerrado">
                                                            <Setter Property="TextColor" Value="#6B7280" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>

                                            <!-- Fila 2: Descripción -->
                                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                                   Text="{Binding Description}"
                                                   TextColor="#374151"
                                                   FontSize="14"
                                                   LineBreakMode="WordWrap"
                                                   Margin="0,4,0,0" />

                                            <!-- Fila 3: Fecha y resumen -->
                                            <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  Margin="0,8,0,0">
                                                <Border Grid.Column="0"
                                                        BackgroundColor="#F3F4F6"
                                                        Padding="8,4"
                                                        Stroke="Transparent"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                                                           TextColor="#6B7280"
                                                           FontSize="12" />
                                                </Border>
                                                <Label Grid.Column="2"
                                                       Text="{Binding ItemsSummary}"
                                                       TextColor="#6B7280"
                                                       FontSize="12"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="Center" />
                                            </Grid>

                                            <!-- Fila 4: Botones de acción -->
                                            <Grid Grid.Row="3" Grid.ColumnSpan="2"
                                                  ColumnDefinitions="*,*,*" ColumnSpacing="8"
                                                  Margin="0,12,0,0">
                                                <Button Grid.Column="0"
                                                        Text="Ver"
                                                        ImageSource="document_info.png"
                                                        BackgroundColor="#E5E7EB"
                                                        TextColor="#374151"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        CornerRadius="10"
                                                        HeightRequest="40"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnViewDocClicked" />
                                                <Button Grid.Column="1"
                                                        Text="Sincronizar"
                                                        ImageSource="upload_to_the_cloud_32px.png"
                                                        BackgroundColor="#3B82F6"
                                                        TextColor="White"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        CornerRadius="10"
                                                        HeightRequest="40"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnSyncItemClicked" />
                                                <Button Grid.Column="2"
                                                        Text="Cerrar"
                                                        ImageSource="lock.png"
                                                        BackgroundColor="#EF4444"
                                                        TextColor="White"
                                                        FontAttributes="Bold"
                                                        FontSize="13"
                                                        CornerRadius="10"
                                                        HeightRequest="40"
                                                        CommandParameter="{Binding .}"
                                                        Clicked="OnCloseDocClicked">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Cerrado">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Grid>
                </ContentPage>
            </x:Arguments>
        </NavigationPage>
    </FlyoutPage.Detail>

</FlyoutPage>
